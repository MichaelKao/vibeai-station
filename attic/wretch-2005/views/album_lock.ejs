<%- include('partials/head',{title:album.title}) %>
<%- include('partials/sitetop') %>
<%# 密碼相簿（無名的 key.gif 相簿）：只問密碼，form action 維持
    POST /:name/album/:id/unlock，欄位仍是 pass。 %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="side"><a href="/<%= u.name %>/album"><%= u.name %>'s Album</a>
      &gt; <b><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt=""><%= album.title %></b></div>

    <div class="side" align="center">
      這是密碼相簿，請輸入密碼：<br>
      <form method="post" action="/<%= u.name %>/album/<%= album.id %>/unlock">
        <input name="pass" type="password" size="12">
        <input type="submit" class="btn" value="進入">
        <% if (err) { %><br><span class="err"><%= err %></span><% } %>
      </form>
    </div>

    <div class="side" align="center"><a href="/<%= u.name %>/album">回相簿列表</a></div>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
