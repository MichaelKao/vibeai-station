<%# 相簿總站 /albums：不是個人頁，用 2005 首頁綠版面（WRETCH_DOM.md 第 1、7 節）。
    nav 留空 → THEME_FOR('') = t-index（綠）。 %>
<%- include('partials/head',{title:'相簿總站',layout:'index'}) %>
<%
  /* 上方：24 個站內分類（.grid_class 230×40）與地區；下方：ad_square 相簿格（5 欄）。
     一頁 20 本，server.js 已是 per=20。7 天內建立的掛 new_album.gif。 */
  const isNew = c => { const t = Date.parse(String(c||'').replace(' ','T'));
                       return !!t && (Date.now() - t) < 7*864e5; };
  const qTopic = topic ? 'topic=' + encodeURIComponent(topic) : '';
%>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="3" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description">相簿總站</span>
			</div>
		</div>
	</td>

	<td rowspan="3" width="5" class="side1"></td>
</tr>

<tr>
	<td height="30" class="side2" align="center">
		<a href="/"><%= SITE_NAME %></a> |
		<a href="/albums">相簿</a> |
		<a href="/blogs">網誌</a> |
		<a href="/rank">排行榜</a> |
		<a href="/help">服務說明</a>
	</td>
</tr>

<tr>
	<td id="content1">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td>
			<td></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="3" valign="top">
<!-- CONTENT BEGIN -->

			<div class="album_title">
				<a href="/albums">相簿站內分類</a>
			</div>

			<% topics.forEach(t => { %>
			<div class="grid_class">
				<a href="/albums?topic=<%= encodeURIComponent(t) %>"><% if (topic === t) { %><b><%= t %></b><% } else { %><%= t %><% } %></a>
				<span class="font_desc">(<%= counts[t] || 0 %>)</span>
			</div>
			<% }) %>
			<br clear="all">

			<div class="side"><a href="/albums">所有分類</a></div>

			<div class="album_title">
				<a href="/albums">各地相簿</a>
			</div>
			<div class="side">
				<a href="/albums<%= qTopic ? '?' + qTopic : '' %>"><% if (!place) { %><b>全部</b><% } else { %>全部<% } %></a>
				<% places.forEach(pl => { %>
				｜ <a href="/albums?<%= qTopic ? qTopic + '&' : '' %>place=<%= encodeURIComponent(pl) %>"><% if (place === pl) { %><b><%= pl %></b><% } else { %><%= pl %><% } %></a>
				<% }) %>
			</div>

			<div class="album_title">
				<%= topic || '所有分類' %><% if (place) { %>　<%= place %><% } %>
			</div>

			<div class="side" align="center">共 <b><%= total %></b> 本相簿</div>
			<div class="side" align="center"><%- include('partials/pager') %></div>

			<% if (!albums.length) { %>
			<div class="side" align="center">這個分類還沒有相簿</div>
			<% } else { %>
	<table id="ad_square" border="0" align="center" cellspacing="10" style="word-break:break-all">
	<% for (let i = 0; i < albums.length; i += 5) { const row = albums.slice(i, i+5); %>
	<tr>
		<% row.forEach(a => { %>
		<td class="album_grid" width="120" height="120" align="center" valign="middle">
			<a href="/<%= a.uname %>/album/<%= a.id %>"><% if (a.cover) { %><img src="<%= a.cover %>" width="120" height="120" alt="Cover"><% } else { %><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt="Cover"><% } %></a>
		</td>
		<% }) %>
		<% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
	</tr>
	<tr>
		<% row.forEach(a => { %>
		<td class="album_grid1" height="60" width="120" valign="top" align="center">
			<span class="album_font_id"><a href="/<%= a.uname %>"><%= a.uname %></a></span>
			<br>
			<span class="album_font_title"><a href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a></span>
			<br>
			<% if (isNew(a.created)) { %><img src="<%= CDN %>/icon/new_album.gif" width="21" height="11" alt="" class="ico-new"><% } %><span class="album_font_desc"><%= a.n %>張照片</span>
		</td>
		<% }) %>
		<% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
	</tr>
	<% } %>
	</table>
			<% } %>

			<div class="side" align="center"><%- include('partials/pager') %></div>
			<div align="right"><span class="blog_font_desc"><a href="/rank">相簿人氣</a></span></div>

<!-- CONTENT END -->
			</td>
		</tr>
		<tr>
			<td colspan="3" height="40"></td>
		</tr>
		</table>
	</td>
</tr>
</table>
<%- include('partials/foot') %>
