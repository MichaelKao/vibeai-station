<%- include('partials/head',{title:u.nick+'的名片'}) %>
<%- include('partials/sitetop') %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title">個人資料</div>
    <div class="side">
      <table class="card" width="100%" border="0" cellpadding="3" cellspacing="0">
        <tr><td width="90" valign="top" class="font_desc">暱稱</td>
            <td valign="top"><span class="font_title"><%= u.nick %></span> (<%= u.name %>)</td></tr>
        <tr><td valign="top" class="font_desc">姓名</td><td valign="top"><%= u.realname %></td></tr>
        <tr><td valign="top" class="font_desc">性別</td><td valign="top"><%= u.sex %></td></tr>
        <tr><td valign="top" class="font_desc">生日</td><td valign="top"><%= u.birthday %></td></tr>
        <tr><td valign="top" class="font_desc">星座</td><td valign="top"><%= u.zodiac %></td></tr>
        <tr><td valign="top" class="font_desc">血型</td><td valign="top"><%= u.blood ? u.blood + ' 型' : '' %></td></tr>
        <tr><td valign="top" class="font_desc">居住地</td><td valign="top"><%= u.city %></td></tr>
        <tr><td valign="top" class="font_desc">職業</td><td valign="top"><%= u.job %></td></tr>
        <tr><td valign="top" class="font_desc">學校</td><td valign="top"><%= u.school %></td></tr>
        <tr><td valign="top" class="font_desc">興趣</td><td valign="top"><%= u.hobby %></td></tr>
        <tr><td valign="top" class="font_desc">座右銘</td><td valign="top"><%= u.motto %></td></tr>
        <tr><td valign="top" class="font_desc">MSN</td><td valign="top"><%= u.msn %></td></tr>
        <tr><td valign="top" class="font_desc">個人網頁</td>
            <td valign="top"><% if (u.homepage) { %><a href="<%= u.homepage %>" rel="nofollow noopener" target="_blank"><%= u.homepage %></a><% } %></td></tr>
        <tr><td valign="top" class="font_desc">自我介紹</td>
            <td valign="top" style="white-space:pre-wrap"><%= u.intro %></td></tr>
        <tr><td valign="top" class="font_desc">加入日期</td><td valign="top"><%= u.created.slice(0,10) %></td></tr>
      </table>
    </div>

    <% if (isOwner) { %>
    <div class="title">編輯我的名片</div>
    <div class="side">
      <form method="post">
      <table class="card" width="100%" border="0" cellpadding="3" cellspacing="0">
        <tr><td width="90" class="font_desc">姓名</td>
            <td><input name="realname" value="<%= u.realname %>" maxlength="20"></td></tr>
        <tr><td class="font_desc">性別</td>
            <td><select name="sex"><option value="">（不公開）</option><% sexes.forEach(s=>{ %><option <%= u.sex===s?'selected':'' %>><%= s %></option><% }) %></select></td></tr>
        <tr><td class="font_desc">生日</td>
            <td><input name="birthday" type="date" value="<%= u.birthday %>"></td></tr>
        <tr><td class="font_desc">星座</td>
            <td><select name="zodiac"><option value="">（不設定）</option><% zodiacs.forEach(z=>{ %><option <%= u.zodiac===z?'selected':'' %>><%= z %></option><% }) %></select></td></tr>
        <tr><td class="font_desc">血型</td>
            <td><select name="blood"><option value="">（不設定）</option><% bloods.forEach(b=>{ %><option <%= u.blood===b?'selected':'' %>><%= b %></option><% }) %></select></td></tr>
        <tr><td class="font_desc">居住地</td>
            <td><select name="city"><option value="">（不設定）</option><% cities.forEach(c=>{ %><option <%= u.city===c?'selected':'' %>><%= c %></option><% }) %></select></td></tr>
        <tr><td class="font_desc">職業</td>
            <td><input name="job" value="<%= u.job %>" maxlength="20"></td></tr>
        <tr><td class="font_desc">學校</td>
            <td><input name="school" value="<%= u.school %>" size="30" maxlength="30"></td></tr>
        <tr><td class="font_desc">興趣</td>
            <td><input name="hobby" value="<%= u.hobby %>" size="40" maxlength="100"></td></tr>
        <tr><td class="font_desc">座右銘</td>
            <td><input name="motto" value="<%= u.motto %>" size="40" maxlength="100"></td></tr>
        <tr><td class="font_desc">MSN</td>
            <td><input name="msn" value="<%= u.msn %>" size="30" maxlength="50"></td></tr>
        <tr><td class="font_desc">個人網頁</td>
            <td><input name="homepage" value="<%= u.homepage %>" size="40" maxlength="200" placeholder="http://"></td></tr>
        <tr><td></td>
            <td><input type="submit" value="儲存名片">
              <span class="font_desc">自我介紹在「個人設定」修改</span></td></tr>
      </table>
      </form>
    </div>
    <% } %>

    <%- include('partials/side',{visitors,friends}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
