<%- include('partials/head',{title: post.title, layout:'blog'}) %>
<%# 網誌單篇 ＋ 迴響區（WRETCH_DOM.md 第 5 節）
    文章本體的 DOM 與列表頁完全相同（.blog > .date + .blogbody > .blogbody2），
    只是不截斷、不出 .extended。
    下方依序：工具列（推薦／收藏／引用／檢舉）、上一篇下一篇、迴響區。
    表單 action／method／欄位 name 一律沿用原本的：
      推薦   POST /:name/blog/:id/like
      收藏   POST /:name/blog/:id/fav
      引用   POST /:name/blog/:id/trackback
      迴響   POST /:name/blog/:id/comment      author / email / homepage / remember / body
      板主回覆 POST /:name/blog/:id/comment/:cid/reply   reply
      刪迴響 POST /:name/blog/:id/comment/:cid/del
      檢舉   POST /report                      kind / target / url / reason %>
<%
  const MON = ['January','February','March','April','May','June',
               'July','August','September','October','November','December'];
  const wDate = s => MON[+String(s).slice(5,7) - 1] + ' ' + (+String(s).slice(8,10)) + ', ' + String(s).slice(0,4);
  const wTime = s => { let h = +String(s).slice(11,13); const ap = h < 12 ? 'AM' : 'PM';
                       h = h % 12 || 12;
                       return String(h).padStart(2,'0') + ':' + String(s).slice(14,16) + ' ' + ap; };
  const here = '/' + u.name + '/blog/' + post.id;
%>
<div id="container1"><div id="container2">

  <div id="banner">
    <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
    <div id="pageheader">
      <h1><a href="/<%= u.name %>/blog"><%= u.nick %> 的小站</a></h1>
      <span class="description"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : SITE_DESC %></span>
      <div id="description2"><span class="description"></span></div>
    </div>
  </div>

  <div id="main2">

    <div id="content">

      <div class="blog">
        <div class="date">
          <div class="datediv"><%= wDate(post.created) %></div>
        </div>

        <div class="blogbody">
          <div class="blogbody2">
            <div class="articletext">
              <a name="<%= post.id %>"></a>
              <h3 class="title"><% if (post.pass) { %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt="[鎖]"> <% } %><%= post.title %></h3>
              <div class="innertext"><%- render(post.body) %></div>
              <br clear="all" />
            </div>

            <div class="posted">
              <%= u.name %> at <a href="/blogs"><%= SITE_NAME %></a> at <%= wTime(post.created) %> post
              | <a href="#comments">迴響(<%= comments.length %>)</a>
              | <a href="#boxNewTrackback">引用(<%= trackbacks.length %>)</a>
              | <% if (me) { %><form method="post" action="<%= here %>/fav" style="display:inline"><button class="lnk"><%= faved ? '取消收藏' : '收藏' %>(<%= favN %>)</button></form><% } else { %><a href="/login?next=<%= encodeURIComponent(here) %>">收藏(<%= favN %>)</a><% } %>
              | <a href="#" class="reportlink" data-kind="post" data-id="<%= post.id %>">檢舉</a>
              | 分類：<a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a>
              <% if (post.mood) { %>| 心情：<%= post.mood %> <% } %><% if (post.weather) { %>| 天氣：<%= post.weather %><% } %>
            </div>

            <div class="blogtools">
              [ <form method="post" action="<%= here %>/like" style="display:inline"><button class="lnk">推薦</button></form> (推:<%= post.likes %>) ]
              <% if (me && !isOwner) { %>
              [ <form method="post" action="<%= here %>/trackback" style="display:inline"><button class="lnk">引用到我的網誌</button></form> ]
              <% } %>
              <% if (isOwner) { %>
              [ <a href="<%= here %>/edit">編輯</a> ]
              [ <form method="post" action="<%= here %>/del" style="display:inline" onsubmit="return confirm('刪除這篇文章？')"><button class="lnk">刪除</button></form> ]
              <% } %>
              <% if (me && me.admin) { %>
              [ <form method="post" action="/admin/feature/post/<%= post.id %>" style="display:inline"><input type="hidden" name="back" value="<%= here %>"><button class="lnk"><%= post.featured ? '取消精選' : '設為精選' %></button></form> ]
              <% } %>
            </div>

          </div><!-- /.blogbody2 -->
        </div><!-- /.blogbody -->
      </div><!-- /.blog -->

      <%# 上一篇下一篇＋迴響區：包在第二組 .blogbody 裡（#content 是置中的，
          .blogbody 才有 text-align:left 與左右 15px 內距，同 post_edit.ejs 的作法）。 %>
      <div class="blog">
      <div class="blogbody"><div class="blogbody2"><div class="articletext">

      <div class="side">
        <% if (prev) { %>&laquo; 上一篇：<a href="/<%= u.name %>/blog/<%= prev.id %>"><%= prev.title %></a><br /><% } %>
        <% if (next) { %>下一篇：<a href="/<%= u.name %>/blog/<%= next.id %>"><%= next.title %></a> &raquo;<% } %>
      </div>

      <%# ── 迴響區 ─────────────────────────────────────────────── %>
      <a name="comments"></a>
      <div class="sidetitle">迴響(<%= comments.length %>)</div>

      <% comments.forEach((c,i)=>{ %>
      <div class="side">
        <b><%= i+1 %>樓</b>
        <% if (c.homepage) { %><a href="<%= c.homepage %>" rel="nofollow noopener" target="_blank"><%= c.author %></a><% } else { %><%= c.author %><% } %>
        <span class="font_desc"><%= c.created.slice(0,16) %></span>
        <% if (isOwner) { %>
        <form method="post" action="<%= here %>/comment/<%= c.id %>/del" style="display:inline"><button class="lnk">刪除</button></form>
        <% } %>
        <br />
        <span class="innertext" style="white-space:pre-wrap"><%= c.body %></span>
      </div>
      <% if (c.reply) { %>
      <div class="side"><b>板主回覆</b>：<%= c.reply %></div>
      <% } %>
      <% if (isOwner) { %>
      <div class="side">
        <form method="post" action="<%= here %>/comment/<%= c.id %>/reply">
          <input name="reply" size="36" maxlength="500" value="<%= c.reply %>">
          <input type="submit" class="btn" value="板主回覆">
        </form>
      </div>
      <% } %>
      <% }) %>
      <% if (!comments.length) { %><div class="side">還沒有人留下迴響</div><% } %>

      <div class="sidetitle">發表迴響</div>
      <div class="side">
        <form method="post" action="<%= here %>/comment" class="gb"><table class="pf">
          <% if (!me) { %>
          <tr><td width="110">暱稱：</td>
            <td><input name="author" maxlength="20" value="<%= (guest && guest.author) || '' %>"></td></tr>
          <tr><td>E-mail：</td>
            <td><input name="email" size="30" maxlength="60" value="<%= (guest && guest.email) || '' %>"></td></tr>
          <tr><td>個人網頁：</td>
            <td><input name="homepage" size="30" maxlength="200" placeholder="http://" value="<%= (guest && guest.homepage) || '' %>"></td></tr>
          <tr><td>記住我的資料</td>
            <td><label><input type="radio" name="remember" value="1" <%= guest ? 'checked' : '' %>> 是</label>
                <label><input type="radio" name="remember" value="" <%= guest ? '' : 'checked' %>> 否</label></td></tr>
          <% } %>
          <tr><td valign="top">迴響內容（最多1000字）：</td>
            <td><textarea name="body" cols="55" rows="5" maxlength="1000" required></textarea></td></tr>
          <tr><td></td>
            <td><input type="submit" class="btn" value="送出"></td></tr>
        </table></form>
      </div>

      <%# 檢舉表單：平常收起來，按 .posted 的「檢舉」才展開 %>
      <div id="reportbox" style="display:none">
        <div class="sidetitle">檢舉</div>
        <div class="side">
          <form method="post" action="/report">
            <input type="hidden" name="kind" id="rkind">
            <input type="hidden" name="target" id="rtarget">
            <input type="hidden" name="url" value="<%= here %>">
            請說明檢舉原因：<br />
            <textarea name="reason" cols="45" rows="3" maxlength="500" required></textarea><br />
            <input type="submit" class="btn" value="送出檢舉">
            <input type="button" class="btn" id="rcancel" value="取消">
          </form>
        </div>
      </div>

      </div></div></div><!-- /.articletext /.blogbody2 /.blogbody -->
      </div><!-- /.blog -->

    </div><!-- /#content -->

    <div id="links"><div id="links2">
      <%- include('partials/blogside') %>
    </div></div>

  </div><!-- /#main2 -->

  <div id="extraDiv1"><span></span></div>
  <div id="extraDiv2"><span></span></div>
  <div id="extraDiv3"><span></span></div>
  <div id="extraDiv4"><span></span></div>
  <div id="extraDiv5"><span></span></div>
  <div id="extraDiv6"><span></span></div>

</div></div><!-- /#container2 /#container1 -->
<script>
document.addEventListener('click',function(e){
  var a=e.target.closest('.reportlink');
  if(a){ e.preventDefault();
    document.getElementById('rkind').value=a.getAttribute('data-kind');
    document.getElementById('rtarget').value=a.getAttribute('data-id');
    var b=document.getElementById('reportbox'); b.style.display='block'; b.scrollIntoView({behavior:'smooth'}); }
  if(e.target.id==='rcancel'){ document.getElementById('reportbox').style.display='none'; }
});
</script>
<%- include('partials/foot') %>
