<%- include('partials/head',{title:u.nick+'的相簿'}) %>
<%- include('partials/sitetop') %>
<%
  /* 個人相簿列表 /:name/album（WRETCH_DOM.md 4-A、原始碼 assets_src/html/album_list.html）
     黃金文字 → 共 N 本相簿 → 分頁 → #ad_square（5 欄封面列 + 5 欄說明列）→ 分頁。
     一頁 20 本（5×4），server.js 已是 per=20。
     有密碼掛 key.gif、7 天內建立掛 new_album.gif、沒封面用 user_cover.gif。 */
  const isNew = c => { const t = Date.parse(String(c||'').replace(' ','T'));
                       return !!t && (Date.now() - t) < 7*864e5; };
  const pct = (typeof quota !== 'undefined' && quota.total)
    ? Math.min(100, Math.round(quota.used / quota.total * 100)) : 0;
%>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <%# 黃金文字（無名的 td#ad_word）：站方連結一行 %>
    <table width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
      <td id="ad_word" class="small-c" align="center">
        <a href="/albums">相簿站內分類</a> ｜
        <a href="/albums">各地相簿</a> ｜
        <a href="/rank">相簿人氣</a>
      </td>
    </tr></table>

    <div class="side" align="center">共 <b><%= total %></b> 本相簿</div>
    <div class="side" align="center"><%- include('partials/pager') %></div>

    <% if (!albums.length) { %>
    <div class="side" align="center">目前沒有相簿</div>
    <% } else { %>
    <table id="ad_square" border="0" align="center" cellspacing="10" style="word-break:break-all">
      <% for (let i = 0; i < albums.length; i += 5) { const row = albums.slice(i, i+5); %>
      <tr>
        <% row.forEach(a => { %>
        <td class="side" width="120" height="120" align="center" valign="middle">
          <a href="/<%= u.name %>/album/<%= a.id %>"><% if (a.cover) { %><img src="<%= a.cover %>" width="120" height="120" alt="Cover"><% } else { %><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt="Cover"><% } %></a>
        </td>
        <% }) %>
        <% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
      </tr>
      <tr>
        <% row.forEach(a => { %>
        <td height="40" width="120" valign="top" align="center">
          <% if (a.pass) { %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt=""><% } %><a href="/<%= u.name %>/album/<%= a.id %>" class="font_title"><%= a.title %></a><br>
          <% if (isNew(a.created)) { %><img src="<%= CDN %>/icon/new_album.gif" width="21" height="11" alt="" class="ico-new"><% } %><span class="font_desc"><%= a.n %>張照片<% if (a.friends_only) { %>・好友限定<% } %></span>
        </td>
        <% }) %>
        <% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
      </tr>
      <% } %>
    </table>
    <% } %>

    <div class="side" align="center"><%- include('partials/pager') %></div>

    <% if (isOwner) { %>
    <%# ── 以下只有站主本人看得到 ───────────────────────────────── %>
    <% if (typeof quota !== 'undefined') { %>
    <div class="title">相簿空間</div>
    <div class="side" align="center">
      已使用 <b><%= quota.mb(quota.used) %> MB</b> / <%= quota.mb(quota.total) %> MB
      <div style="width:240px;height:10px;margin:4px auto;background:#fff;border:1px solid #894500">
        <div style="height:10px;width:<%= pct %>%;background:<%= pct > 90 ? '#C11361' : '#DE750B' %>"></div>
      </div>
      <span class="font_desc">空間快滿時請先刪掉不要的照片。</span>
    </div>
    <% } %>

    <div class="title">建立相簿</div>
    <div class="side">
      <form method="post" action="/<%= u.name %>/album">
        <table border="0" cellpadding="2" cellspacing="0">
          <tr>
            <td width="70">相簿名稱</td>
            <td><input name="title" size="24" maxlength="40" required></td>
          </tr>
          <tr>
            <td>說明</td>
            <td><input name="descr" size="40" maxlength="200"></td>
          </tr>
          <tr>
            <td>站內分類</td>
            <td>
              <select name="topic">
                <option value="">- 相簿分類 -</option>
                <% topics.forEach(t => { %><option><%= t %></option><% }) %>
              </select>
              &nbsp;地區
              <select name="place">
                <option value="">- 全部 -</option>
                <% places.forEach(p => { %><option><%= p %></option><% }) %>
              </select>
            </td>
          </tr>
          <tr>
            <td>密碼</td>
            <td><input name="pass" size="12" maxlength="20">
              <span class="font_desc">留空＝公開相簿</span></td>
          </tr>
          <tr>
            <td>好友限定</td>
            <td><label><input type="checkbox" name="friends_only"> 只有我的好友看得到（不出現在相簿總站與搜尋）</label></td>
          </tr>
          <tr>
            <td></td>
            <td><input type="submit" class="btn" value="建立"></td>
          </tr>
        </table>
      </form>
    </div>
    <% } %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
