<%- include('partials/head',{title:'首頁',nav:'home',layout:'index'}) %>
<%
  /* 2005 無名小站首頁（綠版）：總寬 760px，左欄 505px + 隔 5px + 右欄 160px。
     結構照 assets_src/html/home2005.html，class/id 照 WRETCH_DOM.md 第 7 節。

     摘要用的純文字化：把 [img]…[/img] 整段拿掉，其餘 [tag] 只去掉標記本身，
     再把換行壓成空白，最後截斷；輸出一律走轉義輸出，不會有 HTML 進來。 */
  const CAP = (s, n) => {
    const t = String(s || '')
      .replace(/\[img\][\s\S]*?\[\/img\]/gi, '')
      .replace(/\[[^\[\]\n]{1,40}\]/g, '')
      .replace(/\s+/g, ' ').trim();
    return t.length > n ? t.slice(0, n) + '  ...' : t;
  };
  /* 熱門相簿的「N張照片」：server.js 目前沒有給張數，先用人氣頂著（見回報） */
  const ALBUM_DESC = a => (a.n != null) ? a.n + '張照片' : '人氣: ' + a.views;
%>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="3" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description"><%= SITE_DESC %></span>
			</div>
			<div class="font_banner" align="right">
				<a href="/">設為首頁</a> |
				<a href="/help">常見問題</a> |
				<a href="/help">新手上路</a> |
				<% if (me) { %><a href="/<%= me.name %>"><%= me.nick %></a><% } else { %><a href="/login">會員登入</a><% } %>
			</div>
		</div>
	</td>

	<td rowspan="3" width="5" class="side1"></td>
</tr>

<tr>
	<td height="30" class="side2" align="center">
		<a href="/"><%= SITE_NAME %></a> |
		<a href="/albums">相簿</a> |
		<a href="/blogs">網誌</a> |
		<a href="/rank">排行榜</a> |
		<a href="/help">服務說明</a>
	</td>
</tr>

<tr>
	<td id="content1" height="100%">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td><td width="505"></td>
			<td width="20" height="20" class="content3">&nbsp;</td><td width="5" class="side1"></td>
			<td width="20" height="20" class="content2">&nbsp;</td><td width="160"></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>

		<tr>
			<td colspan="3" style="text-align: center;" valign="top">
	<!-- CONTENT BEGIN -->
				<div class="album_content">

				<% if (featAlbums.length) { %>
				<div class="album_title">
					<a href="/albums">精選相簿</a>
				</div>
	<table border="0" align="center" cellspacing="0">
	<% for (let i = 0; i < featAlbums.length; i += 3) { const row = featAlbums.slice(i, i + 3); %>
	<tr>
		<% row.forEach((a, j) => { %><% if (j) { %><td rowspan="2" width="10"></td><% } %>
		<td class="album_grid" width="120" height="120" align="center" valign="middle">
			<a href="/<%= a.uname %>/album/<%= a.id %>"><img src="<%= a.cover %>" width="120" height="120" alt=""></a>
		</td>
		<% }) %>
	</tr>
	<tr>
		<% row.forEach(a => { %>
		<td class="album_grid1" height="60" width="120" valign="top" align="center">
			<span class="album_font_id"><a href="/<%= a.uname %>"><%= a.uname %></a></span>
			<br>
			<span class="album_font_title"><a href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a></span>
			<br>
			<span class="album_font_desc"><%= ALBUM_DESC(a) %></span>
		</td>
		<% }) %>
	</tr>
	<tr><td colspan="5" height="50"></td></tr>
	<% } %>
	</table>
				<% } %>

				<div class="album_title">
					<a href="/albums">熱門相簿</a>
				</div>
				<% if (!hotAlbums.length) { %>
				<div class="side" align="center">還沒有公開相簿，快來上傳第一張照片！</div>
				<% } %>
	<table border="0" align="center" cellspacing="0">
	<% for (let i = 0; i < hotAlbums.length; i += 3) { const row = hotAlbums.slice(i, i + 3); %>
	<tr>
		<% row.forEach((a, j) => { %><% if (j) { %><td rowspan="2" width="10"></td><% } %>
		<td class="album_grid" width="120" height="120" align="center" valign="middle">
			<a href="/<%= a.uname %>/album/<%= a.id %>"><img src="<%= a.cover %>" width="120" height="120" alt=""></a>
		</td>
		<% }) %>
	</tr>
	<tr>
		<% row.forEach(a => { %>
		<td class="album_grid1" height="60" width="120" valign="top" align="center">
			<span class="album_font_id"><a href="/<%= a.uname %>"><%= a.uname %></a></span>
			<br>
			<span class="album_font_title"><a href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a></span>
			<br>
			<span class="album_font_desc"><%= ALBUM_DESC(a) %></span>
		</td>
		<% }) %>
	</tr>
	<tr><td colspan="5" height="50"></td></tr>
	<% } %>
	</table>
				<div align="right"><span class="blog_font_desc"><a href="/albums">更多相簿..</a></span></div>

				</div>

				<div class="blog_content">

				<% if (featPosts.length) { %>
				<div class="blog_title">
					<a href="/blogs">精選網誌</a>
				</div>
				<div class="side">
					<% featPosts.forEach(p => { %>
					<a href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a>
					（<a href="/<%= p.uname %>"><%= p.nick %></a>）<br>
					<% }) %>
				</div>
				<% } %>

				<div class="blog_title">
					<a href="/blogs">熱門網誌</a>
				</div>
				<% if (!hotPosts.length) { %>
				<div class="side" align="center">尚無文章</div>
				<% } %>
	<% hotPosts.forEach(p => { %>
	<table border="0" height="80" width="500" cellspacing="0" cellpadding="0" align="center">
	<tr>
		<td width="120" height="120" align="center" class="blog_grid">
			<a href="/<%= p.uname %>/blog/<%= p.id %>"><% if (p.pthumb) { %><img src="<%= p.pthumb %>" width="120" height="120" alt=""><% } else { %><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt=""><% } %></a>
		</td>
		<td>
			<table width="380" border="0" cellpadding="0" cellspacing="0" class="blog_grid1">
			<tr>
				<td valign="middle" height="30">
					<span class="blog_font_id"><a href="/<%= p.uname %>"><%= p.uname %></a></span>
					<span class="blog_font_desc"></span>
				</td>
			</tr>
			<tr>
				<td height="20" valign="middle">
					<span class="blog_font_arttitle"><a href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></span>
				</td>
			</tr>
			<tr>
				<td height="70" valign="top">
					<span class="blog_font_desc"><%= CAP(p.body, 90) %></span>
					<span class="blog_font_desc"><a href="/<%= p.uname %>/blog/<%= p.id %>">(繼續閱讀)</a></span>
					<div align="right"><span class="blog_point_title">得點: </span><span class="blog_point_grade"><%= p.views * 10 + p.likes * 50 %></span></div>
				</td>
			</tr>
			<tr>
				<td height="10" valign="top" align="right">
				</td>
			</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td height="20" colspan="2"></td>
	</tr>
	</table>
	<% }) %>
				<div align="right"><span class="blog_font_desc"><a href="/blogs">更多網誌..</a></span></div>

				</div>

				<div class="album_content">

				<div class="album_title">
					<a href="/albums">最新照片</a>
				</div>
				<% if (!newPhotos.length) { %>
				<div class="side" align="center">尚無照片</div>
				<% } %>
	<table border="0" align="center" cellspacing="0">
	<% for (let i = 0; i < newPhotos.length; i += 3) { const row = newPhotos.slice(i, i + 3); %>
	<tr>
		<% row.forEach((p, j) => { %><% if (j) { %><td rowspan="2" width="10"></td><% } %>
		<td class="album_grid" width="120" height="120" align="center" valign="middle">
			<a href="/<%= p.uname %>/photo/<%= p.id %>"><img src="<%= p.thumb || p.url %>" width="120" height="120" alt=""></a>
		</td>
		<% }) %>
	</tr>
	<tr>
		<% row.forEach(p => { %>
		<td class="album_grid1" height="60" width="120" valign="top" align="center">
			<span class="album_font_id"><a href="/<%= p.uname %>"><%= p.uname %></a></span>
			<br>
			<span class="album_font_title"><a href="/<%= p.uname %>/album/<%= p.aid %>"><%= p.atitle %></a></span>
			<br>
			<span class="album_font_desc"><%= p.caption ? CAP(p.caption, 12) : '' %></span>
		</td>
		<% }) %>
	</tr>
	<tr><td colspan="5" height="50"></td></tr>
	<% } %>
	</table>

				</div>
	<!-- CONTENT END -->

			</td>

			<td class="side1">
			</td>

			<td colspan="3" valign="top">
	<!-- RIGHT SIDE BEGIN -->

	<div class="sidetitle">
		<%= SITE_NAME %>
	</div>
	<div class="side">
	  <ul>
	  <li><a href="/albums">相簿總站</a>
	  <li><a href="/blogs">網誌總站</a>
	  <li><a href="/rank">人氣排行榜</a>
	  <li><a href="/search">搜尋</a>
	  </ul>
	</div>
	<br />

	<div class="sidetitle">
		一個帳號，多項功能
	</div>
	<div class="side">
		<center>
			<a href="/register"><img src="<%= CDN %>/icon/joinfree_index.gif" width="150" height="60" alt="免費註冊"></a>
		</center>
		<ul>
		  <li>個人相簿
		  <li>個人網誌<br /> (BLOG,部落格)
		  <li>個人留言板
		</ul>
	</div>
	<br />

	<% if (!me) { %>
	<div class="sidetitle">
		會員登入
	</div>
	<div class="side">
		<center>
			<form name="loginform" method="post" action="/login">
				帳號:<input class="small-c" name="name" type="text" size="10">
				<br>
				密碼:<input class="small-c" name="pass" type="password" size="10">
				<br>
				<input class="small-c" type="submit" value="登入">
				&nbsp;
				<a href="#" onclick="alert('請聯絡站長重設密碼');return false;">忘記密碼</a>
				<br />
				<input type="checkbox" name="remember" value="TRUE">記住我的帳號
				<br>
			</form>
		</center>
	</div>
	<% } else { %>
	<div class="sidetitle">
		我的小站
	</div>
	<div class="side">
	  <ul>
		<li><a href="/<%= me.name %>">回我的家</a>
		<li><a href="/<%= me.name %>/album">我的相簿</a>
		<li><a href="/<%= me.name %>/blog/new">發表文章</a>
		<li><a href="/<%= me.name %>/guestbook">我的留言板</a>
		<li><a href="/<%= me.name %>/card">我的名片</a>
		<li><a href="/<%= me.name %>/feed">好友動態</a>
		<li><a href="/<%= me.name %>/settings">個人設定</a>
	  </ul>
	</div>
	<% } %>
	<br />

	<div class="sidetitle">
		活動快訊
	</div>
	<div class="side">
		<% if (!notices.length) { %>
		<%= SITE_NAME %>開站囉！完全免費，歡迎申請帳號～
		<% } %>
		<% notices.forEach(n => { %>
		<%= n.created.slice(0,10) %><br>
		<%= n.body %><br>
		<% }) %>
	</div>
	<br />

	<div class="sidetitle">
		人氣排行
	</div>
	<div class="side">
		<% if (!rank.length) { %>尚無資料<% } %>
		<ol>
		<% rank.forEach(r => { %>
		<li><a href="/<%= r.name %>"><%= r.nick %></a> <%= r.visits %>
		<% }) %>
		</ol>
	</div>
	<br />

	<div class="sidetitle">
		新加入站友
	</div>
	<div class="side">
		<% if (!newUsers.length) { %>尚無站友<% } %>
		<% newUsers.forEach(x => { %><a href="/<%= x.name %>"><%= x.nick %></a>　<% }) %>
	</div>
	<br />

	<div class="sidetitle">
		<%= SITE_NAME %>
	</div>
	<div class="side">
	  <ul>
		<li><a href="/help">使用規定</a>
		<li><a href="/help">服務說明</a>
		<li><a href="/help">常見問題</a>
		<li><a href="/register">免費註冊</a>
	  </ul>
		目前共 <%= stats.users %> 位站友、<%= stats.photos %> 張照片、<%= stats.posts %> 篇網誌。
	</div>
	<!-- RIGHT SIDE END -->
		</td>
	</tr>

	<tr>
		<td colspan="3" height="40"></td>
		<td class="side1"></td>
		<td colspan="3"></td>
	</tr>
	</table>
	</td>
</tr>
</table>
<%- include('partials/foot') %>
