<%- include('partials/head',{title: post.title, layout:'blog'}) %>
<%# 文章密碼頁（WRETCH_DOM.md 第 5 節）
    版面與單篇文章完全相同，只是 .innertext 換成密碼表單。
    表單 action／method／欄位 name 沿用原本的：POST /:name/blog/:id/unlock 的 pass。 %>
<%
  const MON = ['January','February','March','April','May','June',
               'July','August','September','October','November','December'];
  const wDate = s => MON[+String(s).slice(5,7) - 1] + ' ' + (+String(s).slice(8,10)) + ', ' + String(s).slice(0,4);
  const wTime = s => { let h = +String(s).slice(11,13); const ap = h < 12 ? 'AM' : 'PM';
                       h = h % 12 || 12;
                       return String(h).padStart(2,'0') + ':' + String(s).slice(14,16) + ' ' + ap; };
%>
<div id="container1"><div id="container2">

  <div id="banner">
    <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
    <div id="pageheader">
      <h1><a href="/<%= u.name %>/blog"><%= u.nick %> 的小站</a></h1>
      <span class="description"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : SITE_DESC %></span>
      <div id="description2"><span class="description"></span></div>
    </div>
  </div>

  <div id="main2">

    <div id="content">

      <div class="blog">
        <div class="date">
          <div class="datediv"><%= wDate(post.created) %></div>
        </div>

        <div class="blogbody">
          <div class="blogbody2">
            <div class="articletext">
              <a name="<%= post.id %>"></a>
              <h3 class="title"><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt="[鎖]"> <%= post.title %></h3>
              <div class="innertext">
                這篇文章有上鎖，請輸入密碼觀看：<br />
                <form method="post" action="/<%= u.name %>/blog/<%= post.id %>/unlock">
                  <input name="pass" type="password" autofocus>
                  <input type="submit" class="btn" value="觀看">
                  <% if (err) { %> <span class="err"><%= err %></span><% } %>
                </form>
              </div>
              <br clear="all" />
            </div>

            <div class="posted">
              <%= u.name %> at <a href="/blogs"><%= SITE_NAME %></a> at <%= wTime(post.created) %> post
              | 分類：<a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a>
            </div>

          </div><!-- /.blogbody2 -->
        </div><!-- /.blogbody -->
      </div><!-- /.blog -->

      <div class="side"><a href="/<%= u.name %>/blog">&laquo; 回<%= u.nick %>的網誌</a></div>

    </div><!-- /#content -->

    <div id="links"><div id="links2">
      <%- include('partials/blogside') %>
    </div></div>

  </div><!-- /#main2 -->

  <div id="extraDiv1"><span></span></div>
  <div id="extraDiv2"><span></span></div>
  <div id="extraDiv3"><span></span></div>
  <div id="extraDiv4"><span></span></div>
  <div id="extraDiv5"><span></span></div>
  <div id="extraDiv6"><span></span></div>

</div></div><!-- /#container2 /#container1 -->
<%- include('partials/foot') %>
