<%- include('partials/head',{title:u.nick+'的好友'}) %>
<%- include('partials/sitetop') %>
<%
  // 好友依 grp 分組（server.js 的查詢已經 ORDER BY grp）
  const groups = {};
  friends.forEach(f => { (groups[f.grp] = groups[f.grp] || []).push(f); });
  const names = Object.keys(groups);
%>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title">好友名單</div>
    <div class="side" align="center">共 <b><%= friends.length %></b> 人<% if (names.length > 1) { %>，<b><%= names.length %></b> 個分類<% } %></div>

    <% if (!friends.length) { %>
    <div class="side" align="center">目前還沒有好友</div>
    <% } %>

    <% names.forEach(g => { const list = groups[g]; %>
    <div class="sidetitle"><%= g %> (<%= list.length %>)</div>
    <table border="0" align="center" cellspacing="10">
      <% for (let i = 0; i < list.length; i += 5) { const row = list.slice(i, i+5); %>
      <tr>
        <% row.forEach(f => { %>
        <td class="side" width="120" height="120" align="center" valign="middle">
          <a href="/<%= f.name %>"><img src="<%= f.avatar %>" width="90" height="90" alt="<%= f.nick %>"></a>
        </td>
        <% }) %>
      </tr>
      <tr>
        <% row.forEach(f => { %>
        <td height="40" width="120" valign="top" align="center">
          <a href="/<%= f.name %>" class="font_title"><%= f.nick %></a><br>
          <span class="font_desc">(<%= f.name %>)</span>
          <% if (isOwner) { %>
          <form method="post" action="/<%= u.name %>/friends/<%= f.id %>/group">
            <input name="grp" value="<%= f.grp %>" size="5" maxlength="10">
            <input type="submit" value="改">
          </form>
          <% } %>
        </td>
        <% }) %>
      </tr>
      <% } %>
    </table>
    <% }) %>

    <div class="title">誰加 <%= u.nick %> 為好友</div>
    <div class="side" align="center">共 <b><%= fans.length %></b> 人</div>
    <% if (!fans.length) { %>
    <div class="side" align="center">目前還沒有人把 <%= u.nick %> 加入好友名單</div>
    <% } else { %>
    <table border="0" align="center" cellspacing="10">
      <% for (let i = 0; i < fans.length; i += 5) { const row = fans.slice(i, i+5); %>
      <tr>
        <% row.forEach(f => { %>
        <td class="side" width="120" height="120" align="center" valign="middle">
          <a href="/<%= f.name %>"><img src="<%= f.avatar %>" width="90" height="90" alt="<%= f.nick %>"></a>
        </td>
        <% }) %>
      </tr>
      <tr>
        <% row.forEach(f => { %>
        <td height="40" width="120" valign="top" align="center">
          <a href="/<%= f.name %>" class="font_title"><%= f.nick %></a><br>
          <span class="font_desc">(<%= f.name %>)</span>
        </td>
        <% }) %>
      </tr>
      <% } %>
    </table>
    <% } %>

    <%- include('partials/side',{friends:null}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
