<%- include('partials/head',{title:'個人設定'}) %>
<%- include('partials/sitetop') %>

<%# 個人設定：700px 個人小站頁（WRETCH_DOM.md 第 3 節）
    三個區塊標題逐字：網誌設定 / 網誌樣式 / 相簿設定（WRETCH_SPEC.md 5-8） %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

  <form method="post" enctype="multipart/form-data">

  <div class="title">網誌設定</div>
  <div class="side">
    <table class="pf" border="0" cellpadding="3" cellspacing="0">
      <tr><td width="90" valign="top">帳號</td>
          <td><b><%= u.name %></b> <span class="gray">（不可更改）</span></td></tr>
      <tr><td valign="top">暱稱</td>
          <td><input name="nick" value="<%= u.nick %>" size="20" maxlength="20" required></td></tr>
      <tr><td valign="top">自我介紹</td>
          <td><textarea name="intro" cols="50" rows="4" maxlength="500"><%= u.intro %></textarea><br>
              <span class="gray">會出現在橫幅副標與名片上。</span></td></tr>
      <tr><td valign="top">大頭貼</td>
          <td><img class="avatar" src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"><br>
              <input type="file" name="avatar" accept="image/*"> <span class="gray">建議 90×90</span></td></tr>
      <tr><td valign="top">新密碼</td>
          <td><input name="pass" type="password" size="12"> 再輸入一次
              <input name="pass2" type="password" size="12"> <span class="gray">不改請留空</span></td></tr>
    </table>
  </div>

  <div class="title">網誌樣式</div>
  <div class="side">
    版面樣式：
    <div class="themepick">
      <% themes.forEach(t=>{ %><a href="#" data-theme="<%= t.id %>" class="<%= (u.theme||'')===t.id?'on':'' %>"><div class="sw"><i style="background:<%= t.sw1 %>"></i><i style="background:<%= t.sw2 %>"></i></div><%= t.name %></a><% }) %>
    </div>
    <input type="hidden" name="theme" value="<%= u.theme || '' %>">
    <span class="gray">選好按下方「儲存設定」。</span><br><br>
    自訂樣式（CSS）：<br>
    <textarea name="css" cols="60" rows="8" maxlength="20000" placeholder="/* 你的小站專屬 CSS，例如 */&#10;body{background:#000 url(...)}&#10;#content1{background:#333}"><%= u.css %></textarea><br>
    <span class="gray">會套在你的每一頁上，蓋得過預設樣式。玩壞了清空即可復原。</span>
  </div>

  <div class="title">相簿設定</div>
  <div class="side">
    <table class="pf" border="0" cellpadding="3" cellspacing="0">
      <tr><td width="90" valign="top">音樂盒</td>
          <td><textarea name="music" cols="50" rows="4" maxlength="2000" placeholder="一行一個 mp3 網址，可放多首組成播放清單"><%= u.music %></textarea><br>
              <span class="gray">一行一首。放在小站側欄，訪客可切換曲目。</span></td></tr>
      <tr><td valign="top">相簿權限</td>
          <td>每本相簿的密碼、好友限定、封面、站內分類與地區，
              請到 <a href="/<%= u.name %>/album">相簿</a> 頁各本相簿自己設定。</td></tr>
      <tr><td valign="top">上傳照片</td>
          <td><a href="/<%= u.name %>/album">上傳照片</a>
              <a href="/<%= u.name %>/blog/new">發表文章</a></td></tr>
    </table>
  </div>

  <div class="side" align="center"><input type="submit" class="btn" value="儲存設定"></div>
  </form>

  <div class="title">刪除帳號</div>
  <div class="side">
    <span class="gray">刪除後你的相簿、照片、網誌、留言板都會一起消失，無法復原。</span>
    <form method="post" action="/<%= u.name %>/settings/delete" onsubmit="return confirm('真的要刪除帳號嗎？所有內容都會消失，無法復原。')">
      輸入密碼確認：<input name="pass" type="password" size="14" required>
      <button class="btn red">永久刪除我的帳號</button>
    </form>
  </div>

  </td>
  <td class="side2"></td>
</tr></table>

<%- include('partials/sitefoot') %>
<script>
document.addEventListener('click',function(e){
  var a=e.target.closest('.themepick a'); if(!a) return; e.preventDefault();
  document.querySelectorAll('.themepick a').forEach(function(x){ x.classList.remove('on'); });
  a.classList.add('on');
  document.querySelector('input[name=theme]').value=a.getAttribute('data-theme');
});
</script>
<%- include('partials/foot') %>
