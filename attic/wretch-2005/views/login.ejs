<%- include('partials/head',{title:'會員登入',nav:'home',layout:'index'}) %>
<%
  /* 會員登入：2005 首頁綠版外框（760px 置中，WRETCH_DOM.md 第 7 節），
     登入表單逐字照 assets_src/html/home2005.html 右欄那組：
     「帳號:」「密碼:」「登入」「忘記密碼」「記住我的帳號」。
     表單維持原本的 method=post、同網址送出（帶 next），欄位 name：name / pass / next。 */
%>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="3" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description"><%= SITE_DESC %></span>
			</div>
			<div class="font_banner" align="right">
				<a href="/">設為首頁</a> |
				<a href="/help">常見問題</a> |
				<a href="/help">新手上路</a> |
				<a href="/register">免費註冊</a>
			</div>
		</div>
	</td>

	<td rowspan="3" width="5" class="side1"></td>
</tr>

<tr>
	<td height="30" class="side2" align="center">
		<a href="/"><%= SITE_NAME %></a> |
		<a href="/albums">相簿</a> |
		<a href="/blogs">網誌</a> |
		<a href="/rank">排行榜</a> |
		<a href="/help">服務說明</a>
	</td>
</tr>

<tr>
	<td id="content1" height="100%">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td>
			<td></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="3" align="center" valign="top">

	<!-- CONTENT BEGIN -->
	<table width="320" border="0" cellpadding="0" cellspacing="0" align="center"><tr><td>

		<div class="title">會員登入</div>
		<div class="side">
			<% if (err) { %><div class="err"><%= err %></div><% } %>
			您還沒登入喔<br>
			<form method="post">
				<input type="hidden" name="next" value="<%= next %>">
				帳號:<input class="small-c" type="text" name="name" size="12" maxlength="20" autofocus><br>
				密碼:<input class="small-c" type="password" name="pass" size="12" maxlength="40"><br>
				<input class="small-c" type="submit" value="登入">
				&nbsp;<a href="/help">忘記密碼</a><br>
				<input type="checkbox" name="remember" value="TRUE">記住我的帳號
			</form>
		</div>

		<div class="title">一個帳號，多項功能</div>
		<div class="side">
			<div align="center">
				<a href="/register"><img src="<%= CDN %>/icon/joinfree_index.gif" width="150" height="60" alt="免費註冊"></a>
			</div>
			<ul>
				<li>個人相簿
				<li>個人網誌 (BLOG,部落格)
				<li>個人留言板
			</ul>
			<div align="center">還沒有帳號？<a href="/register">免費註冊</a></div>
		</div>

	</td></tr></table>
	<!-- CONTENT END -->

			</td>
		</tr>
		<tr><td colspan="3" height="20"></td></tr>
		</table>
	</td>
</tr>
</table>
<%- include('partials/foot') %>
