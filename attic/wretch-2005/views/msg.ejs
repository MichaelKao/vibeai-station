<%- include('partials/head',{title}) %>
<%
  /* 通用訊息頁：找不到頁面／沒有權限／好友限定／空間不足／已送出檢舉。
     從 /:name/… 進來時 res.locals.u 有值 → 700px 個人小站外框（WRETCH_DOM.md 第 3 節）；
     從站台層（404、500、/report）進來時 u 為 null → 760px 首頁綠外框（第 7 節）。 */
  const backUrl = (typeof back !== 'undefined' && back) ? back : '/';
%>
<% if (u) { %>
<%- include('partials/sitetop') %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">
    <table width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
      <td align="center" valign="top">
<% } else { %>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="2" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description"><%= SITE_DESC %></span>
			</div>
		</div>
	</td>

	<td rowspan="2" width="5" class="side1"></td>
</tr>

<tr>
	<td id="content1" height="100%">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td>
			<td></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="3" align="center" valign="top">
<% } %>

	<table width="320" border="0" cellpadding="0" cellspacing="0" align="center"><tr><td>
		<div class="title"><%= title %></div>
		<div class="side" align="center">
			<%= msg %><br><br>
			<a href="<%= backUrl %>">回上一頁</a>
		</div>
	</td></tr></table>

<% if (u) { %>
      </td>
    </tr></table>
  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<% } else { %>
			</td>
		</tr>
		<tr><td colspan="3" height="20"></td></tr>
		</table>
	</td>
</tr>
</table>
<% } %>
<%- include('partials/foot') %>
