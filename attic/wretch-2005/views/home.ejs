<%- include('partials/head',{title:u.nick+'的家'}) %>
<%- include('partials/sitetop') %>
<%
  // 7 天內建立的相簿掛 new_album.gif（WRETCH_DOM.md 第 8 節第 7 條）
  const isNew = c => { const t = Date.parse(String(c||'').replace(' ','T'));
                       return !!t && (Date.now() - t) < 7*864e5; };
%>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title"><%= u.nick %> 的小站</div>
    <div class="side">
      <table border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
        <td width="100" valign="top" align="center">
          <a href="/<%= u.name %>"><img class="avatar" src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"></a>
        </td>
        <td valign="top">
          <span class="font_title"><%= u.nick %></span>
          <span class="font_desc">(<%= u.name %>)</span><br>
          <div style="white-space:pre-wrap"><%= u.intro %></div>
          <% if (u.motto) { %><div class="font_desc">「<%= u.motto %>」</div><% } %>
          <div>
            相簿 <b><%= counts.albums %></b> 本 ・
            照片 <b><%= counts.photos %></b> 張 ・
            網誌 <b><%= counts.posts %></b> 篇 ・
            留言 <b><%= counts.gb %></b> 則 ・
            好友 <b><%= counts.friends %></b> 人
          </div>
        </td>
      </tr></table>
    </div>

    <div class="title">最新相簿</div>
    <% if (!albums.length) { %>
    <div class="side" align="center">目前沒有相簿</div>
    <% } else { %>
    <table id="ad_square" border="0" align="center" cellspacing="10">
      <% for (let i = 0; i < albums.length; i += 5) { const row = albums.slice(i, i+5); %>
      <tr>
        <% row.forEach(a => { %>
        <td class="side" width="120" height="120" align="center" valign="middle">
          <a href="/<%= u.name %>/album/<%= a.id %>"><% if (a.cover) { %><img src="<%= a.cover %>" width="120" height="120" alt="Cover"><% } else { %><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt="Cover"><% } %></a>
        </td>
        <% }) %>
      </tr>
      <tr>
        <% row.forEach(a => { %>
        <td height="40" width="120" valign="top" align="center">
          <% if (a.pass) { %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt=""><% } %><a href="/<%= u.name %>/album/<%= a.id %>" class="font_title"><%= a.title %></a><br>
          <% if (isNew(a.created)) { %><img src="<%= CDN %>/icon/new_album.gif" width="21" height="11" alt="" class="ico-new"><% } %><span class="font_desc"><%= a.n %>張照片</span>
        </td>
        <% }) %>
      </tr>
      <% } %>
    </table>
    <% } %>
    <div class="side" align="right"><a href="/<%= u.name %>/album">更多相簿..</a></div>

    <div class="title">最新文章</div>
    <div class="side">
      <% if (!posts.length) { %>目前沒有文章<% } %>
      <% posts.forEach(p => { %>
      <div><a href="/<%= u.name %>/blog/<%= p.id %>" class="font_title"><%= p.title %></a>
        <span class="font_desc"><%= p.created.slice(0,10) %> ・ <%= p.views %> 人次</span></div>
      <% }) %>
      <div align="right"><a href="/<%= u.name %>/blog">更多網誌..</a></div>
    </div>

    <div class="title">最新留言</div>
    <div class="side">
      <% if (!gb.length) { %>目前沒有留言<% } %>
      <% gb.forEach(m => { %>
      <div class="gbitem">
        <div>暱稱：<%= m.author %></div>
        <div>主題：<%= m.subject || '無標題' %></div>
        <div>時間：<%= m.created %></div>
        <div>內容：<%= m.body %></div>
      </div>
      <% }) %>
      <div align="right"><a href="/<%= u.name %>/guestbook">更多留言..</a></div>
    </div>

    <%- include('partials/side',{visitors,friends,sideAvatar:false}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
