<%- include('partials/head',{title:album.title+' - 幻燈片'}) %>

<%# 幻燈片（無名的 /album/display.php）：整頁黑底、置中大圖、自動播放
    版面只在這一頁用得到，樣式就近放這裡，不進全站 style.css。 %>
<style>
#slidepage{ position:fixed; left:0; top:20px; right:0; bottom:0; background:#000; color:#fff;
  text-align:center; font-size:12px; z-index:5; }
#slidewrap{ position:absolute; left:0; top:0; right:0; bottom:76px;
  display:flex; align-items:center; justify-content:center; }
#slideimg{ max-width:96%; max-height:100%; padding:3px; background:#fff; }
#slidecap{ position:absolute; left:0; right:0; bottom:52px; height:20px; overflow:hidden;
  line-height:20px; color:#fff; }
#slidenav{ position:absolute; left:0; right:0; bottom:0; height:44px; line-height:44px; color:#ccc; }
#slidenav a{ color:#fff; }
#slidenav .btn{ background:#000; border:1px solid #fff; color:#fff; font-size:12px; padding:1px 8px; cursor:pointer; }
#slidenav .btn:hover{ background:#fff; color:#000; }
#slidenav select{ font-size:12px; }
#slidenum{ color:#ccc; }
</style>

<div id="slidepage">
  <div id="slidewrap"><img id="slideimg" src="<%= photos[start-1].url %>" alt="<%= photos[start-1].caption || '' %>"></div>
  <div id="slidecap"><%= photos[start-1].caption || '' %></div>
  <div id="slidenav">
    <input type="button" class="btn" id="sprev" value="上一張">
    <input type="button" class="btn" id="splay" value="暫停">
    <input type="button" class="btn" id="snext" value="下一張">
    　<span id="slidenum"><%= start %> / <%= photos.length %></span>
    　速度 <select id="sspeed">
      <option value="2000">2 秒</option>
      <option value="4000" selected>4 秒</option>
      <option value="7000">7 秒</option>
    </select>
    　<%= album.title %>
    　<a href="/<%= u.name %>/album/<%= album.id %>">回相簿</a>
  </div>
  <noscript><div style="padding:20px">很抱歉! 您沒辦法看到這個網頁的 Flash! 請啟用 javascript</div></noscript>
  <div id="slidedata" data-photos="<%= JSON.stringify(photos.map(x=>({u:x.url,c:x.caption||''}))) %>" data-start="<%= start %>"></div>
</div>

<script>
(function(){
  var el=document.getElementById('slidedata');
  var ph=[]; try{ ph=JSON.parse(el.getAttribute('data-photos'))||[]; }catch(e){ return; }
  if(!ph.length) return;
  var i=Math.max(0,Math.min(ph.length-1,(+el.getAttribute('data-start')||1)-1));
  var img=document.getElementById('slideimg'), cap=document.getElementById('slidecap'),
      num=document.getElementById('slidenum'), playBtn=document.getElementById('splay'),
      speed=document.getElementById('sspeed'), timer=null, playing=true;
  function show(n){ i=(n+ph.length)%ph.length; img.src=ph[i].u; cap.textContent=ph[i].c;
                    num.textContent=(i+1)+' / '+ph.length; }
  function tick(){ show(i+1); }
  function start(){ stop(); timer=setInterval(tick,+speed.value); playing=true; playBtn.value='暫停'; }
  function stop(){ if(timer) clearInterval(timer); timer=null; playing=false; playBtn.value='播放'; }
  document.getElementById('sprev').onclick=function(){ show(i-1); if(playing) start(); };
  document.getElementById('snext').onclick=function(){ show(i+1); if(playing) start(); };
  playBtn.onclick=function(){ playing?stop():start(); };
  speed.onchange=function(){ if(playing) start(); };
  document.addEventListener('keydown',function(e){
    var t=e.target, n=t.tagName;
    if(n==='INPUT'||n==='TEXTAREA'||n==='SELECT'||t.isContentEditable) return;
    if(e.key==='ArrowRight'||e.key==='c'||e.key==='C'){ show(i+1); if(playing) start(); }
    if(e.key==='ArrowLeft'){ show(i-1); if(playing) start(); }
    if(e.key===' '){ e.preventDefault(); playing?stop():start(); }
    if(e.key==='Escape'){ location.href='/<%= u.name %>/album/<%= album.id %>'; }
  });
  show(i); start();
})();
</script>
<%- include('partials/foot') %>
