<%- include('partials/head',{title:'誰來我家'}) %>
<%- include('partials/sitetop') %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title">誰來我家</div>
    <div class="side" align="center">共 <b><%= total %></b> 筆足跡</div>
    <div class="side" align="center"><%- include('partials/pager') %></div>

    <% if (!rows.length) { %>
    <div class="side" align="center">目前還沒有人來過</div>
    <% } else { %>
    <table width="100%" border="0" cellpadding="0" cellspacing="0">
      <% rows.forEach(v => { %>
      <tr>
        <td class="side" width="60" align="center" valign="middle">
          <a href="/<%= v.who %>"><img src="<%= v.avatar || '/img/avatar.png' %>" width="48" height="48" alt="<%= v.nick || v.who %>"></a>
        </td>
        <td class="side" valign="middle">
          <a href="/<%= v.who %>" class="font_title"><%= v.nick || v.who %></a>
          <span class="font_desc">(<%= v.who %>)</span>
        </td>
        <td class="side" width="140" align="right" valign="middle">
          <span class="font_desc"><%= v.created %></span>
        </td>
      </tr>
      <% }) %>
    </table>
    <% } %>

    <div class="side" align="center"><%- include('partials/pager') %></div>

    <%- include('partials/side',{visitors:null,friends}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
