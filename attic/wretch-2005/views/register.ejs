<%- include('partials/head',{title:'免費註冊',nav:'home',layout:'index'}) %>
<%
  /* 免費註冊：2005 首頁綠版外框（760px 置中，WRETCH_DOM.md 第 7 節）。
     逐字用語見 WRETCH_SPEC.md 5-1／5-9：「帳號:」「密碼:」「免費註冊」
     「一個帳號，多項功能」「個人相簿／個人網誌 (BLOG,部落格)／個人留言板」。
     表單維持原本的 method=post、同網址送出，欄位 name：name / nick / pass / pass2。 */
%>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="3" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description"><%= SITE_DESC %></span>
			</div>
			<div class="font_banner" align="right">
				<a href="/">設為首頁</a> |
				<a href="/help">常見問題</a> |
				<a href="/help">新手上路</a> |
				<a href="/login">會員登入</a>
			</div>
		</div>
	</td>

	<td rowspan="3" width="5" class="side1"></td>
</tr>

<tr>
	<td height="30" class="side2" align="center">
		<a href="/"><%= SITE_NAME %></a> |
		<a href="/albums">相簿</a> |
		<a href="/blogs">網誌</a> |
		<a href="/rank">排行榜</a> |
		<a href="/help">服務說明</a>
	</td>
</tr>

<tr>
	<td id="content1" height="100%">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td>
			<td></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="3" align="center" valign="top">

	<!-- CONTENT BEGIN -->
	<table width="320" border="0" cellpadding="0" cellspacing="0" align="center"><tr><td>

		<div class="title">免費註冊</div>
		<div class="side">
			<% if (err) { %><div class="err"><%= err %></div><% } %>
			<form method="post">
			<table border="0" cellpadding="2" cellspacing="0">
			<tr><td align="right">帳號:</td>
				<td><input class="small-c" type="text" name="name" size="16" maxlength="20" value="<%= form.name || '' %>" pattern="[A-Za-z0-9_]{3,20}" required></td></tr>
			<tr><td></td><td class="small-c">3~20 位英數字或底線，你的網址會是 /帳號</td></tr>
			<tr><td align="right">暱稱:</td>
				<td><input class="small-c" type="text" name="nick" size="16" maxlength="20" value="<%= form.nick || '' %>" required></td></tr>
			<tr><td align="right">密碼:</td>
				<td><input class="small-c" type="password" name="pass" size="16" maxlength="40" required></td></tr>
			<tr><td align="right">確認密碼:</td>
				<td><input class="small-c" type="password" name="pass2" size="16" maxlength="40" required></td></tr>
			<tr><td></td><td><input class="small-c" type="submit" value="免費註冊"></td></tr>
			</table>
			</form>
		</div>

		<div class="title">一個帳號，多項功能</div>
		<div class="side">
			<ul>
				<li>個人相簿
				<li>個人網誌 (BLOG,部落格)
				<li>個人留言板
			</ul>
			完全免費、不打廣告。請勿上傳侵權或不當內容。
			<div align="center">已經有帳號了？<a href="/login">會員登入</a></div>
		</div>

	</td></tr></table>
	<!-- CONTENT END -->

			</td>
		</tr>
		<tr><td colspan="3" height="20"></td></tr>
		</table>
	</td>
</tr>
</table>
<%- include('partials/foot') %>
