<%
  /* 網誌右側欄（WRETCH_DOM.md 第 5 節「側欄模組」）
     ------------------------------------------------------------------
     這支 partial 只吐「側欄內容」，不含外框。
     呼叫端必須自己開 <div id="links"><div id="links2">，
     include 這支之後再把兩層關掉（見 post_edit.ejs）。

     模組一律三層，順序與 id 照契約：
       #links2   → 1 boxMySpace  2 boxNewArticle 3 boxCategory 4 boxDate 5 boxSearch
       #divThird2→ 6 boxNewComment 7 boxNewTrackback 8 boxCounter 9 .syndicate 10 .powered

     資料來自 server.js 的 blogSide()：cats / recent / recentC / months / cal。
     只在部分頁面存在的 local（ym、k、inBody、trackbacks）一律用 typeof 保護。 */
  const todayHits = u.hits_date === new Date().toLocaleDateString('sv-SE') ? (u.today_hits || 0) : 0;
  const curYm     = (typeof ym !== 'undefined' && ym) ? ym : '';
  const curK      = (typeof k  !== 'undefined' && k)  ? k  : '';
  const curInBody = (typeof inBody !== 'undefined') && inBody;
  const tbs       = (typeof trackbacks !== 'undefined' && trackbacks) ? trackbacks : [];
%>
<%# ── 1 boxMySpace ─────────────────────────────────────────────── %>
<div id="boxMySpace">
  <div class="boxMySpace0">
    <div class="sidetitle"><%= u.nick %> 的小站</div>
  </div>
  <div class="boxMySpace1">
    <div class="side">
      <div class="boxMySpaceImg">
        <a href="/<%= u.name %>"><img src="<%= u.avatar || (CDN + '/icon/user_cover.gif') %>" width="90" height="90" alt="<%= u.nick %>"></a>
      </div>
      <div id="service">
        <ul id="serviceList">
          <li><a class="mySpaceLink" id="linkMypage" href="/<%= u.name %>">MyPage</a></li>
          <li><a class="mySpaceLink" id="linkAlbum" href="/<%= u.name %>/album">相簿</a></li>
          <li><a class="mySpaceLink" id="linkBlog" href="/<%= u.name %>/blog">網誌</a></li>
          <li><a class="mySpaceLink" id="linkGbook" href="/<%= u.name %>/guestbook">留言板</a></li>
          <li><a class="mySpaceLink" id="linkUser" href="/<%= u.name %>/card">名片</a></li>
          <li><a class="mySpaceLink" id="linkFriend" href="/<%= u.name %>/friends">好友</a></li>
        </ul>
        <ul id="interactionList">
          <% if (me && !isOwner) { %>
          <li class="boxAddFriendLink">
            <form method="post" action="/<%= u.name %>/friend"><button class="lnk mySpaceLink"><%= isFriend ? '取消好友' : '加入好友名單' %></button></form>
          </li>
          <% } %>
          <% if (isOwner) { %>
          <li class="boxAddFriendLink"><a class="mySpaceLink" href="/<%= u.name %>/blog/new">發表文章</a></li>
          <li class="boxAddFriendLink"><a class="mySpaceLink" href="/<%= u.name %>/settings">網誌樣式</a></li>
          <li class="boxAddFriendLink"><a class="mySpaceLink" href="/<%= u.name %>/settings">網誌設定</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>
  <br />
</div>
<%# ── 2 boxNewArticle ──────────────────────────────────────────── %>
<div id="boxNewArticle">
  <div class="boxNewArticle0">
    <div class="sidetitle">最新文章</div>
  </div>
  <div class="boxNewArticle1">
    <div class="side">
      <% recent.forEach(r=>{ %><a href="/<%= u.name %>/blog/<%= r.id %>"><%= r.title %></a><br />
      <% }) %><% if (!recent.length) { %>尚無文章<% } %>
    </div>
  </div>
  <br />
</div>
<%# ── 3 boxCategory ────────────────────────────────────────────── %>
<div id="boxCategory">
  <div class="boxCategory0">
    <div class="sidetitle">文章分類</div>
  </div>
  <div class="boxCategory1">
    <div class="side">
      <% cats.forEach(c=>{ %><a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(c.category) %>"><%= c.category %>(<%= c.n %>)</a><br />
      <% }) %><a href="/<%= u.name %>/blog">全部</a><br />
    </div>
  </div>
  <br />
</div>
<%# ── 4 boxDate ────────────────────────────────────────────────── %>
<div id="boxDate">
  <div class="boxDate0">
    <div class="sidetitle">文章日曆</div>
  </div>
  <div class="boxDate1">
    <div class="side">
      <table class="cal" border="0" cellpadding="0" cellspacing="0" align="center">
        <tr class="calnav">
          <td colspan="2"><a href="/<%= u.name %>/blog?cal=<%= cal.prevYm %>">&laquo;</a></td>
          <td colspan="3"><%= cal.y %> / <%= cal.m %></td>
          <td colspan="2"><% if (!cal.isFuture) { %><a href="/<%= u.name %>/blog?cal=<%= cal.nextYm %>">&raquo;</a><% } %></td>
        </tr>
        <tr class="wk"><th>日</th><th>一</th><th>二</th><th>三</th><th>四</th><th>五</th><th>六</th></tr>
        <% for (let i=0; i<cal.cells.length; i+=7) { %>
        <tr>
          <% for (let j=i; j<i+7; j++) { const c=cal.cells[j]; %><td><% if (!c) { %>&nbsp;<% } else if (c.has) { %><a href="/<%= u.name %>/blog?d=<%= cal.key %>-<%= String(c.d).padStart(2,'0') %>"><b><%= c.d %></b></a><% } else { %><%= c.d %><% } %></td><% } %>
        </tr>
        <% } %>
      </table>
      <form action="/<%= u.name %>/blog" method="get" class="monthly">
        <select name="ym" onchange="this.form.submit()">
          <option value="">- 月份彙整 -</option>
          <% months.forEach(m=>{ %><option value="<%= m.ym %>" <%= curYm===m.ym ? 'selected' : '' %>><%= m.ym.slice(0,4) %> 年 <%= +m.ym.slice(5,7) %> 月(<%= m.n %>)</option><% }) %>
        </select>
      </form>
    </div>
  </div>
  <br />
</div>
<%# ── 5 boxSearch ──────────────────────────────────────────────── %>
<div id="boxSearch">
  <div class="boxSearch0">
    <div class="sidetitle">搜尋這個網誌</div>
  </div>
  <div class="boxSearch1">
    <div class="side">
      <form action="/<%= u.name %>/blog/search" method="get">
        <input name="q" type="text" size="12" maxlength="30" value="<%= curK %>">
        <input type="submit" value="搜尋">
        <br />
        <%# 標題一律比對（server.js 兩種模式都查 title），所以這格固定勾選；
            「內容」勾了才送出 body=1，行為與原本的 radio 完全相同。 %>
        <input type="checkbox" checked disabled>標題
        <input type="checkbox" name="body" value="1" <%= curInBody ? 'checked' : '' %>>內容
      </form>
    </div>
  </div>
  <br />
</div>
<div id="divThird">
<div id="divThird2">
<%# ── 6 boxNewComment ──────────────────────────────────────────── %>
  <div id="boxNewComment">
    <div class="boxNewComment0">
      <div class="sidetitle">最新迴響</div>
    </div>
    <div class="boxNewComment1">
      <div class="side">
        <% recentC.forEach(c=>{ %><a href="/<%= u.name %>/blog/<%= c.post_id %>#comments">Re: <%= c.title %></a>, by <%= c.author %><br />
        <% }) %><% if (!recentC.length) { %>尚無迴響<% } %>
      </div>
    </div>
    <br />
  </div>
<%# ── 7 boxNewTrackback ────────────────────────────────────────── %>
  <div id="boxNewTrackback">
    <div class="boxNewTrackback0">
      <div class="sidetitle">最新引用</div>
    </div>
    <div class="boxNewTrackback1">
      <div class="side">
        <% tbs.forEach(t=>{ %><a href="/<%= t.uname %>/blog/<%= t.pid %>">Re: <%= t.title %></a><span>, by <%= t.uname %> (<%= t.created ? t.created.slice(5,10) : '' %>)</span><br />
        <% }) %><% if (!tbs.length) { %>尚無引用<% } %>
      </div>
    </div>
    <br />
  </div>
<%# ── 8 boxCounter ─────────────────────────────────────────────── %>
  <div id="boxCounter">
    <div class="boxCounter0">
      <div class="sidetitle">人氣指數</div>
    </div>
    <div class="boxCounter1">
      <div class="side">
        今日人氣: <span class="point_grade"><%= todayHits %></span><br />
        累積人氣: <span class="point_grade"><%= u.visits %></span>
      </div>
    </div>
    <br />
  </div>
<%# ── 9 .syndicate ─────────────────────────────────────────────── %>
  <div class="syndicate">
    <a href="/<%= u.name %>/blog/rss">RSS</a>
    ( <a href="/help#rss">RSS HOWTO</a> )
  </div>
<%# ── 10 .powered ──────────────────────────────────────────────── %>
  <div class="powered">
    POWERED BY <a class="powerlogo" href="/"><%= SITE_NAME %></a>
    <% if (me) { %>| <a href="/<%= me.name %>">我的小站</a><% } else { %>| <a href="/login">登入</a> | <a href="/register">免費註冊</a><% } %>
  </div>
</div><!-- /#divThird2 -->
</div><!-- /#divThird -->
