<%# 個人小站頁尾：人氣兩行 + POWERED BY（WRETCH_DOM.md 第 3 節）
    關閉 partials/sitetop.ejs 開的 #bigcontainer。 %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">
    <div class="side" align="center">
      今日人氣: <span class="point_grade"><%= u.hits_date === new Date().toLocaleDateString('sv-SE') ? (u.today_hits || 0) : 0 %></span>
      &nbsp;&nbsp;累積人氣: <span class="point_grade"><%= u.visits %></span>
    </div>
    <div class="powered" align="center">
      POWERED BY <a href="/"><%= SITE_NAME %></a>
      <% if (me) { %>| <a href="/<%= me.name %>">我的小站</a><% } else { %>| <a href="/login">登入</a> | <a href="/register">免費註冊</a><% } %>
    </div>
  </td>
  <td class="side2"></td>
</tr></table>

</div><!-- /#bigcontainer -->
