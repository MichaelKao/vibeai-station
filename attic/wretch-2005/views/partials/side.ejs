<%# 個人小站的側欄模組串（WRETCH_DOM.md 第 3、5 節）
    一律 <div class="sidetitle">標題</div><div class="side">內容</div>，
    放在 700px 表格的 #content1 內、主內容之後。
    呼叫端可傳 visitors / friends；傳 null 代表該頁本身就是那份名單，不重複顯示。
    sideAvatar:false 用在 MyPage（大頭貼已經在主內容出現過一次）。 %>
<div class="sidetitle"><%= u.nick %> 的小站</div>
<div class="side">
  <% if (typeof sideAvatar === 'undefined' || sideAvatar) { %>
  <div align="center">
    <a href="/<%= u.name %>"><img class="avatar" src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"></a><br>
    <span class="font_title"><%= u.nick %></span> <span class="font_desc">(<%= u.name %>)</span>
  </div>
  <% } %>
  [ <a href="/<%= u.name %>">MyPage</a> |
    <a href="/<%= u.name %>/album">相簿</a> |
    <a href="/<%= u.name %>/blog">網誌</a> |
    <a href="/<%= u.name %>/guestbook">留言板</a> |
    <a href="/<%= u.name %>/card">名片</a> |
    <a href="/<%= u.name %>/friends">好友</a> ]<br>
  <a href="/<%= u.name %>/visitors">誰來我家</a> ｜
  <a href="/<%= u.name %>/favs">我的收藏</a><% if (isOwner) { %> ｜
  <a href="/<%= u.name %>/feed">好友動態</a> ｜
  <a href="/<%= u.name %>/settings">個人設定</a><% } %><br>
  <% if (me && !isOwner) { %>
  <form method="post" action="/<%= u.name %>/friend">
    <input type="submit" value="<%= isFriend ? '取消好友名單' : '加入好友名單' %>">
  </form>
  <% } %>
  <span class="font_desc">加入日期：<%= u.created.slice(0,10) %></span>
</div>

<% if (typeof visitors !== 'undefined' && visitors) { %>
<div class="sidetitle">誰來我家</div>
<div class="side">
  <% if (!visitors.length) { %>目前還沒有人來過<% } %>
  <% visitors.forEach(v => { %>
  <div><a href="/<%= v.who %>"><%= v.who %></a>
    <span class="font_desc"><%= v.created.slice(5,16) %></span></div>
  <% }) %>
  <div align="right"><a href="/<%= u.name %>/visitors">更多足跡..</a></div>
</div>
<% } %>

<% if (typeof friends !== 'undefined' && friends) { %>
<div class="sidetitle">好友連結</div>
<div class="side">
  <% if (!friends.length) { %>目前還沒有好友<% } %>
  <% friends.forEach(f => { %>
  <div><a href="/<%= f.name %>"><%= f.nick %></a>
    <span class="font_desc">(<%= f.name %>)</span></div>
  <% }) %>
  <div align="right"><a href="/<%= u.name %>/friends">更多好友..</a></div>
</div>
<% } %>

<div class="sidetitle">音樂盒</div>
<div class="side" align="center">
<% const tracks=(u.music||'').split('\n').map(s=>s.trim()).filter(Boolean); if (tracks.length) { %>
<audio id="mbox" controls loop style="width:100%;height:26px"></audio>
<%# 曲目清單放在 data 屬性，交給 EJS 的 HTML escape 處理，避免使用者網址跳出 script 區塊 %>
<div id="mboxlist" data-tracks="<%= JSON.stringify(tracks) %>" style="max-height:80px;overflow:auto;margin-top:3px;font-size:11px"></div>
<script>
(function(){
  var L=document.getElementById('mboxlist'), a=document.getElementById('mbox');
  var t=[]; try{ t=JSON.parse(L.getAttribute('data-tracks'))||[]; }catch(e){ return; }
  if(!t.length) return;
  var i=0;
  function esc(s){ return String(s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function name(u,n){ try{ return decodeURIComponent(u.split('/').pop().split('?')[0])||('曲目 '+(n+1)); }catch(e){ return '曲目 '+(n+1); } }
  function draw(){ L.innerHTML=t.map(function(u,n){ return '<div><a href="#" data-i="'+n+'">'+(n===i?'▶ ':'　')+esc(name(u,n))+'</a></div>'; }).join(''); }
  function play(n){ i=(n+t.length)%t.length; a.src=t[i]; draw(); a.play().catch(function(){}); }
  L.addEventListener('click',function(e){ var el=e.target.closest('a'); if(el){ e.preventDefault(); play(+el.getAttribute('data-i')); } });
  a.addEventListener('ended',function(){ if(t.length>1) play(i+1); });
  a.src=t[0]; draw();
})();
</script>
<% } else { %>♪ 沒有背景音樂<br><span class="font_desc">[▶] [■] 音量 ▮▮▮▮▯</span><% } %>
</div>
