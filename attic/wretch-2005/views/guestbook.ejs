<%# 留言板（WRETCH_DOM.md 第 6 節、WRETCH_SPEC.md 4-E / 5-6）
    頁籤：留言板 / 系統訊息（只有站主看得到）/ 我要留言
    每則留言五行逐字：暱稱／主題／時間／內容／通知，右上角「檢舉」
    悄悄話：secret=1 且看的人不是站主時，暱稱／主題／內容三處全部顯示「悄悄話」 %>
<%- include('partials/head',{title:u.nick+'的留言板',layout:'site'}) %>
<%- include('partials/sitetop') %>

<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

<div class="tabs"><a href="/<%= u.name %>/guestbook"<%- tab==='list'?' class="on"':'' %>>留言板</a><% if(isOwner){ %><a href="/<%= u.name %>/guestbook?tab=sys"<%- tab==='sys'?' class="on"':'' %>>系統訊息<% if(unread){ %>(<%= unread %>)<% } %></a><% } %><a href="/<%= u.name %>/guestbook?tab=new"<%- tab==='new'?' class="on"':'' %>>我要留言</a></div>

<% if (tab==='sys') { %>
<%# ===== 系統訊息（站方通知、板主收到新留言的通知） ===== %>
<div class="side" align="center">共 <b><%= total %></b> 則系統訊息</div>
<div class="side">
<% if(!sys.length){ %><div class="gbempty">沒有系統訊息</div><% } %>
<% sys.forEach(m=>{ %>
<div class="gbitem">
  <div>暱稱：<%= SITE_NAME %></div>
  <div>主題：<%= m.title || '無標題' %></div>
  <div>時間：<%= m.created %></div>
  <div>內容：<span style="white-space:pre-wrap"><%= m.body %></span></div>
  <div>通知：</div>
</div>
<% }) %>
</div>
<%# 系統訊息的分頁要帶著 tab=sys，不能用共用的 partials/pager（它只送 ?p=） %>
<% if(pages>1){ %>
<div class="side" align="center"><div class="pager">
<% if(page>1){ %><a href="?tab=sys&p=<%= page-1 %>">上一頁</a> <% } %>
<% for(let i=1;i<=pages;i++){ %><% if(i===page){ %><b>[<%= i %>]</b><% } else { %><a href="?tab=sys&p=<%= i %>"><%= i %></a><% } %> <% } %>
<% if(page<pages){ %><a href="?tab=sys&p=<%= page+1 %>">下一頁</a><% } %>
</div></div>
<% } %>

<% } else if (tab==='new') { %>
<%# ===== 我要留言（表單 action 與欄位 name 不可更動） ===== %>
<div class="side">
<form method="post" action="/<%= u.name %>/guestbook">
<table border="0" cellpadding="2" cellspacing="0">
<tr><td align="right" valign="top">暱稱：</td>
    <td><% if(me){ %><b><%= me.nick %></b><% } else { %><input class="small-c" type="text" name="author" size="20" maxlength="20" required><% } %></td></tr>
<tr><td align="right" valign="top">主題：</td>
    <td><input class="small-c" type="text" name="subject" size="36" maxlength="40"></td></tr>
<tr><td align="right" valign="top">內容：</td>
    <td><textarea class="small-c" name="body" cols="50" rows="6" maxlength="500" required></textarea></td></tr>
<tr><td></td>
    <td><label><input type="checkbox" name="secret"> 悄悄話（只有板主看得到）</label></td></tr>
<tr><td></td><td><input class="small-c" type="submit" value="送出"></td></tr>
</table>
</form>
</div>

<% } else { %>
<%# ===== 留言板本體 ===== %>
<div class="side" align="center">共 <b><%= total %></b> 則留言</div>
<div class="side" align="center"><%- include('partials/pager') %></div>

<div class="side">
<%# 原站這一列是留言搜尋的範圍下拉（標題／來自／內容／回覆），本站沒有留言搜尋，
    只留下同樣的四個字當表頭，不做成假的表單 %>
<div class="gbhead">標題 ｜ 來自 ｜ 內容 ｜ 回覆</div>
<% if(!msgs.length){ %><div class="gbempty">還沒有留言</div><% } %>
<% msgs.forEach(m=>{ const hide = m.secret && !isOwner; %>
<div class="gbitem">
  <div class="gbtool" align="right"><a href="#" class="reportlink" data-kind="guestbook" data-id="<%= m.id %>">檢舉</a><% if(isOwner){ %>
    <form method="post" action="/<%= u.name %>/guestbook/<%= m.id %>/del" style="display:inline" onsubmit="return confirm('刪除這則留言？')"><button class="lnk">刪除</button></form><% } %></div>
  <div>暱稱：<%= hide ? '悄悄話' : m.author %></div>
  <div>主題：<% if(m.secret){ %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" align="absmiddle" alt="悄悄話"><% } %><%= hide ? '悄悄話' : (m.subject || '無標題') %></div>
  <div>時間：<%= m.created %></div>
  <div>內容：<span style="white-space:pre-wrap"><%= hide ? '悄悄話' : m.body %></span></div>
  <div>通知：</div>
  <% if(m.reply && !hide){ %><div class="reply"><b>板主回覆</b>：<%= m.reply %></div><% } %>
  <% if(isOwner){ %>
  <div class="gbreply"><form method="post" action="/<%= u.name %>/guestbook/<%= m.id %>/reply"><input class="small-c" type="text" name="reply" size="40" maxlength="500" value="<%= m.reply %>"> <input class="small-c" type="submit" value="回覆"></form></div>
  <% } %>
</div>
<% }) %>
</div>

<div class="side" align="center"><%- include('partials/pager') %></div>

<%# 檢舉（點「檢舉」才展開；action 與欄位 name 同 /report） %>
<div id="reportbox" class="side" style="display:none">
<form method="post" action="/report">
<input type="hidden" name="kind" id="rkind"><input type="hidden" name="target" id="rtarget">
<input type="hidden" name="url" value="/<%= u.name %>/guestbook">
請說明檢舉原因：<br>
<textarea class="small-c" name="reason" cols="45" rows="3" maxlength="500" required></textarea><br>
<input class="small-c" type="submit" value="送出檢舉"> <input class="small-c" type="button" id="rcancel" value="取消">
</form>
</div>
<script>
document.addEventListener('click',function(e){
  var a=e.target.closest('.reportlink');
  if(a){ e.preventDefault();
    document.getElementById('rkind').value=a.getAttribute('data-kind');
    document.getElementById('rtarget').value=a.getAttribute('data-id');
    var box=document.getElementById('reportbox');
    box.style.display='block'; box.scrollIntoView({behavior:'smooth'}); }
  if(e.target.id==='rcancel'){ document.getElementById('reportbox').style.display='none'; }
});
</script>
<% } %>

  </td>
  <td class="side2"></td>
</tr></table>

<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
