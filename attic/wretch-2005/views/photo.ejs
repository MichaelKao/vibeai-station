<%- include('partials/head',{title:(p.caption||p.atitle)}) %>
<%- include('partials/sitetop') %>

<%# 單張照片頁（WRETCH_DOM.md 4-C）
    麵包屑 → 10 / 80 → 第一張|上一張|下一張|最後一張|回頂端 → 幻燈片
    → #DisplayImage 大圖 → 照片說明 → 工具列 → 其他照片縮圖列 → 迴響 %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <a name="top" id="top"></a>

    <div class="side"><%= u.name %>'s Album &gt;
      <a href="/<%= u.name %>/album/<%= p.aid %>"><%= p.atitle %></a></div>

    <div class="side" align="center"><b><%= idx %></b> / <%= total %></div>

    <div class="photonav" align="center">
      <% if (prev) { %><a href="/<%= u.name %>/photo/<%= first %>">第一張</a> |
      <a href="/<%= u.name %>/photo/<%= prev %>">上一張</a><% } else { %><span class="gray">第一張 | 上一張</span><% } %> |
      <% if (next) { %><a href="/<%= u.name %>/photo/<%= next %>">下一張</a> |
      <a href="/<%= u.name %>/photo/<%= last %>">最後一張</a><% } else { %><span class="gray">下一張 | 最後一張</span><% } %> |
      <a href="#top">回頂端</a>
    </div>

    <div class="albumtools">
      [ <a href="/<%= u.name %>/album/<%= p.aid %>/slide?i=<%= idx %>">幻燈片</a> ]
      [ <a href="/<%= u.name %>/album/<%= p.aid %>?all=1">一頁瀏覽</a> ]
    </div>

    <div class="bigphoto" align="center"><img id="DisplayImage" src="<%= p.url %>" alt="<%= p.caption %>"></div>

    <% if (p.caption) { %><div class="side" align="center"><%= p.caption %></div><% } %>
    <div class="side" align="center">人氣: <span class="point_grade"><%= p.views %></span></div>

    <div class="albumtools">
      [ <a href="<%= p.url %>" target="_blank" title="開啟原圖">切割照片</a> ]
      [ <a href="/search?q=<%= encodeURIComponent(p.caption || p.atitle) %>">搜尋更多</a> ]
      [ <a href="#" class="reportlink" data-kind="photo" data-id="<%= p.id %>">檢舉這張照片</a> ]
    </div>

    <% if (isOwner) { %>
    <div class="side" align="center">
      <form method="post" action="/<%= u.name %>/photo/<%= p.id %>/caption" style="display:inline">
        <input name="caption" size="24" maxlength="100" value="<%= p.caption %>">
        <input type="submit" class="btn" value="改說明">
      </form>
      <form method="post" action="/<%= u.name %>/photo/<%= p.id %>/cover" style="display:inline">
        <input type="submit" class="btn" value="設為封面">
      </form>
      <form method="post" action="/<%= u.name %>/photo/<%= p.id %>/del" style="display:inline"
            onsubmit="return confirm('刪除這張照片？')">
        <input type="submit" class="btn red" value="刪除">
      </form>
    </div>
    <% } %>

    <%# 下方其他照片縮圖列，目前這張加 class="cur" %>
    <div class="strip" align="center">
      <% strip.forEach(s=>{ %><a href="/<%= u.name %>/photo/<%= s.id %>" class="<%= s.id===p.id?'cur':'' %>"><img src="<%= s.thumb||s.url %>" alt="<%= s.caption %>" title="<%= s.caption %>"></a><% }) %>
    </div>

    <a name="comments"></a>
    <div class="side">迴響(<%= comments.length %>)</div>
    <% comments.forEach((c,i)=>{ %>
    <div class="side"><b><%= i+1 %>樓</b> <%= c.author %>
      <span class="gray"><%= c.created.slice(0,16) %></span><br><%= c.body %></div>
    <% }) %>

    <div class="side">
      <form method="post" action="/<%= u.name %>/photo/<%= p.id %>/comment">
        <b>發表迴響</b><br>
        <% if (!me) { %>暱稱：<input name="author" size="12" maxlength="20" value="<%= guest ? guest.author : '' %>"><br><% } %>
        迴響內容：<br>
        <input name="body" size="40" maxlength="300" required>
        <input type="submit" class="btn" value="送出">
      </form>
    </div>

    <%# 檢舉表單（點「檢舉這張照片」才展開） %>
    <div id="reportbox" style="display:none">
      <div class="side">
        <form method="post" action="/report">
          <input type="hidden" name="kind" id="rkind">
          <input type="hidden" name="target" id="rtarget">
          <input type="hidden" name="url" value="/<%= u.name %>/photo/<%= p.id %>">
          請說明檢舉原因：<br>
          <textarea name="reason" cols="45" rows="3" maxlength="500" required></textarea><br>
          <input type="submit" class="btn" value="送出檢舉">
          <input type="button" class="btn" id="rcancel" value="取消">
        </form>
      </div>
    </div>

  </td>
  <td class="side2"></td>
</tr></table>

<%- include('partials/sitefoot') %>
<script>
// 無名照片頁的快捷鍵：c＝下一張（左右方向鍵同義）。在輸入框裡不觸發。
document.addEventListener('keydown',function(e){
  var t=e.target, n=t.tagName;
  if(n==='INPUT'||n==='TEXTAREA'||n==='SELECT'||t.isContentEditable) return;
  if(e.ctrlKey||e.altKey||e.metaKey) return;
  if(e.key==='c'||e.key==='C'||e.key==='ArrowRight'){ <% if(next){ %>location.href='/<%= u.name %>/photo/<%= next %>';<% } %> }
  if(e.key==='ArrowLeft'){ <% if(prev){ %>location.href='/<%= u.name %>/photo/<%= prev %>';<% } %> }
});
// 檢舉這張照片
document.addEventListener('click',function(e){
  var a=e.target.closest('.reportlink');
  if(a){ e.preventDefault();
    document.getElementById('rkind').value=a.getAttribute('data-kind');
    document.getElementById('rtarget').value=a.getAttribute('data-id');
    var b=document.getElementById('reportbox'); b.style.display='block'; b.scrollIntoView({behavior:'smooth'}); }
  if(e.target.id==='rcancel'){ document.getElementById('reportbox').style.display='none'; }
});
</script>
<%- include('partials/foot') %>
