<%# 網誌總站 /blogs：不是個人頁，用 2005 首頁綠版面（WRETCH_DOM.md 第 1、7 節）。
    nav 留空 → THEME_FOR('') = t-index（綠）。版面與 albums.ejs（相簿總站）成對。 %>
<%- include('partials/head',{title:'網誌總站',layout:'index'}) %>
<%
  /* 上方：12 個網誌站內分類（.grid_class 230×40）；下方：熱門網誌清單
     （左 120×120 縮圖 .blog_grid ＋ 右 380 文字 .blog_grid1，同 2005 首頁）。
     一頁 20 篇，server.js 已是 per=20。

     摘要用的純文字化：把 [img]…[/img] 整段拿掉，其餘 [tag] 只去掉標記本身，
     再把換行壓成空白，最後截斷；輸出一律走轉義輸出，不會有 HTML 進來。 */
  const CAP = (s, n) => {
    const t = String(s || '')
      .replace(/\[img\][\s\S]*?\[\/img\]/gi, '')
      .replace(/\[[^\[\]\n]{1,40}\]/g, '')
      .replace(/\s+/g, ' ').trim();
    return t.length > n ? t.slice(0, n) + '  ...' : t;
  };
%>
<table id="bigtab" width="760" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
	<td rowspan="3" width="5" class="side1"></td>

	<td width="750" height="100" id="banner1">
		<div id="banner">
			<a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
			<div id="pageheader">
				<h1><a href="/"><%= SITE_NAME %></a></h1>
				<span class="description">網誌總站</span>
			</div>
		</div>
	</td>

	<td rowspan="3" width="5" class="side1"></td>
</tr>

<tr>
	<td height="30" class="side2" align="center">
		<a href="/"><%= SITE_NAME %></a> |
		<a href="/albums">相簿</a> |
		<a href="/blogs">網誌</a> |
		<a href="/rank">排行榜</a> |
		<a href="/help">服務說明</a>
	</td>
</tr>

<tr>
	<td id="content1">
		<table border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td width="20" height="20" class="content2">&nbsp;</td>
			<td></td>
			<td width="20" height="20" class="content3">&nbsp;</td>
		</tr>
		<tr>
			<td colspan="3" valign="top">
<!-- CONTENT BEGIN -->

			<div class="blog_title">
				<a href="/blogs">網誌站內分類</a>
			</div>

			<% topics.forEach(t => { %>
			<div class="grid_class">
				<a href="/blogs?topic=<%= encodeURIComponent(t) %>"><% if (topic === t) { %><b><%= t %></b><% } else { %><%= t %><% } %></a>
				<span class="font_desc">(<%= counts[t] || 0 %>)</span>
			</div>
			<% }) %>
			<br clear="all">

			<div class="side"><a href="/blogs">所有分類</a></div>

			<div class="blog_title">
				<%= topic || '熱門網誌' %>
			</div>

			<div class="side" align="center">共 <b><%= total %></b> 篇文章</div>
			<div class="side" align="center"><%- include('partials/pager') %></div>

			<% if (!posts.length) { %>
			<div class="side" align="center">這個分類還沒有文章</div>
			<% } %>

	<% posts.forEach(p => { %>
	<table border="0" height="80" width="500" cellspacing="0" cellpadding="0" align="center">
	<tr>
		<td width="120" height="120" align="center" class="blog_grid">
			<a href="/<%= p.uname %>/blog/<%= p.id %>"><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt=""></a>
		</td>
		<td>
			<table width="380" border="0" cellpadding="0" cellspacing="0" class="blog_grid1">
			<tr>
				<td valign="middle" height="30">
					<span class="blog_font_id"><a href="/<%= p.uname %>"><%= p.uname %></a></span>
					<span class="blog_font_desc"><%= p.topic %></span>
				</td>
			</tr>
			<tr>
				<td height="20" valign="middle">
					<span class="blog_font_arttitle"><a href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></span>
				</td>
			</tr>
			<tr>
				<td height="70" valign="top">
					<span class="blog_font_desc"><%= CAP(p.body, 90) %></span>
					<span class="blog_font_desc"><a href="/<%= p.uname %>/blog/<%= p.id %>">(繼續閱讀)</a></span>
					<div align="right">
						<span class="blog_font_desc"><a href="/<%= p.uname %>/blog/<%= p.id %>#comments">迴響(<%= p.nc %>)</a></span>
						&nbsp;<span class="blog_point_title">得點: </span><span class="blog_point_grade"><%= p.views * 10 + p.likes * 50 %></span>
					</div>
				</td>
			</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td height="20" colspan="2"></td>
	</tr>
	</table>
	<% }) %>

			<div class="side" align="center"><%- include('partials/pager') %></div>
			<div align="right"><span class="blog_font_desc"><a href="/rank">網誌人氣</a></span></div>

<!-- CONTENT END -->
			</td>
		</tr>
		<tr>
			<td colspan="3" height="40"></td>
		</tr>
		</table>
	</td>
</tr>
</table>
<%- include('partials/foot') %>
