<%- include('partials/head',{title: post ? '編輯文章' : '發表文章', layout:'blog'}) %>
<%# 發表／編輯文章（WRETCH_DOM.md 第 5 節：網誌頁用 #container1 > #main2 浮動兩欄，不是 700px table）
    表單 action／method／欄位 name 一律沿用原本的：
      新增 POST /:name/blog/new   編輯 POST /:name/blog/:id/edit
      title / category / topic / pass / mood / weather / body
    格式工具列（[b][i][u][color][img]）、顏文字、插入自己的照片三個功能都保留，
    只把外觀換成無名的 .sidetitle + .side。 %>
<div id="container1"><div id="container2">

  <div id="banner">
    <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
    <div id="pageheader">
      <h1><a href="/<%= u.name %>/blog"><%= u.nick %> 的小站</a></h1>
      <span class="description"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : SITE_DESC %></span>
      <div id="description2"><span class="description"></span></div>
    </div>
  </div>

  <div id="main2">

    <div id="content">
      <div class="blog">
        <div class="blogbody"><div class="blogbody2">
          <div class="articletext">

            <div class="blogtools">
              [ <a href="/<%= u.name %>/blog/new">發表文章</a> |
                <a href="/<%= u.name %>/settings">網誌樣式</a> |
                <a href="/<%= u.name %>/settings">網誌設定</a> ]
            </div>

            <div class="sidetitle"><%= post ? '編輯文章' : '發表文章' %></div>
            <div class="side">
              <form method="post" class="gb"><table class="pf">
                <tr><td width="60">標題</td>
                  <td><input name="title" size="60" maxlength="100" value="<%= post ? post.title : '' %>" required></td></tr>

                <tr><td>分類</td>
                  <td><input name="category" list="cats" maxlength="20" value="<%= post ? post.category : '' %>" placeholder="未分類"><datalist id="cats"><% cats.forEach(c=>{ %><option value="<%= c.category %>"><% }) %></datalist></td></tr>

                <tr><td>站內分類</td>
                  <td><select name="topic"><option value="">（不分類）</option><% blogTopics.forEach(t=>{ %><option <%= post && post.topic===t ? 'selected' : '' %>><%= t %></option><% }) %></select>
                    <span class="font_desc">會出現在網誌總站</span></td></tr>

                <tr><td>密碼</td>
                  <td><input name="pass" size="14" maxlength="20" value="<%= post ? post.pass : '' %>">
                    <span class="font_desc">留空＝公開；設了密碼別人要輸入才看得到</span></td></tr>

                <tr><td>心情</td>
                  <td><select name="mood"><option value="">（不設定）</option><% moods.forEach(m=>{ %><option <%= post && post.mood===m ? 'selected' : '' %>><%= m %></option><% }) %></select>
                    　天氣 <select name="weather"><option value="">（不設定）</option><% weathers.forEach(w=>{ %><option <%= post && post.weather===w ? 'selected' : '' %>><%= w %></option><% }) %></select></td></tr>

                <tr><td>工具</td>
                  <td>
                    <div class="edtools">
                      <button type="button" class="btn" data-wrap="[b]|[/b]">粗體</button>
                      <button type="button" class="btn" data-wrap="[i]|[/i]">斜體</button>
                      <button type="button" class="btn" data-wrap="[u]|[/u]">底線</button>
                      <button type="button" class="btn" data-wrap="[color=#cc3399]|[/color]">顏色</button>
                      <button type="button" class="btn" data-wrap="[img]|[/img]">圖片</button>
                    </div>
                    <div class="edtools">顏文字：<% emotes.forEach(e=>{ %><button type="button" class="emo" data-ins="<%= e[0] %>" title="<%= e[0] %>"><%= e[1] %></button><% }) %></div>
                  </td></tr>

                <tr><td>內容</td>
                  <td><textarea id="body" name="body" cols="70" rows="18" required><%= post ? post.body : '' %></textarea>
                    <div class="font_desc">可用 [b]粗體[/b]、[i]斜體[/i]、[u]底線[/u]、[color=#f60]顏色[/color]、[img]圖片網址[/img]，網址會自動變連結。</div></td></tr>

                <% if (photos.length) { %>
                <tr><td>插入照片</td>
                  <td>
                    <div class="photopick">
                      <% photos.forEach(p=>{ %><a href="#" data-img="<%= p.url %>" title="點一下插入文章"><img src="<%= p.thumb || p.url %>" alt=""></a><% }) %>
                    </div>
                    <span class="font_desc">點縮圖就會把該張照片插入游標位置。</span>
                  </td></tr>
                <% } %>

                <tr><td></td>
                  <td><input type="submit" class="btn" value="<%= post ? '儲存' : '發表' %>">
                    <a href="/<%= u.name %>/blog">取消</a></td></tr>
              </table></form>
            </div>

          </div>
        </div></div>
      </div>
    </div>

    <div id="links"><div id="links2">
      <%- include('partials/blogside') %>
    </div></div>

  </div><!-- /#main2 -->

  <div id="extraDiv1"><span></span></div>
  <div id="extraDiv2"><span></span></div>
  <div id="extraDiv3"><span></span></div>
  <div id="extraDiv4"><span></span></div>
  <div id="extraDiv5"><span></span></div>
  <div id="extraDiv6"><span></span></div>

</div></div><!-- /#container2 /#container1 -->
<script>
(function(){
  var ta=document.getElementById('body');
  function insert(before,after){
    after=after||'';
    var s=ta.selectionStart, e=ta.selectionEnd, v=ta.value;
    ta.value=v.slice(0,s)+before+v.slice(s,e)+after+v.slice(e);
    ta.focus(); ta.selectionStart=s+before.length; ta.selectionEnd=e+before.length;
  }
  document.addEventListener('click',function(ev){
    var w=ev.target.closest('[data-wrap]');
    if(w){ ev.preventDefault(); var parts=w.getAttribute('data-wrap').split('|'); insert(parts[0],parts[1]); return; }
    var m=ev.target.closest('[data-ins]');
    if(m){ ev.preventDefault(); insert(m.getAttribute('data-ins')); return; }
    var p=ev.target.closest('[data-img]');
    if(p){ ev.preventDefault(); insert('\n[img]'+p.getAttribute('data-img')+'[/img]\n'); return; }
  });
})();
</script>
<%- include('partials/foot') %>
