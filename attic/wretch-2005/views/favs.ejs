<%- include('partials/head',{title:u.nick+'的收藏'}) %>
<%- include('partials/sitetop') %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title"><%= u.nick %> 的收藏</div>
    <div class="side" align="center">共 <b><%= favs.length %></b> 篇</div>

    <% if (!favs.length) { %>
    <div class="side" align="center">目前沒有收藏的文章。看到喜歡的文章可以按「收藏」。</div>
    <% } else { %>
    <div class="side">
      <% favs.forEach(f => { %>
      <div>
        <a href="/<%= f.uname %>/blog/<%= f.id %>" class="font_title"><%= f.title %></a>
        <span class="font_desc">by <a href="/<%= f.uname %>"><%= f.nick %></a> ・ <%= f.created.slice(0,10) %></span>
      </div>
      <% }) %>
    </div>
    <% } %>

    <%- include('partials/side',{visitors,friends}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
