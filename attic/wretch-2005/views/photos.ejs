<%- include('partials/head',{title:album.title}) %>
<%- include('partials/sitetop') %>
<%
  /* 單本相簿 /:name/album/:id（WRETCH_DOM.md 4-B、原始碼 assets_src/html/album_one.html）
     麵包屑 → Topic:/Place: → 工具列 → #ad_square 照片格（5 欄）。
     viewAll（?all=1「一頁瀏覽」）時改成整本大圖直排。 */
%>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="side"><a href="/<%= u.name %>/album"><%= u.name %>'s Album</a>
      &gt; <b><% if (album.pass) { %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt=""><% } %><%= album.title %></b></div>
    <% if (album.descr) { %>
    <div class="side"><%= album.descr %></div>
    <% } %>

    <div id="detail" class="small-c" align="right">
      Topic: <% if (album.topic) { %><a href="/albums?topic=<%= encodeURIComponent(album.topic) %>"><%= album.topic %></a><% } else { %>None<% } %>
      &nbsp;
      Place: <% if (album.place) { %><a href="/albums?place=<%= encodeURIComponent(album.place) %>"><%= album.place %></a><% } else { %>None<% } %>
      <% if (album.friends_only) { %>&nbsp; <span class="font_desc">好友限定</span><% } %>
    </div>

    <div class="albumtools">
      <% if (viewAll) { %>
      [ <a href="/<%= u.name %>/album/<%= album.id %>">縮圖瀏覽</a> ]
      <% } else { %>
      [ <a href="/<%= u.name %>/album/<%= album.id %>?all=1">一頁瀏覽</a> ]
      <% } %>
      <% if (photos.length) { %>
      [ <a href="/<%= u.name %>/album/<%= album.id %>/slide">幻燈片</a> ]
      <% } %>
      <% if (me && !isOwner) { %>
      [ <form method="post" action="/<%= u.name %>/friend" style="display:inline"><button class="lnk"><%= isFriend ? '取消好友' : '加入好友名單' %></button></form> ]
      <% } %>
      <% if (me && me.admin) { %>
      [ <form method="post" action="/admin/feature/album/<%= album.id %>" style="display:inline"><input type="hidden" name="back" value="/<%= u.name %>/album/<%= album.id %>"><button class="lnk"><%= album.featured ? '取消精選' : '設為精選' %></button></form> ]
      <% } %>
    </div>

    <div class="side" align="center"><%= photos.length %>張照片
      &nbsp;相簿人氣: <span class="point_grade"><%= album.views %></span></div>

    <% if (!photos.length) { %>
    <div class="side" align="center">這本相簿還沒有照片</div>

    <% } else if (viewAll) { %>
    <%# 一頁瀏覽：整本大圖直排 %>
    <% photos.forEach((p, i) => { %>
    <div class="onepage" align="center">
      <img src="<%= p.url %>" alt="<%= p.caption %>"><br>
      <span class="font_desc"><%= i+1 %> / <%= photos.length %></span>
      &nbsp;<a href="/<%= u.name %>/photo/<%= p.id %>" class="font_title"><%= p.caption || (i+1) %></a>
    </div>
    <% }) %>

    <% } else { %>
    <table id="ad_square" border="0" align="center" cellspacing="10" style="word-break:break-all">
      <% for (let i = 0; i < photos.length; i += 5) { const row = photos.slice(i, i+5); %>
      <tr>
        <% row.forEach(p => { %>
        <td class="side" width="120" height="120" align="center" valign="middle">
          <a href="/<%= u.name %>/photo/<%= p.id %>"><img src="<%= p.thumb || p.url %>" width="120" height="120" alt="Cover"></a>
        </td>
        <% }) %>
        <% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
      </tr>
      <tr>
        <% row.forEach((p, j) => { %>
        <td height="40" width="120" valign="top" align="center">
          <a href="/<%= u.name %>/photo/<%= p.id %>" class="font_title"><%= p.caption || (i+j+1) %></a>
        </td>
        <% }) %>
        <% for (let k = row.length; k < 5; k++) { %><td width="120"></td><% } %>
      </tr>
      <% } %>
    </table>
    <% } %>

    <% if (isOwner) { %>
    <%# ── 以下只有站主本人看得到 ───────────────────────────────── %>
    <div class="title">上傳照片</div>
    <div class="side">
      <form method="post" enctype="multipart/form-data" action="/<%= u.name %>/album/<%= album.id %>/upload">
        <input type="file" name="photos" accept="image/*" multiple required>
        &nbsp;說明 <input name="caption" size="18" maxlength="100">
        <input type="submit" class="btn" value="上傳"><br>
        <span class="font_desc">一次最多 20 張，每張 8MB 內（jpg/png/gif/webp）</span>
      </form>
    </div>

    <div class="title">相簿設定</div>
    <div class="side">
      <form method="post" action="/<%= u.name %>/album/<%= album.id %>/edit">
        <table border="0" cellpadding="2" cellspacing="0">
          <tr>
            <td width="70">相簿名稱</td>
            <td><input name="title" size="24" maxlength="40" value="<%= album.title %>"></td>
          </tr>
          <tr>
            <td>說明</td>
            <td><input name="descr" size="40" maxlength="200" value="<%= album.descr %>"></td>
          </tr>
          <tr>
            <td>站內分類</td>
            <td>
              <select name="topic">
                <option value="">- 相簿分類 -</option>
                <% topics.forEach(t => { %><option <%= album.topic===t ? 'selected' : '' %>><%= t %></option><% }) %>
              </select>
              &nbsp;地區
              <select name="place">
                <option value="">- 全部 -</option>
                <% places.forEach(p => { %><option <%= album.place===p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </td>
          </tr>
          <tr>
            <td>密碼</td>
            <td><input name="pass" size="12" maxlength="20" value="<%= album.pass %>">
              <span class="font_desc">留空＝公開相簿</span></td>
          </tr>
          <tr>
            <td>好友限定</td>
            <td><label><input type="checkbox" name="friends_only" <%= album.friends_only ? 'checked' : '' %>> 只有我的好友看得到（不出現在相簿總站與搜尋）</label></td>
          </tr>
          <tr>
            <td></td>
            <td><input type="submit" class="btn" value="儲存"></td>
          </tr>
        </table>
      </form>
      <form method="post" action="/<%= u.name %>/album/<%= album.id %>/del"
            onsubmit="return confirm('確定刪除整本相簿與所有照片？')">
        <input type="submit" class="btn red" value="刪除相簿">
      </form>
    </div>
    <% } %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
