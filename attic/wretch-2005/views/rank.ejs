<%- include('partials/head',{title:'人氣排行',layout:'index'}) %>

<%# 人氣排行：2005 首頁綠版版型（WRETCH_DOM.md 第 7 節）760px 兩欄 %>
<table width="760" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="banner1">
    <div id="banner">
      <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
      <div id="pageheader">
        <h1><a href="/"><%= SITE_NAME %></a></h1>
        <span class="description"><%= SITE_DESC %></span>
      </div>
    </div>
  </td>
  <td class="side2"></td>
</tr></table>

<table id="bigtab" width="760" border="0" cellspacing="0" cellpadding="0" align="center"><tr>
  <td class="side1"></td>

  <%# 左欄 505px %>
  <td width="505" valign="top" class="album_content">

    <a name="users" id="users"></a>
    <div class="album_title"><a href="/rank">人氣排行</a></div>
    <div class="side">
      <% if(!users.length){ %><span class="gray">還沒有站友</span><% } %>
      <table width="100%" border="0" cellpadding="2" cellspacing="0">
      <% users.forEach((x,i)=>{ %>
        <tr>
          <td width="26" align="right"><span class="point_grade"><%= i+1 %></span></td>
          <td width="24"><a href="/<%= x.name %>"><img src="<%= x.avatar %>" width="20" height="20" alt="<%= x.nick %>"></a></td>
          <td><a href="/<%= x.name %>"><%= x.nick %></a> (<%= x.name %>)</td>
          <td align="right">累積人氣: <span class="point_grade"><%= x.visits %></span></td>
        </tr>
      <% }) %>
      </table>
    </div>

    <a name="albums" id="albums"></a>
    <div class="album_title"><a href="/albums">熱門相簿</a></div>
    <% if(!albums.length){ %><div class="side"><span class="gray">還沒有公開相簿</span></div><% } %>
    <table border="0" cellspacing="0" cellpadding="0">
    <% for(let i=0;i<albums.length;i+=3){ const row=albums.slice(i,i+3); %>
      <tr>
      <% row.forEach((a,j)=>{ %>
        <% if(j>0){ %><td width="10"></td><% } %>
        <td class="album_grid" width="120" height="150" align="center">
          <a href="/<%= a.uname %>/album/<%= a.id %>"><% if(a.cover){ %><img src="<%= a.cover %>" width="120" height="120" alt="<%= a.title %>"><% } else { %><img src="<%= CDN %>/icon/user_cover.gif" width="85" height="85" alt="<%= a.title %>"><% } %></a>
        </td>
      <% }) %>
      </tr>
      <tr>
      <% row.forEach((a,j)=>{ %>
        <% if(j>0){ %><td width="10"></td><% } %>
        <td class="album_grid1" width="120" height="60" align="center" valign="top">
          <span class="album_font_id"><a href="/<%= a.uname %>"><%= a.nick %></a></span><br>
          <span class="album_font_title"><a href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a></span><br>
          <span class="album_font_desc">第 <%= i+j+1 %> 名・<%= a.views %> 人次</span>
        </td>
      <% }) %>
      </tr>
    <% } %>
    </table>
    <div align="right"><span class="blog_font_desc"><a href="/albums">更多相簿..</a></span></div>

    <a name="posts" id="posts"></a>
    <div class="blog_title"><a href="/blogs">熱門網誌</a></div>
    <% if(!posts.length){ %><div class="side"><span class="gray">還沒有文章</span></div><% } %>
    <table border="0" cellspacing="0" cellpadding="0">
    <% posts.forEach((p,i)=>{ %>
      <tr>
        <td class="blog_grid" width="120" height="120" align="center" valign="middle">
          <span class="blog_font_id"><%= i+1 %></span>
        </td>
        <td class="blog_grid1" width="380" valign="top">
          <span class="blog_font_id"><a href="/<%= p.uname %>"><%= p.nick %></a></span><br>
          <span class="blog_font_arttitle"><a href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></span><br>
          <span class="blog_font_desc"><%= p.body.length>80 ? p.body.slice(0,80)+'…' : p.body %>
            <a href="/<%= p.uname %>/blog/<%= p.id %>">(繼續閱讀)</a></span>
          <div align="right"><span class="blog_point_title">得點: </span><span class="blog_point_grade"><%= p.views*10 + p.likes*50 %></span></div>
        </td>
      </tr>
    <% }) %>
    </table>
    <div align="right"><span class="blog_font_desc"><a href="/blogs">更多網誌..</a></span></div>

  </td>

  <td width="5"></td>

  <%# 右欄 160px %>
  <td width="160" valign="top">
    <div class="sidetitle"><%= SITE_NAME %></div>
    <div class="side">
      <a href="/albums">相簿</a><br>
      <a href="/blogs">網誌</a><br>
      <a href="/search">搜尋</a><br>
      <a href="/help">服務說明</a>
    </div>

    <div class="sidetitle">人氣排行</div>
    <div class="side">
      <a href="#users">站友</a><br>
      <a href="#albums">熱門相簿</a><br>
      <a href="#posts">熱門網誌</a>
    </div>

    <% if(!me){ %>
    <div class="sidetitle">一個帳號，多項功能</div>
    <div class="side">
      <a href="/register"><img src="<%= CDN %>/icon/joinfree_index.gif" width="150" height="60" alt="免費註冊"></a>
      個人相簿<br>個人網誌 (BLOG,部落格)<br>個人留言板
    </div>

    <div class="sidetitle">會員登入</div>
    <div class="side"><form method="post" action="/login">
      帳號: <input name="name" size="10"><br>
      密碼: <input name="pass" type="password" size="10"><br>
      <input type="submit" class="btn" value="登入">
    </form></div>
    <% } else { %>
    <div class="sidetitle"><%= me.nick %> 的小站</div>
    <div class="side">
      <a href="/<%= me.name %>">MyPage</a><br>
      <a href="/<%= me.name %>/album">相簿</a><br>
      <a href="/<%= me.name %>/blog">網誌</a><br>
      <a href="/<%= me.name %>/guestbook">留言板</a><br>
      <a href="/<%= me.name %>/card">名片</a><br>
      <a href="/<%= me.name %>/friends">好友</a><br>
      <a href="/<%= me.name %>/settings">個人設定</a>
    </div>
    <% } %>
  </td>

  <td class="side2"></td>
</tr></table>

<%- include('partials/foot') %>
