<%- include('partials/head',{title:'好友動態'}) %>
<%- include('partials/sitetop') %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="content1">

    <div class="title">好友動態</div>

    <% if (!acts.length) { %>
    <div class="side" align="center">好友還沒有新動態。先去加幾個好友吧！</div>
    <% } else { %>
    <table width="100%" border="0" cellpadding="0" cellspacing="0">
      <% acts.forEach(a => { %>
      <tr>
        <td class="side" width="60" align="center" valign="top">
          <a href="/<%= a.uname %>"><img src="<%= a.avatar %>" width="48" height="48" alt="<%= a.nick %>"></a>
        </td>
        <td class="side" valign="top">
          <a href="/<%= a.uname %>" class="font_title"><%= a.nick %></a>
          <%= a.kind==='blog' ? '發表了新文章' : (a.kind==='album' ? '上傳了新照片' : '有新動態') %>：
          <a href="<%= a.url %>"><%= a.title %></a><br>
          <span class="font_desc"><%= a.created.slice(0,16) %></span>
        </td>
      </tr>
      <% }) %>
    </table>
    <% } %>

    <%- include('partials/side',{visitors,friends}) %>

  </td>
  <td class="side2"></td>
</tr></table>
<%- include('partials/sitefoot') %>
<%- include('partials/foot') %>
