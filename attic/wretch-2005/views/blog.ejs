<%- include('partials/head',{title: u.nick + '的網誌', layout:'blog'}) %>
<%# 網誌文章列表（WRETCH_DOM.md 第 5 節）
    網誌頁不用 700px table，用原始的 div 版面：
      #container1 > #container2 > #banner + #main2( #content 浮左 + #links > #links2 ) + extraDiv
    每篇文章的 DOM 照契約一字不差：
      .blog > .date > .datediv ／ .blogbody > .blogbody2 > .articletext( a[name] + h3.title
              + .innertext + .extended ) + .posted
    同一天的多篇文章共用一個 .date 分隔，日期用英文長格式（November 1, 2007）。
    連結一律沿用原本的網址，沒有改任何 href。 %>
<%
  const MON = ['January','February','March','April','May','June',
               'July','August','September','October','November','December'];
  /* November 1, 2007 */
  const wDate = s => MON[+String(s).slice(5,7) - 1] + ' ' + (+String(s).slice(8,10)) + ', ' + String(s).slice(0,4);
  /* 03:00 PM */
  const wTime = s => { let h = +String(s).slice(11,13); const ap = h < 12 ? 'AM' : 'PM';
                       h = h % 12 || 12;
                       return String(h).padStart(2,'0') + ':' + String(s).slice(14,16) + ' ' + ap; };
%>
<div id="container1"><div id="container2">

  <div id="banner">
    <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
    <div id="pageheader">
      <h1><a href="/<%= u.name %>/blog"><%= u.nick %> 的小站</a></h1>
      <span class="description"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : SITE_DESC %></span>
      <div id="description2"><span class="description"></span></div>
    </div>
  </div>

  <div id="main2">

    <div id="content">

      <% if (cat || ym || day) { %>
      <div class="side">
        <% if (cat) { %>文章分類：<b><%= cat %></b>　<% } %>
        <% if (ym)  { %>月份彙整：<b><%= ym %></b>　<% } %>
        <% if (day) { %>文章日曆：<b><%= day %></b>　<% } %>
        <a href="/<%= u.name %>/blog">- 全部 -</a>
      </div>
      <% } %>

      <div class="blog">
        <% if (!posts.length) { %><div class="side">還沒有文章</div><% } %>
        <%
          let lastDay = null;
          posts.forEach(p=>{
            const day1   = p.created.slice(0,10);
            const locked = p.pass && !isOwner;          /* 上鎖文章不吐內文 */
            const cut    = p.body.length > 300;
            if (day1 !== lastDay) { lastDay = day1;
        %>
        <div class="date">
          <div class="datediv"><%= wDate(p.created) %></div>
        </div>
        <% } %>
        <div class="blogbody">
          <div class="blogbody2">
            <div class="articletext">
              <a name="<%= p.id %>"></a>
              <h3 class="title"><% if (p.pass) { %><img src="<%= CDN %>/icon/key.gif" width="16" height="16" alt="[鎖]"> <% } %><a href="/<%= u.name %>/blog/<%= p.id %>"><%= p.title %></a></h3>
              <div class="innertext"><% if (locked) { %>＊ 這篇文章已上鎖，需要密碼才能觀看 ＊<% } else { %><%- render(cut ? p.body.slice(0,300) + '…' : p.body) %><% } %></div>
              <% if (locked || cut) { %>
              <div class="extended"><a href="/<%= u.name %>/blog/<%= p.id %>">(繼續閱讀)</a></div>
              <% } %>
              <br clear="all" />
            </div>

            <div class="posted">
              <%= u.name %> at <a href="/blogs"><%= SITE_NAME %></a> at <%= wTime(p.created) %> post
              | <a href="/<%= u.name %>/blog/<%= p.id %>#comments">迴響(<%= p.nc %>)</a>
              | <a href="/<%= u.name %>/blog/<%= p.id %>#boxNewTrackback">引用</a>
              | <a href="/<%= u.name %>/blog/<%= p.id %>">收藏</a>
              | <a href="/<%= u.name %>/blog/<%= p.id %>">檢舉</a>
              | 分類：<a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(p.category) %>"><%= p.category %></a>
              <% if (p.mood) { %>| 心情：<%= p.mood %> <% } %><% if (p.weather) { %>| 天氣：<%= p.weather %><% } %>
            </div>

          </div><!-- /.blogbody2 -->
        </div><!-- /.blogbody -->
        <% }) %>
      </div><!-- /.blog -->

      <div class="side"><%- include('partials/pager') %></div>

    </div><!-- /#content -->

    <div id="links"><div id="links2">
      <%- include('partials/blogside') %>
    </div></div>

  </div><!-- /#main2 -->

  <div id="extraDiv1"><span></span></div>
  <div id="extraDiv2"><span></span></div>
  <div id="extraDiv3"><span></span></div>
  <div id="extraDiv4"><span></span></div>
  <div id="extraDiv5"><span></span></div>
  <div id="extraDiv6"><span></span></div>

</div></div><!-- /#container2 /#container1 -->
<%- include('partials/foot') %>
