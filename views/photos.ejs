<%- include('partials/head',{title:album.title}) %>
<table id="main"><tr><td>
<div class="box"><h3><a href="/<%= u.name %>/album">相簿</a> &raquo; <%= album.pass?'[鎖] ':'' %><%= album.title %> <span><%= photos.length %>張照片 ・ <%= album.views %> 人次</span></h3><div class="in">
<% if(album.descr){ %><div class="gray" style="margin-bottom:6px"><%= album.descr %></div><% } %>
<% if(!photos.length){ %><span class="gray">這本相簿還沒有照片</span><% } photos.forEach(p=>{ %><div class="thumb"><a href="/<%= u.name %>/photo/<%= p.id %>"><img src="<%= p.thumb||p.url %>" alt=""></a><br><%= p.caption %></div><% }) %>
<div class="clear"></div></div></div>
<% if (isOwner) { %>
<div class="box"><h3>上傳照片</h3><div class="in"><form method="post" enctype="multipart/form-data" action="/<%= u.name %>/album/<%= album.id %>/upload"><input type="file" name="photos" accept="image/*" multiple required> <input name="caption" placeholder="說明（選填）" maxlength="100"> <input type="submit" class="btn" value="上傳"><br><span class="gray">一次最多 20 張，每張 8MB 內（jpg/png/gif/webp）</span></form></div></div>
<div class="box"><h3>相簿設定</h3><div class="in"><form method="post" action="/<%= u.name %>/album/<%= album.id %>/edit"><table class="pf"><tr><td width="60">名稱</td><td><input name="title" value="<%= album.title %>" maxlength="40"></td></tr><tr><td>說明</td><td><input name="descr" size="40" value="<%= album.descr %>" maxlength="200"></td></tr><tr><td>密碼</td><td><input name="pass" size="12" value="<%= album.pass %>" maxlength="20"> <span class="gray">留空＝公開</span></td></tr><tr><td></td><td><input type="submit" class="btn" value="儲存"></td></tr></table></form>
<form method="post" action="/<%= u.name %>/album/<%= album.id %>/del" onsubmit="return confirm('確定刪除整本相簿與所有照片？')"><button class="btn red">刪除相簿</button></form></div></div><% } %>
</td><%- include('partials/side') %></tr></table>
<%- include('partials/foot') %>
