<%
  /* 人氣排行 /rank
     ─────────────────────────────────────────────────────────────
     這一頁原本吃 partials/head（2005 綠版 760px 兩欄），是上一輪 2005 版留下來的。
     WRETCH_2012.md §1-B 已經定案「整站統一 2012，不與 2005 的橘／藍混搭」，
     而這一頁從 2012 的外框到處連得到——頁首「目前共 N 位站友」那條、
     頁尾 RSS 列的「名家專欄」、首頁「我的」清單的「排行榜」、
     影音／嘀咕／揪團三個總站的側欄——點過去整個版面換成綠色 2005，
     是全站最刺眼的一處混搭。改成跟 /video /digu /join 同一套外框與元件。

     原站的 www.wretch.cc/rank/ 沒有任何存檔，所以照 §3-A：用站台既有的
     .mod / .w2-auth / .w2-bloglist / .w2-ranklist 組出來，不自創新的視覺。

     資料來自 src/server.js 的 app.get('/rank')：users / albums / posts。

     ⚠ posts 是 `ORDER BY p.views DESC` 撈出來的，但這一頁沿用無名的「得點」
     （瀏覽 ×10 ＋ 推薦 ×50）當名次數字，兩者不同調——照原順序印出來會看到
     第 2 名 187940、第 3 名 189650 這種數字倒著長的畫面。
     排序的 SQL 在 src/server.js（共用檔，不在這一輪能改的範圍），
     所以在 view 這一層依實際顯示的數字重排；撈出來的三十筆不變。 */
  const rkScore = p => p.views * 10 + p.likes * 50;
  const rkPosts = posts.slice().sort((a, b) => rkScore(b) - rkScore(a));
  /* 摘要：先把 BBCode 標記拿掉再截斷，不然畫面上會直接看到 `[b]小丁[/b]`
     （稽核在正式站的熱門網誌區抓到）。這是純文字摘要不是內文，
     所以呼叫端維持逸出輸出（EJS 的逸出插值），這裡只清標記、不做 render。 */
  const rkSummary = s => {
    const t = String(s || '').replace(/\[\/?[^\]]{1,20}\]/g, '').trim();
    return t.length > 80 ? t.slice(0, 80) + '…' : t;
  };
%>
<%- include('partials/head2012', { title: '人氣排行 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth" id="users">
        <div class="hd"><h2>站友人氣榜</h2></div>
        <div class="bd">
          <% if (!users.length) { %><p>還沒有站友，快來申請第一個帳號！</p><% } %>
          <ol class="w2-ranklist">
            <% users.forEach((x, i) => { %>
            <li>
              <span class="no"><%= i + 1 %></span>
              <a class="ava" href="/<%= x.name %>"><img src="<%= x.avatar %>" width="20" height="20" alt="<%= x.nick %>"></a>
              <span class="num">累積人氣 <%= x.visits %></span>
              <a href="/<%= x.name %>"><%= x.nick %></a>
              <span class="w2-blog-n">(<%= x.name %>)</span>
            </li>
            <% }) %>
          </ol>
        </div>
      </div>

      <div class="mod w2-auth" id="albums">
        <div class="hd"><h2>熱門相簿</h2></div>
        <div class="bd">
          <% if (!albums.length) { %><p>還沒有公開相簿。</p><% } %>
          <ul class="w2-albumgrid">
            <% albums.forEach((a, i) => { %>
            <li>
              <a href="/<%= a.uname %>/album/<%= a.id %>" title="<%= a.title %>">
                <%# 相簿封面有時候存的是原圖（src/server.js 的 /photo/:pid/cover），
                    比例不一定是正方，所以用 CSS 裁切而不是硬拉成 108×108。 %>
                <img src="<%= a.cover || '/img/wretch2012/blog/user_cover.gif' %>" alt="<%= a.title %>">
              </a>
              <a class="t" href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a>
              <%# 一格只有 108px 寬。原本寫「第 N 名・1234 人次」，實測會折成兩行，
                  而且只有部分格子會折，整排的基線就參差不齊。名次改成前綴的序號。 %>
              <span class="n"><%= i + 1 %>. <%= a.views %> 人次</span>
              <a class="n" href="/<%= a.uname %>"><%= a.nick %></a>
            </li>
            <% }) %>
          </ul>
          <p class="w2-more"><a href="/albums">更多相簿</a></p>
        </div>
      </div>

      <div class="mod w2-auth" id="posts">
        <div class="hd"><h2>熱門網誌</h2></div>
        <div class="bd">
          <% if (!posts.length) { %><p>還沒有文章。</p><% } %>
          <ol class="w2-bloglist w2-nothumb">
            <% rkPosts.forEach((p, i) => { %>
            <li>
              <div class="content">
                <p class="meta">
                  <span class="no"><%= i + 1 %></span>
                  <a class="uname" href="/<%= p.uname %>"><%= p.nick %></a>
                  <span class="topic">得點 <%= rkScore(p) %></span>
                </p>
                <h3><a class="skin-main-link" href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></h3>
                <%# ⚠ 摘要要先把 BBCode 標記拿掉再截斷，不然畫面上會直接看到
                    `[b]小丁[/b]` 這種東西（稽核在正式站的熱門網誌區抓到）。
                    這裡是純文字摘要不是內文，所以維持逸出插值輸出，
                    只把標記清掉，不做 render——摘要裡不需要粗體與圖片。 %>
                <%# ⚠ 這裡在 forEach 迴圈裡，**不能用 const**——EJS 把整個樣板編成
                    一個函式，迴圈第二圈就會撞「已經宣告過」而整頁 500。
                    用一個在最上面定義好的輔助函式。 %>
                <p class="description"><%= rkSummary(p.body) %></p>
              </div>
            </li>
            <% }) %>
          </ol>
          <p class="w2-more"><a href="/blogs">更多網誌</a></p>
        </div>
      </div>

    </div>
    <div class="side">

      <div class="mod w2-auth-side">
        <div class="hd"><h2>排行分類</h2></div>
        <div class="bd">
          <ul>
            <li><a href="#users">站友人氣榜</a></li>
            <li><a href="#albums">熱門相簿</a></li>
            <li><a href="#posts">熱門網誌</a></li>
          </ul>
        </div>
      </div>

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/video">影音</a></li>
            <li><a href="/join">揪團</a></li>
            <li><a href="/digu">嘀咕</a></li>
            <li><a href="/help">服務說明</a></li>
          </ul>
        </div>
      </div>

      <% if (!me) { %>
      <div class="mod w2-auth-side">
        <div class="hd"><h2>一個帳號，多項功能</h2></div>
        <div class="bd">
          <p><a href="/register">免費註冊</a>之後就有自己的相簿、網誌與留言板。</p>
          <p class="w2-auth-cta"><a class="w2-btn" href="/login">會員登入</a></p>
        </div>
      </div>
      <% } %>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
