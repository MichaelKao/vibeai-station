<%- include('partials/head',{title:u.nick+'的相簿'}) %>
<table id="main"><tr><td>
<% if (isOwner) { %><div class="box"><h3>建立新相簿</h3><div class="in"><form method="post" action="/<%= u.name %>/album"><table class="pf"><tr><td width="60">相簿名稱</td><td><input name="title" maxlength="40" required></td></tr><tr><td>說明</td><td><input name="descr" size="40" maxlength="200"></td></tr><tr><td>密碼</td><td><input name="pass" size="12" maxlength="20"> <span class="gray">留空＝公開相簿</span></td></tr><tr><td></td><td><input type="submit" class="btn" value="建立"></td></tr></table></form></div></div><% } %>
<div class="box"><h3><%= u.nick %>的相簿 <span>共 <%= albums.length %> 本</span></h3><div class="in">
<% if(!albums.length){ %><span class="gray">還沒有相簿</span><% } albums.forEach(a=>{ %><div class="thumb"><a href="/<%= u.name %>/album/<%= a.id %>"><img src="<%= a.cover||'/img/empty.png' %>" alt=""></a><br><a href="/<%= u.name %>/album/<%= a.id %>"><%= a.pass?'[鎖] ':'' %><%= a.title %></a><br><span class="gray"><%= a.n %> 張 ・ <%= a.views %> 人次</span></div><% }) %>
<div class="clear"></div></div></div>
</td><%- include('partials/side') %></tr></table>
<%- include('partials/foot') %>
