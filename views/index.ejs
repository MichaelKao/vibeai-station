              <li><a class="skin-main-link-hover" href="/albums">相簿</a></li>
              <li><a class="skin-main-link-hover" href="/rank">排行榜</a></li>
              <li><a class="skin-main-link-hover" href="/search">搜尋</a></li>
              <li><a class="skin-main-link-hover" href="/help">服務說明</a></li>
              <li><a class="skin-main-link-hover" href="/login">會員登入</a></li>
              <li><a class="skin-main-link-hover" href="/register">免費註冊</a></li>
            </ul>
            <ul class="my-services ft-service8">
              <li><a class="skin-main-link-hover" href="/blogs">網誌</a></li>
              <li><a class="skin-main-link-hover" href="/albums">相簿</a></li>
              <li><a class="skin-main-link-hover" href="/rank">排行榜</a></li>
