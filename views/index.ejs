        </div>
        <% } %>
      </div>
      <a class="more-recommended main-more" title="更多" href="/blogs">更多</a>

      <div class="sub-content clearfix">
        <% const w2P1 = hotPosts[1], w2P2 = hotPosts[2], w2P3 = hotPosts[3]; %>
        <div class="mix-wrapper ugc-block pic-text-2 clearfix">
          <span>人氣文章</span>
          <% if (w2P1) { %>
          <div class="mix-item ugc-block clearfix">
            <a href="/<%= w2P1.uname %>/blog/<%= w2P1.id %>" class="ugc-block image" title="<%= w2P1.title %>">
              <img src="<%= w2Cover(w2P1) %>" width="207" height="155" class="mix-img" alt="<%= w2P1.title %>">
            </a>
            <div class="mix-article">
              <h6>
                <a href="/<%= w2P1.uname %>/blog/<%= w2P1.id %>" title="<%= w2P1.title %>">
                  <%= w2P1.title %>
                </a>
              </h6>
              <p>
                <%= w2Cap(w2P1.body, 34) %>
              </p>
            </div>
          </div>
          <% } %>
        </div>
        <div class="mix-wrapper ugc-block pic-text-2 clearfix last normal">
          <span>大家都在看</span>
          <% if (w2P2) { %>
          <div class="mix-item ugc-block clearfix">
            <a href="/<%= w2P2.uname %>/blog/<%= w2P2.id %>" class="ugc-block" title="<%= w2P2.title %>"><img src="<%= w2Cover(w2P2) %>" width="207" height="155" class="mix-img image" alt="<%= w2P2.title %>"></a>
            <div class="mix-article">
              <h5>
                <a href="/<%= w2P2.uname %>/blog/<%= w2P2.id %>" title="<%= w2P2.title %>">
                  <%= w2P2.title %>
                </a>
              </h5>
              <p>
                <%= w2Cap(w2P2.body, 34) %>
              </p>
            </div>
            <% if (w2P3) { %>
            <div class="recommended-links">
              <div class="mix-article">
                <h6>
                  <a href="/<%= w2P3.uname %>/blog/<%= w2P3.id %>" title="<%= w2P3.title %>">
                    <%= w2P3.title %>
                  </a>
                </h6>
                <p>
                  <%= w2Cap(w2P3.body, 34) %>
                </p>
              </div>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="hybrid-decoration-line"></div>
  </div>

</div>

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix">
    <div class="main">

      <%# ⑫ 名家專欄：人氣排行榜，分頁籤改成站內分類 %>
      <div id="wfp-celebrity">
        <div class="hd">
          <header>
            <h2>名家專欄</h2>
          </header>
          <div class="nav">
            <ul class="skin-tab">
              <% w2Cele.forEach((c, i) => { %>
              <li id="<%= c.id %>" class="<%= i === 0 ? 'first on' : '' %>"><a href="/blogs?topic=<%= encodeURIComponent(c.topic) %>"><%= c.topic %></a></li>
              <% }) %>
            </ul>
          </div>
        </div>
        <div class="bd">
          <% if (!rank.length) { %><p>還沒有站友，快來申請第一個帳號！</p><% } %>
          <ul>
            <% rank.slice(0, 3).forEach((r, i) => { %>
            <li class="<%= i === 0 ? 'first' : (i === 2 ? 'last' : '') %>">
              <a href="/<%= r.name %>" class="thumbnail"><img src="<%= w2UserPic(r.name) %>" alt="<%= r.nick %>"></a>
              <header>
                <hgroup>
                  <h4><a href="/<%= r.name %>"><%= r.nick %></a></h4>
                  <h3><a class="skin-main-link" href="/<%= r.name %>"><%= r.name %> 的小站</a></h3>
                </hgroup>
              </header>
              <% if (i === 0) { %>
              <p>累積人氣 <%= r.visits %>，目前站上人氣第一名。到他的小站看看相簿與網誌吧。</p>
              <% } %>
            </li>
            <% }) %>
          </ul>
        </div>
        <div class="ft">
          <p class="more"><a href="/rank">更多排行</a></p>
        </div>
        <div id="celebrity-corner-ad"></div>
        <%# 原版這顆是名家專欄 AJAX 換頁用的 CSRF token（crumb），
            快照裡 value 就是空字串（爬蟲沒登入）。我們的分頁是純連結不走 AJAX，
            節點照留，值一樣留空——版面識別字的一部分。 %>
        <input type="hidden" id="wfp-celebrity-token" value="">
      </div>

      <%# ⑬ 官方部落格位置改放站內分類連結 %>
      <div id="wfp-blog-entry" class="clearfix mod">
        <h2>站內分類</h2>
        <nav class="blog-navigation">
          <%# 原站一列 5 個（辦公室／愛正妹…都是 3 個字），
              本站的分類是 4 個字，一列排 4 個才不會在 296px 裡折行 %>
          <div class="emphatic">
            <ul class="first">
              <% w2AlbumTopics.slice(0, 4).forEach(t => { %>
              <li><a class="skin-main-link" href="/albums?topic=<%= encodeURIComponent(t) %>"><%= t %></a></li>
              <% }) %>
            </ul>
            <ul>
              <% w2AlbumTopics.slice(4, 8).forEach(t => { %>
              <li><a class="skin-main-link" href="/albums?topic=<%= encodeURIComponent(t) %>"><%= t %></a></li>
              <% }) %>
            </ul>
          </div>
          <div class="normal">
            <ul class="first">
              <% w2BlogTopics.slice(0, 2).forEach(t => { %>
              <li><a href="/blogs?topic=<%= encodeURIComponent(t) %>"><%= t %></a></li>
              <% }) %>
            </ul>
            <ul>
              <% w2BlogTopics.slice(2, 5).forEach(t => { %>
              <li><a href="/blogs?topic=<%= encodeURIComponent(t) %>"><%= t %></a></li>
              <% }) %>
            </ul>
          </div>
        </nav>
        <div id="blog-entry-corner-ad"></div>
      </div>

    </div>
    <div class="side">

      <%# ⑭ 投稿精選：推薦＝站長精選網誌，隨機＝新加入的站友 %>
      <div id="wfp_top_daily_blogs" class="mod">
        <div class="hd">
          <header class="header">
            <h2>投稿精選</h2>
          </header>
          <ul class="nav skin-tab">
            <li class="top_daily_blogs-recommend on">
              <a href="/blogs">推薦</a>
            </li>
            <li class="top_daily_blogs-random">
              <a href="/rank">隨機</a>
            </li>
          </ul>
        </div>
        <div class="bd top_daily_blogs-recommend">
          <ol id="top_daily_blogs-recommend" class="top_daily_blogs-recommend skin-order">
            <% if (!featPosts.length) { %>
            <li>
              <article class="article">
                <header class="header">
                  <h3 data-order="1"><a class="skin-side-title" href="/blogs">站長還沒挑選精選文章</a></h3>
                </header>
                <div class="content">
                  <p class="description">被站長選中的文章會出現在這裡。</p>
                </div>
              </article>
            </li>
            <% } %>
            <% featPosts.slice(0, 2).forEach((p, i) => { %>
            <li class="<%= i === 1 ? 'last' : '' %>">
              <article class="article">
                <header class="header">
                  <h3 data-order="<%= i + 1 %>">
                  <a class="skin-side-title" href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a>
                  </h3>
                </header>
                <a class="thumbnail" href="/<%= p.uname %>/blog/<%= p.id %>"><img src="<%= w2UserPic(p.uname) %>" width="80" height="80" alt=""></a>
                <div class="content">
                  <a href="/<%= p.uname %>/blog/<%= p.id %>">
                  <p class="description"><%= w2Cap(p.body, 52) %></p>
                  </a>
                </div>
              </article>
            </li>
            <% }) %>
          </ol>
          <ol id="top_daily_blogs-random" class="top_daily_blogs-random skin-order">
            <% newUsers.slice(0, 2).forEach((x, i) => { %>
            <li class="<%= i === 1 ? 'last' : '' %>">
              <article class="article">
                <header class="header">
                  <h3 data-order="<%= i + 1 %>">
                  <a class="skin-side-title" href="/<%= x.name %>"><%= x.nick %></a>
                  </h3>
                </header>
                <a class="thumbnail" href="/<%= x.name %>"><img src="<%= w2UserPic(x.name) %>" width="80" height="80" alt=""></a>
                <div class="content">
                  <a href="/<%= x.name %>">
                  <p class="description">新加入的站友 <%= x.name %>，去他的小站打聲招呼吧。</p>
                  </a>
                </div>
              </article>
            </li>
            <% }) %>
          </ol>
        </div>

        <div class="ft top_daily_blogs-recommend">
          <p class="more top_daily_blogs-recommend">
            <a href="/blogs">
            更多推薦</a>
          </p>
          <p class="more top_daily_blogs-random">
            <a href="/rank">
            更多推薦</a>
          </p>
        </div>
      </div>

    </div>
  </div>
<%- include('partials/foot2012') %>
