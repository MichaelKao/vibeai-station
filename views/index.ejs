              <li><a class="skin-main-link-hover" href="/register">免費註冊</a></li>
            </ul>
            <span>my</span>
          </div>
          <% } %>
        </div>
      </div>

      <%# ⑨ 站方公告：原站的 3 張 85×60 小廣告位改放站上人氣相簿封面 %>
      <div id="wfp-announcement">
        <% const w2Ads = hotAlbums.slice(1, 4); %>
        <%# 三張 85×60 剛好填滿 279px（85 + 97 + 97），p 之間不能有空白字元，
            不然 inline-block 的字距會把第三張擠到第二行被 overflow 切掉 %>
        <% if (w2Ads.length) { %>
        <div class="annoad3"><% w2Ads.forEach((a, i) => { %><p class="<%= i === 0 ? 'firstad' : '' %>"><a href="/<%= a.uname %>/album/<%= a.id %>" title="<%= a.title %>"><img src="<%= a.cover %>" width="85" height="60" alt="<%= a.title %>"></a></p><% }) %></div>
        <% } %>
        <ul>
          <% if (!notices.length) { %>
          <li><a href="/help">[公告]目前沒有站方公告</a></li>
          <% } %>
          <% notices.slice(0, 3).forEach(n => { %>
          <li><a href="/help"><%= w2Cap(n.body, 22) %></a></li>
          <% }) %>
        </ul>
        <p><a href="/help">更多站方公告</a></p>
      </div>

      <%# ⑩ 最新熱門活動：站方公告第 2 則以後 %>
      <div id="wfp-today" class="mod">
        <div class="hd">
          <header class="header">
            <h2>最新熱門活動</h2>
          </header>
          <div id="today-corner-ad"></div>
        </div>
        <div class="bd">
          <ol class="skin-order">
            <% const w2Today = notices.slice(1, 4);
               const w2TodayKind = ['activity', 'talk', 'vote last']; %>
            <% if (!w2Today.length) { %>
            <li class="clearfix activity last">
              <article>
                <header><h3 data-order="1"><span class="skin-side-title"><a href="/help">目前沒有進行中的活動</a></span></h3></header>
                <div class="content">
                  <p class="description"><a href="/help">站長發佈新的活動之後，就會出現在這裡。</a></p>
                  <p class="more"><a href="/help">更多站方公告</a></p>
                </div>
              </article>
<%- include('partials/wfpsharing2012', { wsSide: 'right', wsPath: '/help', wsTitle: SITE_NAME }) %>
            </li>
            <% } %>
            <% w2Today.forEach((n, i) => { const w2Th = newPhotos[i + 3] || newPhotos[i] || null; %>
            <li class="clearfix <%= w2TodayKind[i] || 'activity' %>">
              <article>
                <header>
                  <h3 data-order="<%= i + 1 %>">
                    <span class="skin-side-title">
                    <a href="/help"><%= w2Cap(n.body, 12) %></a>
                    </span>
                  </h3>
                </header>
                <% if (w2Th) { %>
                <a class="thumbnail" href="/<%= w2Th.uname %>/photo/<%= w2Th.id %>"><img src="<%= w2Pic(w2Th) %>" width="100" height="75" alt=""></a>
                <% } %>
                <div class="content">
                  <p class="description">
                    <a href="/help"><%= w2Cap(n.body, 46) %></a>
                  </p>
                  <p class="more"><a href="/help">更多站方公告</a></p>
                </div>
              </article>
<%# 每一則活動都有自己的分享列。CSS 讓它預設 display:none，
    滑到該則上面（.sharing-on）才現身——跟原版靜態畫面一致。 %>
<%- include('partials/wfpsharing2012', { wsSide: 'right', wsPath: '/help', wsTitle: w2Cap(n.body, 40) }) %>
            </li>
            <% }) %>
          </ol>
        </div>
      </div>

    </div>
  </div>
</div><!-- /#wrapper -->

<%# ⑪ 熱門內容腰帶：跨滿版的深色帶，是 #bg-wrapper 的兄弟節點 %>
<div class="belt">

  <div id="wfp-hybrid" class="mod second">
    <div class="hd">
      <div class="tabs">
        <ul class="tabs-list clearfix">
          <% w2Belt.forEach((t, i) => { const w2Bc = hotAlbums[i]; %>
          <li class="tabs-cell <%= i === 1 ? 'on ' : '' %>" data-order="<%= i + 1 %>">
            <div class="tabs-content">
              <% if (w2Bc) { %><img src="<%= w2Bc.cover %>" alt="<%= t.name %>"><% } %>
              <h4><%= t.name %></h4>
              <span class="desc break"><%= t.desc %></span>
            </div>
          </li>
          <% }) %>
        </ul>
      </div>
    </div>
    <div class="belt-line"></div>
    <div class="bd clearfix">
      <div class="main-content clearfix">
        <% if (hotPosts.length) { const w2P0 = hotPosts[0]; %>
        <div class="image-wrapper ugc-block">
          <a href="/<%= w2P0.uname %>/blog/<%= w2P0.id %>" title="<%= w2P0.title %>" class="no-line">
            <img alt="<%= w2P0.title %>" src="<%= w2Cover(w2P0) %>" width="217" height="217">
          </a>
        </div>
        <div class="article-wrapper ugc-block">
          <span>熱門網誌</span>
          <div class="mix-article">
            <h5>
              <a href="/<%= w2P0.uname %>/blog/<%= w2P0.id %>" title="<%= w2P0.title %>">
                <%= w2P0.title %>
              </a>
            </h5>
            <p>
              <%= w2Cap(w2P0.body, 70) %>
            </p>
          </div>
          <div class="recommended-links">
            <span>站長精選</span>
            <ul>
              <% (featPosts.length ? featPosts : hotPosts.slice(1)).slice(0, 3).forEach(p => { %>
              <li>
                <a href="/<%= p.uname %>/blog/<%= p.id %>" title="<%= p.title %>">
                  <%= p.title %>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>
        </div>
        <% } else { %>
        <div class="article-wrapper ugc-block">
          <span>熱門網誌</span>
          <div class="mix-article">
            <h5><a href="/blogs">還沒有人發表文章</a></h5>
            <p>站上的第一篇網誌，等你來寫。</p>
