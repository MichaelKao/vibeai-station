<%- include('partials/head2012', { title: '無名小站' }) %>
<%
  /* 無名小站 2012 最後版首頁（www.wretch.cc/）1:1 復刻
     ─────────────────────────────────────────────────────────────
     骨架、id、class 一字不差照 assets_src2/spec/index.md 第 2、6 節
     與原始檔 assets_src2/html/index_20120610082113.html。
     樣式全部吃 public/wretch2012.css（原站原始 CSS），這裡不寫任何新 CSS。

     版面 1:1，內容接本站真實資料（WRETCH_2012.md 第 1-A 節）：

       #wfp-cover          今日主題      ← notices[0]
       #wfp-inner-search   站內搜尋      → GET /search?q=
       #wfp-featured       熱門相簿      ← hotAlbums + newPhotos
       #wfp-my             我的          ← me
       #wfp-announcement   公告          ← notices
       #wfp-today          最新熱門活動  ← notices 第 2 則以後
       #wfp-hybrid         熱門內容腰帶  ← featPosts + hotPosts
       #wfp-celebrity      名家專欄      ← rank（分頁籤＝站內分類）
       #wfp-blog-entry     官方部落格    → 站內分類連結
       #wfp_top_daily_blogs 投稿精選     ← featPosts / newUsers

     沒資料一律走空狀態，不塞原站的照片或文章。

     原站有 JS 在跑（堆疊照片排序、分頁切換、日曆展開），復刻版沒有 JS，
     所以把 JS 會加上的 class（first-block/second-block/third-block、
     pagination 的 on、archive-relative）直接寫死在 HTML 裡，
     靜態畫面才會跟原版一致。

     注意：EJS 用 with(locals)，不能宣告和 local 同名的 const。
     這裡的輔助變數一律加 w2 前綴避開。 */

  /* 內文純文字化：拿掉 [img]…[/img] 整段，其餘 [tag] 只去標記，壓空白後截斷 */
  const w2Cap = (s, n) => {
    const t = String(s || '')
      .replace(/\[img\][\s\S]*?\[\/img\]/gi, '')
      .replace(/\[[^\[\]\n]{1,40}\]/g, '')
      .replace(/\s+/g, ' ').trim();
    return t.length > n ? t.slice(0, n) + '…' : t;
  };
  const w2Pic  = p => p.thumb || p.url;                    // 照片縮圖，沒有就用原圖
  /* 文章的代表圖：先用作者最新一張公開照片（pthumb），沒有就用作者的大頭貼，
     都沒有才落到無名那張「沒有封面」的卡通圖。原版這一格放的就是作者的封面圖，
     整排卡通圖示會讓首頁看起來像沒載入完。 */
  const w2Cover = p => (p && p.pthumb) ? p.pthumb
    : (p && p.avatar && p.avatar !== '/img/avatar.png') ? p.avatar
    : CDN + '/icon/user_cover.gif';
  /* 某位站友能拿來當縮圖的圖：先找他公開的相簿封面，再找他的照片，
     都沒有就用無名的「沒有封面」預設圖。首頁 route 沒有給每位站友的代表圖，
     只能從已經拿到的 hotAlbums / newPhotos 裡挑。 */
  /* 帳號 → 大頭貼。首頁好幾個模組（排行榜、投稿精選、最新加入）都要拿人的代表圖，
     每個清單的查詢各自帶了 avatar，這裡合成一張表，找不到才落到預設圖。 */
  const w2Avatars = new Map();
  for (const list of [locals.rank, locals.featPosts, locals.newUsers])
    for (const x of (list || [])) {
      const n = x.name || x.uname;
      if (n && x.avatar && x.avatar !== '/img/avatar.png' && !w2Avatars.has(n)) w2Avatars.set(n, x.avatar);
    }
  const w2UserPic = uname => {
    const a = (featAlbums.concat(hotAlbums)).find(x => x.uname === uname && x.cover);
    if (a) return a.cover;
    const p = newPhotos.find(x => x.uname === uname);
    if (p) return w2Pic(p);
    // 這幾個清單裡找不到那個人時，退回他的大頭貼——首頁各模組的人本來就不一定
    // 出現在熱門相簿或最新照片裡，只靠那兩個清單找的話大多會落到卡通預設圖。
    const av = w2Avatars.get(uname);
    if (av) return av;
    return CDN + '/icon/user_cover.gif';
  };

  /* 日期／日曆（#wfp-archive）：原站是 11 格，今天 selected，往前推 10 天 */
  const w2Months = ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
  const w2Pad = n => String(n).padStart(2, '0');
  const w2Now = new Date();
  const w2Ymd = d => d.getFullYear() + '-' + w2Pad(d.getMonth() + 1) + '-' + w2Pad(d.getDate());
  const w2Days = [];
  for (let i = 0; i < 11; i++) {
    const d = new Date(w2Now.getFullYear(), w2Now.getMonth(), w2Now.getDate() - i);
    w2Days.push(d);
  }

  /* 站內分類（src/taxonomy.js 的 ALBUM_TOPICS / BLOG_TOPICS，首頁 route 沒有傳進來，
     這裡取用到的前幾項；連結對得上 /albums?topic= 與 /blogs?topic=） */
  const w2AlbumTopics = ['國內旅遊','國外旅遊','美食記錄','流行時尚',
                         '圖像創作','專業攝影','心肝寵物','學園生活'];
  const w2BlogTopics  = ['創作','旅遊','生活','運動','娛樂'];
  /* 名家專欄的五個分頁籤。原版的 id 是 celebrity_artist/model/athletes/writer/politician
     （藝人／模特兒／運動明星／作家／政治名人）——那是版面識別字不是資料，照抄。
     我們沒有「名家」這種身分，分頁改接站內分類（src/taxonomy.js 的 BLOG_TOPICS），
     挑語意最接近的五類對上去，這樣 id 的意思跟看到的東西還對得起來。 */
  const w2Cele = [
    { id:'celebrity_artist',     topic:'娛樂' },
    { id:'celebrity_model',      topic:'流行' },
    { id:'celebrity_athletes',   topic:'運動' },
    { id:'celebrity_writer',     topic:'創作' },
    { id:'celebrity_politician', topic:'社會' },
  ];

  /* 腰帶四個分頁＝四個網誌分類（原站是編輯部的四個企劃頻道） */
  const w2Belt = [
    { name:'創作', desc:'畫圖、寫字、手作，通通貼上來' },
    { name:'旅遊', desc:'走走看看，記錄一路上的風景' },
    { name:'生活', desc:'日常的小事最耐看' },
    { name:'流行', desc:'穿搭、彩妝、最新話題' },
  ];

  const w2Notice0 = notices[0] || null;
%>
  <div class="bd big-bd clearfix archive-relative">
    <div class="main">

      <%# ④ 左側浮出的日期／日曆小工具（絕對定位在 #wrapper 左外側） %>
      <div id="wfp-archive" class="collapse">
        <div class="hd">
          <h3><a href="/">今天</a></h3>
          <div>
            <p id="wfp-archive-today"><span class="month"><%= w2Months[w2Now.getMonth()] %></span><span class="day"><%= w2Pad(w2Now.getDate()) %></span></p>
            <a id="wfp-archive-switcher" href="#"><span>展開/收合</span></a>
          </div>
        </div>
        <div class="bd">
          <a id="wfp-archive-forward" href="#">未來</a>
          <ul id="wfp-archive-calendar">
            <% w2Days.forEach((d, i) => { %>
            <li class="date <%= i === 0 ? 'selected' : 'normal' %>">
              <a href="/?date=<%= w2Ymd(d) %>"><%= w2Pad(d.getDate()) %></a>
            </li>
            <% }) %>
          </ul>
          <a id="wfp-archive-backward" href="#">過去</a>
        </div>
        <% w2Months.forEach(m => { %><input type="hidden" name="monthUnit" value="<%= m %>">
        <% }) %><input type="hidden" name="todayTopic" value="今日主題">
      </div>

      <%# ⑤ 今日主題：站方公告當主題文案，堆疊照片用站上最新的照片 %>
      <div id="wfp-cover" class="mod stack-layout bright bright-stack-layout">
        <input type="hidden" id="cover-type" value="stack">
        <input type="hidden" id="cover-sub-type" value="">
        <input type="hidden" id="cover-auto" value="">
        <div class="bd stack ">
          <div class="title">
            <article class="article">
              <header class="header">
                <span>今日主題</span>
                <% if (w2Notice0) { %>
                <h2 data-title="<%= w2Cap(w2Notice0.body, 24) %>"><a href="/help"><%= w2Cap(w2Notice0.body, 24) %></a></h2>
                <% } else { %>
                <h2 data-title="歡迎光臨"><a href="/help">歡迎光臨</a></h2>
                <% } %>
              </header>
              <p>
                <% if (w2Notice0) { %><%= w2Notice0.created.slice(0, 10) %><br><% } %>
                <% if (notices.length > 1) { notices.slice(1, 4).forEach(n => { %><%= w2Cap(n.body, 16) %><br><% }) } %>
                <% if (!w2Notice0) { %>站長還沒發佈公告<br>先四處逛逛吧<% } %>
              </p>
            </article>
          </div>
          <div class="gallery clearfix">
            <% newPhotos.slice(0, 3).forEach((p, i) => {
                 const w2BlockClass = ['first-block', 'second-block', 'third-block'][i];
                 const w2Title = p.caption ? w2Cap(p.caption, 30) : p.atitle; %>
            <div class="block <%= w2BlockClass %>" data-title="<%= w2Title %>">
              <a title="<%= w2Title %>" href="/<%= p.uname %>/photo/<%= p.id %>">
                <img src="<%= w2Pic(p) %>" width="418" height="274" alt="<%= w2Title %>">
              </a>
              <div class="inner-block">
                <h3 class="inner-title"><a title="<%= w2Title %>" href="/<%= p.uname %>/photo/<%= p.id %>"><%= w2Title %></a></h3>
                <p class="inner-caption"></p>
              </div>
            </div>
            <% }) %>
          </div>
          <div class="pagination">
            <ol>
              <% newPhotos.slice(0, 3).forEach((p, i) => { %>
              <li><span title="<%= p.caption ? w2Cap(p.caption, 30) : p.atitle %>" class="pagi<%= i === 0 ? ' on' : '' %>" target="<%= i + 1 %>"></span></li>
              <% }) %>
            </ol>
          </div>

<%# 分享列（靠右）。原版位置就是這裡：.pagination 收掉之後、.bd.stack 收掉之前。 %>
<%- include('partials/wfpsharing2012', { wsSide: 'right', wsPath: '/',
      wsTitle: notices.length ? w2Cap(notices[0].body, 40) : SITE_NAME }) %>

        </div>
      </div>

      <%# ⑥ 站內深色搜尋條 → GET /search?q= %>
      <div id="wfp-inner-search">
        <form action="/search" method="GET">
          <fieldset>
            <legend class="title-hide">Wretch Search</legend>
            <div class="search-type">
              <span class="title-hide">目前搜尋類別：</span><span id="inner-search-type">文章搜尋</span>
              <dl>
                <dt>變更搜尋類別：</dt>
                <dd>
                  <ul>
                    <li>
                      <input type="radio" name="type" id="inner-search-article" value="article" checked="checked"><label for="inner-search-article">文章搜尋</label>
                    </li>
                    <li>
                      <input type="radio" name="type" id="inner-search-photo" value="photo"><label for="inner-search-photo">相簿搜尋</label>
                    </li>
                    <li>
                      <input type="radio" name="type" id="inner-search-video" value="video"><label for="inner-search-video">影音搜尋</label>
                    </li>
                  </ul>
                </dd>
              </dl>
            </div>
            <div class="search-input">
              <label for="inner-search-input" class="title-hide">輸入搜尋字串：</label>
              <span><input type="text" placeholder="搜尋無名小站文章" autocomplete="off" id="inner-search-input" name="q"></span>
              <button value="搜尋" type="submit">搜尋</button>
            </div>
            <div class="suggestMenu">
            </div>
          </fieldset>
        </form>
        <input type="hidden" id="wfp-inner-search-article" value="搜尋無名小站文章">
        <input type="hidden" id="wfp-inner-search-photo" value="搜尋無名小站相簿">
        <input type="hidden" id="wfp-inner-search-video" value="搜尋無名小站影音">
      </div>

      <%# ⑦ 熱門相簿：1 大（人氣第一的相簿封面）+ 6 小（站上最新照片） %>
      <div id="wfp-featured" class="mod">
        <div class="hd">
          <h2>熱門相簿</h2>
          <div class="tab">
            <ul class="skin-tab">
              <li class="on first"><a href="/albums">人氣相簿</a></li>
              <li class=""><a href="/albums?topic=<%= encodeURIComponent('女生個人') %>">站內分類</a></li>
            </ul>
          </div>
        </div>
        <div class="bd">
          <div class="featured-photos" id="featured_selected">
            <% if (!hotAlbums.length && !newPhotos.length) { %>
            <p>還沒有公開相簿，快來上傳第一張照片！</p>
            <% } %>
            <ul class="clearfix">
              <% if (hotAlbums.length) { const w2Best = hotAlbums[0]; %>
              <li class="best">
                <a href="/<%= w2Best.uname %>/album/<%= w2Best.id %>" title="<%= w2Best.title %>">
                  <img src="<%= w2Best.cover %>" alt="<%= w2Best.title %>">
                </a>
                <span class="featured-medal">本日最熱門</span>
                <div class="panel best-panel">
                  <div class="panel-text">
                    <h5 class="model-name">
                      <a href="/<%= w2Best.uname %>" title="<%= w2Best.nick %>"><%= w2Best.nick %></a>
                      <%# 12×12 的「加為朋友」小圖示（文字被 text-indent:-9999px 推走）。
                          CSS 選擇器綁死 a.add-friend-btn，所以一定要是 <a> 不能是 <button>；
                          但加好友是 POST /:user/friend，GET 不該改狀態，
                          所以這顆連到對方名片頁——那一頁的 [加入好友名單] 就是那個 form。 %>
                      <a href="/<%= w2Best.uname %>/card" class="add-friend-btn" title="加為朋友">加為朋友</a>
                    </h5>
                    <p><a href="/<%= w2Best.uname %>/album/<%= w2Best.id %>" title="<%= w2Best.title %>"><%= w2Best.title %></a></p>
                  </div>
                </div>
              </li>
              <% } %>
              <% newPhotos.slice(0, 6).forEach(p => { const w2C = p.caption ? w2Cap(p.caption, 20) : p.atitle; %>
              <li class="normal normal-six">
                <a href="/<%= p.uname %>/photo/<%= p.id %>" title="<%= w2C %>">
                  <img src="<%= w2Pic(p) %>" width="156" height="96" alt="<%= w2C %>">
                </a>
                <div class="panel normal-six">
                  <div class="panel-text">
                    <h5 class="model-name">
                      <a href="/<%= p.uname %>" title="<%= p.uname %>"><%= p.uname %></a>
                      <a href="/<%= p.uname %>/card" class="add-friend-btn" title="加為朋友">加為朋友</a>
                    </h5>
                    <p><a href="/<%= p.uname %>/photo/<%= p.id %>" title="<%= w2C %>"><%= w2C %></a></p>
                  </div>
                </div>
              </li>
              <% }) %>
            </ul>
          </div>

<%# 熱門相簿的兩個分頁各有自己的一組分享連結（原版 index_20120610082113.html:384-413）。
    id 字串 featured_beauty / featured_selected 是版面識別字不是資料，照抄
    （本檔 205 行的 id="featured_selected" 早就是照抄的）。
    .tab-on 掛在**目前開著的那一頁**上——原版開的是第二頁，我們開的是第一頁，
    所以 tab-on 跟著對調。CSS：.sharing-tab{display:none}、.tab-on{display:block!important}。 %>
        <div id="wfp-featured-sharing-featured_beauty" class="sharing-tab tab-on">
<%- include('partials/wfpsharing2012', { wsSide: 'left', wsPath: '/albums', wsTitle: '人氣相簿' }) %>
</div><div id="wfp-featured-sharing-featured_selected" class="sharing-tab ">
<%- include('partials/wfpsharing2012', { wsSide: 'left', wsPath: '/albums?topic=' + encodeURIComponent('女生個人'), wsTitle: '站內分類' }) %>
</div>        </div>
        <div class="ft">
          <a id="featured-more" href="/albums" title="看更多熱門相簿">看更多熱門相簿</a>
        </div>
        <div id="featured-corner-ad"></div>
      </div>

    </div>
    <div class="side">

      <%# ⑧ 我的：未登入＝登入卡，已登入＝服務清單 %>
      <div id="wfp-my">
        <div class="wfp-my">

          <%# 背景音樂偏好開關。這不是播放器——它是站台層級的一個偏好：
              「逛別人的小站時要不要自動播對方的背景音樂」。
              原站寫 cookie mf，本專案沒有 cookie-parser，改走 session
              （src/server.js 的 GET /bgm，locals.bgmOn）。
              文案逐字照原檔 index_20120610082113.html:421-441，
              連「開啓」用異體字「啓」、tip 卻用「開啟」這個不一致都照抄。
              素材 ico_fp_musicon/off.png（12×12）已在 repo。 %>
          <div class="my-setting">
            <div id="wfp-bgm">
              <div class="tooltip">
                <p class="status"><%= bgmOn ? '背景音樂設定開啓' : '背景音樂設定關閉' %></p>
                <p class="tip"><%= bgmOn ? '點選圖示關閉' : '點選圖示開啟' %></p>
              </div>
              <a href="/bgm?on=<%= bgmOn ? 0 : 1 %>" class="<%= bgmOn ? 'bgm-on' : 'bgm-off' %>"><img src="/img/wretch2012/index/ico_fp_music<%= bgmOn ? 'on' : 'off' %>.png" alt="背景音樂"></a>
            </div>
          </div>

          <% if (me) { %>
          <div class="hd">
            <p>你好<a href="/<%= me.name %>"><%= me.nick %></a></p>
            <ul>
              <li><a href="/<%= me.name %>/settings">個人設定</a></li>
              <li class="logout"><form method="post" action="/logout" style="display:inline"><button type="submit" style="border:0;background:none;padding:0;font:inherit;color:#999;cursor:pointer">登出</button></form></li>
            </ul>
          </div>
          <div class="bd">
            <ul class="my-promotion">
              <li><a class="skin-main-link-hover" href="/<%= me.name %>">我的家</a></li>
            </ul>
            <h3 class="block-title">個人服務</h3>
            <div class="my-messages">
              <ul>
                <li class="join-vip"><a href="/<%= me.name %>/blog/new">發表文章</a></li>
                <li class="join-in"><a href="/<%= me.name %>/album">我的相簿</a></li>
              </ul>
            </div>
            <h3 class="block-title">個人設定</h3>
          </div>
          <div class="ft">
            <h2>我的<i></i></h2>
            <ul class="my-services ft-service4">
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/blog">網誌</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/album">相簿</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/guestbook">留言</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/card">名片</a></li>
              <%# 好友頁的路徑是 /:user/friends（複數）。原本寫成單數 /friend，
                  那個路徑沒有 GET route，登入之後點「好友」會拿到 404。
                  單數的 /:user/friend 是 POST（加／刪好友），不是可以瀏覽的頁。 %>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/friends">好友</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/feed">好友動態</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/visitors">誰來我家</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/settings">個人設定</a></li>
              <li><a class="skin-main-link-hover" href="/rank">排行榜</a></li>
            </ul>
            <ul class="my-services ft-service8">
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/blog">網誌</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/album">相簿</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/guestbook">留言</a></li>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/card">名片</a></li>
              <%# 好友頁的路徑是 /:user/friends（複數）。原本寫成單數 /friend，
                  那個路徑沒有 GET route，登入之後點「好友」會拿到 404。
                  單數的 /:user/friend 是 POST（加／刪好友），不是可以瀏覽的頁。 %>
              <li><a class="skin-main-link-hover" href="/<%= me.name %>/friends">好友</a></li>
