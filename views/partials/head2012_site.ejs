<%
  /* 2012 個人頁共用外框（上半）── kukubar 頂列 + #bigcontainer + 標準頁首
     ═══════════════════════════════════════════════════════════════════════
     內頁（相簿／網誌／留言板）**沒有**首頁那組 wfp 頁首頁尾，
     「頁首」就是 30px 高的 #kukubar-upper、「頁尾」是固定在視窗底部的
     #kukubar-lower（assets_src2/spec/chrome.md 第 0、5.1、5.2 節）。

     DOM 逐節點照抄這三份存檔：
       assets_src2/html/album_index_a000000jay.html   相簿列表（#banner + .sidetitle）
       assets_src2/html/album_album_list.html         單本相簿（麵包屑 + #detail）
       assets_src2/html/album_show_zh_kellyla.html    單張照片（自己另外做頁首）
     只換 href，不動結構與 class。

     樣式：呼叫端用 w2Css 指定要載哪一支 bundle
       相簿 /wretch2012-album.css（版型 skin 1/189，整頁 <table width="700">）
       網誌 /wretch2012-blog.css （版型 skin 1/117，總寬 750＝530+200+20）
     之後接網誌／留言板時只要換 w2Css 與 w2Head，這支不用改。

     ── include 參數（全部可省略）─────────────────────────────────────────
       w2Title    <title> 用的字串
       w2Css      版型 bundle 的路徑，預設 /wretch2012-album.css
       w2Service  kukubar 上「目前服務」的名字，預設 Album
       w2BodyId   <body id>，單張照片頁要 body_show（skin189 靠它切白底）
       w2Head     頁首要哪一種：
                    'list'  相簿列表  → #banner「NAME's AlbumList」＋兩個下拉＋RSS
                    'book'  單本相簿  → 麵包屑＋說明＋friendlist 下拉＋#detail
                    'none'  自己做（單張照片頁）
       w2Book     w2Head='book' 時的相簿物件（title / descr / topic / place / id）
       w2Crumb    w2Head='book' 時麵包屑最後一節要顯示的字（預設 w2Book.title）

     ── 硬性規則 ──────────────────────────────────────────────────────────
     EJS 用 with(locals)：不能宣告和 local 同名的 const（TDZ 會讓整頁 500），
     非必定存在的 local 一律走 locals.xxx，這支所有內部變數都加 w2 前綴。

     這一輪保留原版品牌：logo 用 kukubar.css 的 ico_wretch_logo_24.png，
     站名文字寫「無名小站」（WRETCH_2012.md 第 4 節第 1 條）。

     收尾在 partials/foot2012_site.ejs（關 #bigcontainer / #hugewrapper、
     人氣頁尾、kukubar 底列）。 */

  // 版型：跟站主在設定裡選的走（src/skins.js）。呼叫端仍可用 w2Css 明確指定。
  const w2Css     = locals.w2Css || (locals.skinCss ? skinCss('album') : '/wretch2012-album.css');
  const w2Service = locals.w2Service || 'Album';
  const w2Svc     = w2Service.toLowerCase();          // ul.dropdown 的 <svc>-service
  const w2BodyId  = locals.w2BodyId  || '';
  const w2Head    = locals.w2Head    || 'none';
  const w2Book    = locals.w2Book    || null;
  const w2Me      = locals.me || null;
  const w2Owner   = locals.u  || null;
  /* 「- Friends' Album -」下拉：原站是 MeetFriend() 讀好友清單。
     內頁 route 沒有好友這份 local，能湊的只有 home/friends 兩頁才有的 friends，
     所以這裡容許沒有——沒有就只印那一個 optgroup 標題行（原站也是這樣）。 */
  const w2Friends = locals.friends || [];
%><!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="imagetoolbar" content="no">
<title><%= locals.w2Title || (w2Owner ? w2Owner.nick : SITE_NAME) %></title>
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
<%# 版型 bundle（原站原檔，只改素材路徑）→ 本站刻意偏離層 → 使用者自訂 CSS %>
<link rel="stylesheet" href="<%= w2Css %>" type="text/css">
<link rel="stylesheet" href="/wretch2012-album-in.css" type="text/css">
<% if (w2Owner && w2Owner.css) { %><style><%- safeCss(w2Owner.css) %></style><% } %>
</head>
<%# 無名相簿頁關掉右鍵／拖曳／選取，逐字照抄存檔的 <body> 屬性 %>
<body<% if (w2BodyId) { %> id="<%= w2BodyId %>"<% } %> onDragStart="return false" oncontextmenu="return false" onSelectStart="return false">
<!-- nv hugewrepper -->
<div id="hugewrapper">
<%# 原站這裡還有 input#wretch-crumb（Yahoo 的 CSRF token）。本站沒有那套 token，
    偽造一個沒有意義，所以只留 #static-path（kukubar.js 拿它組素材網址）。 %>
<input id="static-path" type="hidden" value="/img/wretch2012/">
<style>
.kukubar-customized {
    background:#EEEDDD; /* old browsers */
    background: -moz-linear-gradient(top, #FFFFFF 0%, #EEEDDD 100%); /* firefox */
    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#FFFFFF), color-stop(100%,#EEEDDD)); /* webkit */

}
</style>
<div id="kukubar-upper" class="font-black kukubar-customized kukubar-bar">
    <div class="left-side">
        <div id="wretch-logo" class="bar-block bar-block-click">
        <h1><a class="bar-link" tabindex="1" href="/">無名小站</a></h1>
        </div>
        <div id="wretch-service" class="bar-block bar-block-click">
            <a class="current-service bar-link theme" tabindex="2" href="/albums"><%= w2Service %></a>
            <span class="bar-block-btn" tabindex="3">展開</span>
            <ul class="dropdown <%= w2Svc %>-service">
                <li class="album-index"><a class="bar-link" href="/albums">Album</a></li>
                <li class="blog-index"><a class="bar-link" href="/blogs">Blog</a></li>
                <li class="video-index"><a class="bar-link" href="/help">Video</a></li>
                <li class="digu-index"><a class="bar-link" href="/help">Digu</a></li>
                <li class="join-index"><a class="bar-link" href="/help">Join</a></li>
                <li><a class="bar-link" href="/">Yahoo!</a></li>
                <li><a class="bar-link" href="/help">Help</a></li>
                <li><a class="bar-link" href="/help">Premium</a></li>
            </ul>
        </div>
        <%# #infozone 原站放編輯部挑的「今日主題」。內頁 route 沒有這份 local，
            用手邊的站主暱稱湊一行，前綴保留原站的「今日主題：」。 %>
        <div id="infozone">
             <ul>
                <li><a href="/albums" class="theme">今日主題：逛逛大家的相簿</a></li>
             </ul>
        </div>
    </div>


    <div class="right-side">
        <div id="wretch-search" class="bar-block">
            <%# 站內搜尋：src/server.js 的 app.get('/search') 只讀 q，所以輸入框 name 是 q。
                三顆 radio（name=type）是原站的服務切換，後端沒有這個參數、會被忽略，
                但 .service-list 與 legend 的版面要靠它們，照原樣留著。 %>
            <form method="get" action="/search" name="searchForm">
                            <fieldset>
                    <legend><%= w2Service %><span>選擇服務</span></legend>
                    <div class="service-list dropdown">
                        <input type="radio" id="srch-blog" name="type" value="article" data="false">
                        <label for="srch-blog" _target="Article Search">Article</label>
                        <input type="radio" id="srch-album" name="type" value="photo" checked="checked" data="checked">
                        <label for="srch-album" _target="Album Search">Album</label>
                        <input type="radio" id="srch-video" name="type" value="video" data="false">
                        <label for="srch-video" _target="Video Search">Video</label>
                    </div>
                    <div class="search-field">
                        <label for="wretch-search-text" class="hidden">搜尋</label>
                        <input id="wretch-search-text" type="text" name="q" title="Album Search" value="" class="blur">
                        <input id="wretch-search-btn" type="submit" value="送出">
                    </div>
                </fieldset>
            </form>
        </div>
        <% if (w2Me) { %>
        <%# 登入後的節點原站沒有存檔，chrome.md 第 5.3 節是由 CSS/JS 選擇器反推的【推】 %>
        <div id="wretch-login" class="bar-block bar-block-click bar-link">
            <span class="theme"><%= w2Me.nick %></span>
            <span class="bar-block-btn-login" tabindex="4">展開</span>
            <ul class="dropdown">
                <li><a class="bar-link" href="/<%= w2Me.name %>">我的小站</a></li>
                <li><a class="bar-link" href="/<%= w2Me.name %>/album">我的相簿</a></li>
                <li><a class="bar-link" href="/<%= w2Me.name %>/settings">個人設定</a></li>
                <li><a class="bar-link" href="/<%= w2Me.name %>/favs">我的收藏</a></li>
                <% if (w2Me.admin) { %><li><a class="bar-link" href="/admin">後台</a></li><% } %>
                <li><form method="post" action="/logout"><button class="bar-link w2a-linkbtn">登出</button></form></li>
            </ul>
        </div>
        <% } else { %>
        <div id="wretch-login" class="bar-block bar-block-click bar-link no-hover">
                            <ul class="login-links">
                <li class="link-item first"><a class="bar-link theme" href="/login">Login</a></li>
                <li class="link-item"><a class="bar-link theme" href="/register">Register</a></li>
            </ul>
                        </div>
        <% } %>
        <div id="cam">
        <a class="theme" href="/">Yahoo!</a>
        </div>
    </div>
</div>
<div id="bigcontainer" style="position: relative !important; zoom:1 !important;" >
<% if (flash) { %><div class="w2a-flash"><%= flash %></div><% } %>
<% if (w2Head !== 'none' && w2Owner) { %>

<!-- banner part -->
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center">
  <tr>
    <td>
      <div id="banner">
        <% if (w2Head === 'list') { %>
        <a href="/<%= w2Owner.name %>/album"><%= w2Owner.name %>'s AlbumList</a>
        <% } else { %>
        <a href="/<%= w2Owner.name %>/album"><font style="text-decoration: underline;" class="normal-a"><%= w2Owner.name %>'s Album</font></a>
        <font class="normal-a">&gt; <%= locals.w2Crumb || (w2Book ? w2Book.title : '') %></font>
          <% if (w2Book && w2Book.descr) { %>
        <div class="description">
          <p><%= w2Book.descr %></p>
        </div>
          <% } %>
        <% } %>
      </div>
    </td>
  </tr>

  <tr>
    <td class="sidetitle">

  <%# 導覽鈕列：DOM 與 id 逐字照抄存檔（MyPage / album / blog / guestbook /
      User / Friend / Video）。本站沒有影音服務，Video 指到服務說明。 %>
  <div class="small-c" id="MySpace">
    <span>[ <%= w2Owner.name %> 的</span>
    <a id="linkMypage" href="/<%= w2Owner.name %>">MyPage</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkAlbum" href="/<%= w2Owner.name %>/album">album</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkBlog" href="/<%= w2Owner.name %>/blog">blog</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkGbook" href="/<%= w2Owner.name %>/guestbook">guestbook</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkUser" href="/<%= w2Owner.name %>/card">User</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkFriend" href="/<%= w2Owner.name %>/friends">Friend</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a id="linkVideo" href="/help">Video</a>
    <span>]</span>
  </div>
  <span class="small-c">
    <%# 原站的 onChange="MeetFriend('/album/', this)" 是一支外部 JS，
        本站直接在 foot2012_site.ejs 那段 JS 裡做同一件事（跳到 /帳號/album）。 %>
    <select id="friendlist" name="friendlist" data-user-go="/album">
  <option>- Friends' Album -</option>
<% if (w2Friends.length) { %>
        <optgroup label="好友">
<% w2Friends.forEach(f => { %>          <option value="<%= f.name %>"><%= f.name %><% if (f.nick && f.nick !== f.name) { %>(<%= f.nick %>)<% } %></option>
<% }) %>        </optgroup>
<% } %>    </select>
<% if (w2Head === 'list') { %>
    <%# 「- Category -」原站是相簿主人自己開的個人分類（?cid=N）。
        本站的 albums 表沒有個人分類欄位，也不能改 src/，所以拿站內分類
        （ALBUM_TOPICS，route 已經給了 topics 這個 local）湊：
        選了就跳到相簿總站的同一個分類。這條列在回報的「湊資料」清單裡。 %>
    <select id="category" name="category" data-url-go="/albums?topic=">
      <option value=''>- Category -</option>
      <option value=''>- All -</option>
<% (locals.topics || []).forEach(t => { %>      <option value="<%= t %>"><%= t %></option>
<% }) %>    </select>
<% } %>
  </span>
<% if (w2Head === 'list') { %>
        <div id="rss" class="small-c" align="right">
          <div class="syndicate">
            <a href="/<%= w2Owner.name %>/blog/rss"><img border="0" src="/img/wretch2012/blog/rss.gif" alt="" /></a>
      (<a target="_blank" href="/help#rss">RSS HOWTO</a>)
          </div>
        </div>
<% } else { %>
        <div id="detail" class="small-c" align="right">
    Topic: <% if (w2Book && w2Book.topic) { %><a href="/albums?topic=<%= encodeURIComponent(w2Book.topic) %>"><%= w2Book.topic %></a><% } else { %>None<% } %>
    &nbsp;
    Place: <% if (w2Book && w2Book.place) { %><a href="/albums?place=<%= encodeURIComponent(w2Book.place) %>"><%= w2Book.place %></a><% } else { %>None<% } %>
    &nbsp;
    Category: <% if (w2Book && w2Book.friends_only) { %>好友限定<% } else if (w2Book && w2Book.pass) { %>密碼相簿<% } else { %>None<% } %>
    <br>
    <% if (w2Book) { %>[<a class='small-c' href="/<%= w2Owner.name %>/album/<%= w2Book.id %>?all=1">One Page</a>]<% } %>
    <% if (w2Me && !isOwner) { %>[<form method="post" action="/<%= w2Owner.name %>/friend" style="display:inline"><button class="small-c w2a-linkbtn"><%= isFriend ? 'Remove from Friend List' : 'Add to Friend List' %></button></form>]<% } %>
    </div>
<% } %>
    </td>
  </tr>
</table>
<!-- end of banner part -->
<% } %>
