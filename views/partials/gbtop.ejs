<%# 個人頁（留言板家族）外框的上半段 — 留言板版型 skin 1/1911，總寬 958px
    ─────────────────────────────────────────────────────────────
    骨架逐字照 assets_src2/html/gb_guestbook_a000000010_20131226.html：

      #container > #header（h1 + #description）
                 > #main > #content（ul#main_tab + a.message + #mainSection）
                         > #sidebar        ← partials/side.ejs，由 gbfoot 收尾
                 > #footer

    尺寸來自版型：#container 958 ＝ #content 612 ＋ #sidebar 330 ＋ #main 左右各 8。
    #main_tab 是 position:absolute，靠 a.message（message.gif 120×39，高 55px）
    撐出頁籤那條帶子——所以 a.message 一定要緊接在 ul#main_tab 後面，
    不放的話要改放同高的 .w2-tabband 空帶，不然頁籤會壓到內容上。

    #ad_gbook（728×90，#container 的第一個子節點）：版位照原版做，
    裡面換成本站自己的內容（站方公告／站內入口）。gb_overwrite.css 用
    !important 把它撐成固定 90px，不做就是版面中間缺一塊、做空殼就是一個洞，
    所以放我們真的有的東西。細節見 partials/adslot2012.ejs。

    呼叫端可傳：
      head       h1 文字（預設「暱稱 的小站」）
      here       目前在哪一頁：home / visitors / favs / feed / settings
                 （用來決定預設頁籤哪一個是 .hover；留言板自己傳 tabs 蓋掉）
      tabs       自訂頁籤 [{href,label,on}]
      noMessage  不要「我要留言」那顆按鈕，改放空帶 %>
<%
  const gbTabs = locals.tabs || [
    { href: '/' + u.name,             label: 'MyPage',   on: locals.here === 'home' },
    { href: '/' + u.name + '/visitors', label: '誰來我家', on: locals.here === 'visitors' },
    { href: '/' + u.name + '/favs',     label: '我的收藏', on: locals.here === 'favs' },
    ...(isOwner ? [
      { href: '/' + u.name + '/feed',     label: '好友動態', on: locals.here === 'feed' },
      /* 個人網頁空間。原站是付費會員才有的一塊檔案空間，現在免費期人人都有。
         放在這一排是因為它跟收藏、好友動態一樣是「站主自己的東西」。 */
      { href: '/' + u.name + '/files',    label: '網頁空間', on: locals.here === 'files' },
      { href: '/' + u.name + '/settings', label: '個人設定', on: locals.here === 'settings' },
    ] : []),
  ];
%>
<div id="container">
<%- include('adslot2012', {
      adId: 'ad_gbook',
      adNotices: locals.notices || (locals.siteNotice ? [locals.siteNotice] : []),
      adTopics: locals.blogTopics || locals.topics || [] }) %>

  <div id="header">
    <h1><a href="/<%= u.name %>"><%= locals.head || (u.nick + ' 的小站') %></a></h1>
    <div id="description"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : '' %></div>
  </div>

  <div id="main">
    <div id="content">

      <ul id="main_tab">
        <%# 原版留言板那兩個頁籤帶 id（tab_normal／tab_bulletin，
            gb_guestbook_a000000010_20131226.html:9262）；其餘頁的頁籤沒有 id，
            所以 t.id 是選填，沒給就不輸出 id 屬性。 %>
        <% gbTabs.forEach(function(t){ %><li<% if (t.id) { %> id="<%= t.id %>"<% } %> class="<%= t.on ? 'hover' : '' %>"><a href="<%= t.href %>"><%= t.label %></a></li><% }) %>
      </ul>
      <% if (locals.noMessage) { %><span class="w2-tabband"></span><% } else { %>
      <a class="message" href="/<%= u.name %>/guestbook?tab=new">我要留言...</a>
      <% } %>

      <div id="mainSection">
