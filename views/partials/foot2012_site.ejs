<%
  /* 2012 個人頁共用外框（下半）── 人氣頁尾 + kukubar 底列
     ═══════════════════════════════════════════════════════════════════════
     收掉 partials/head2012_site.ejs 開的 #bigcontainer 與 #hugewrapper，
     然後印出：
       1. 人氣頁尾（Today's Visitors / Total Visitors）
          逐字照抄 assets_src2/html/album_index_a000000jay.html 最後一列：
            <tr><td align="right"><font class="small-c">
              <a>Today's Visitors: 2</a><br /><a>Total Visitors: 22386</a>
            </font></td></tr>
          原站那一列是「內容表格」的最後一列；本站的內容表格由各頁自己開關，
          所以這裡另外開一張同寬同色（skin189 的 table{background:#fff}）的
          700px 表格。畫面上看不出差別，但 DOM 多一層 <table>，記在回報裡。
       2. #kukubar-lower + #footer-switch（chrome.md 第 5.2 節逐節點）
       3. 兩段 JS：kukubar 展開／收合、下拉選單跳頁、社群分享網址補 origin

     include 參數：
       w2Hits     false 就不印人氣頁尾（幻燈片、密碼頁用不到）
       w2Service  kukubar 底列不需要，但留著和 head 對稱

     EJS 用 with(locals)：內部變數一律加 w2 前綴，避免和 local 撞名（TDZ）。 */
  const w2Owner = locals.u || null;
  const w2Me    = locals.me || null;
  const w2Hits  = locals.w2Hits !== false && !!w2Owner;
  const w2Today = new Date().toLocaleDateString('sv-SE');
  /* #text-carousel 原站是編輯部挑的全站好文。內頁 route 沒有這份 local，
     只有相簿列表頁手邊有 albums，就拿它湊；其他頁印原站那句的替代版本。
     前綴保留原站的「首頁好文：」。這條列在回報的「湊資料」清單裡。 */
  const w2Roll  = (locals.albums || []).slice(0, 6);
  /* 這一支同時收三種頁，靠手邊的 local 分辨（head 那邊的 w2Head 傳不進來）：
       單張照片 有 p ／ 單本相簿 有 album+photos ／ 相簿列表 有 albums
     只有相簿列表有 bottom part 的 td#ad_button，rapid 欄位組合也三頁不同。 */
  const w2Kind = locals.p ? 'photo'
               : (locals.album && locals.photos) ? 'book'
               : locals.albums ? 'list' : '';
  /* 隱藏 metadata（原站的 RAPID 標記）：值全部換成本站自己的，
     ov_status 沿用原站的組合碼寫法（登入狀態_是否認證帳號）。 */
  const w2Ov = (w2Me ? 'log' : 'unlog') + '_' + (w2Owner && w2Owner.vip ? 'VPO' : 'NPO');
  const w2Meta = w2Kind === 'book' ? {
        wid: w2Owner ? w2Owner.name : '', vip_status: (w2Owner && w2Owner.vip) || 0,
        cat: (locals.album && album.topic) || 'None', privacy: locals.album && album.pass ? 1 : (locals.album && album.friends_only ? 2 : 0),
        album: 'i=' + (w2Owner ? w2Owner.name : '') + '&b=' + (locals.album ? album.id : ''),
        location: (locals.album && album.place) || 'None', ov_status: w2Ov }
      : w2Kind === 'list' ? {
        wid: w2Owner ? w2Owner.name : '', vip_status: (w2Owner && w2Owner.vip) || 0,
        privacy: 0, ov_status: w2Ov }
      : null;
%>
<% if (w2Hits) { %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center">
<tr>
<td align="right">
    <font class="small-c">
    <a>Today's Visitors: <%= w2Owner.hits_date === w2Today ? (w2Owner.today_hits || 0) : 0 %></a>
    <br />
    <a>Total Visitors: <%= w2Owner.visits %></a>
  </font>
</td>
</tr>
</table>
<% } %>
<% if (w2Kind === 'list') { %>
<!-- bottom part -->
<%# 原版 album_index_a000000jay.html:779-793：人氣頁尾之後一張 700px 表格，
    裡面只有 td#ad_button。版位照做，內容換成本站自己的入口。 %>
<table width="700" border="0" cellpadding="0" cellspacing="0" align="center">
  <tr>
<%- include('adslot2012', { adId: 'ad_button', adTag: 'td' }) %>
  </tr>
</table>
<!-- end of bottom part -->
<% } %>

</div><!-- /#bigcontainer -->
</div>
<!-- nv hugewrepper -->
<div id="kukubar-lower" class="kukubar-bar  ">
<% if (!w2Me) { %>
    <div class="login-request dropdown">
        <div class="login-btn">
            <a class="footer-ok-btn" href="/login">登入</a>
        </div>
        <div class="login-msg login-msg-subscription">
            登入無名小站瀏覽分類好文
        </div>
    </div>
<% } %>
        <div class="left-side">
        <div id="footer-feedback" class="bar-block">
            <a class="" href="/help" target="_blank">我有建議</a>
        </div>
        <div id="footer-subscription" class="bar-block bar-block-click">
            <a class="footer-subscription-btn" href="#">分類好文<span class="bar-block-btn" tabindex="0" role="button" aria-expanded="false">展開</span></a>
                <div id="scrb-panel" class="dropdown ">
                <div class="hd panel-block">
                    <div class="heading"><h5>請選擇你有興趣的分類</h5></div>
                    <%# 原站是 AJAX 拉訂閱清單；本站沒有那個端點，
                        直接把相簿站內分類印出來，點了就到 /albums?topic= %>
                    <ul>
<% (locals.topics || []).forEach(t => { %>                        <li><a href="/albums?topic=<%= encodeURIComponent(t) %>"><%= t %></a></li>
<% }) %>                    </ul>
                </div>
                <div class="bd panel-block">
                </div>
            </div>
        </div>
    </div>
    <div class="right-side">
                <div id="text-carousel">
            <ul>
<% w2Roll.forEach(r => { %>                <li><a href="/<%= r.uname || (w2Owner ? w2Owner.name : '') %>/album/<%= r.id %>">首頁好文：<%= r.title %></a></li>
<% }) %><% if (!w2Roll.length) { %>                <li><a href="/albums">首頁好文：逛逛大家的相簿</a></li>
<% } %>            </ul>
        </div>
                <ul id="footer-ugc-compose">
            <li class="bar-block bar-block-click blog-service"><em>網誌</em>
                <ul class="dropdown">
                    <li><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/blog/new' : '/login' %>">Post Article</a></li>
                    <li><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/settings' : '/login' %>">Blog Style</a></li>
                    <li class="last"><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/settings' : '/login' %>">Blog Setting</a></li>
                </ul>
            </li>
            <li class="bar-block bar-block-click album-service"><em>相簿</em>
                <ul class="dropdown">
                    <li><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/album' : '/login' %>">Upload Photo</a></li>
                    <li><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/settings' : '/login' %>">Album Style</a></li>
                    <li class="last"><a class="bar-link" href="<%= w2Me ? '/' + w2Me.name + '/album' : '/login' %>">Album Setting</a></li>
                </ul>
            </li>
            <li class="bar-block bar-block-click video-service"><em>影音</em>
                <ul class="dropdown">
                    <li><a class="bar-link" href="/help">Upload Video</a></li>
                    <li><a class="bar-link" href="/help">Video Style</a></li>
                    <li class="last"><a class="bar-link" href="/help">Video Setting</a></li>
                </ul>
            </li>
        </ul>
    </div>
</div>
<div id="footer-switch" class=" ">
<button>關閉工具列</button>
</div>
<script>
/* kukubar 的互動：原站是 YUI3 寫的 kukubar.js（assets_src2/css/chrome_kukubar.js），
   這裡只重做「展開／收合」與「關閉工具列」兩件事，class 名稱與原站一致，
   所以 chrome_kukubar.css 的 .expanded / .expanded-btn / .hidden-footer 規則直接生效。 */
(function(){
  function panelOf(block){ return block.querySelector('ul.dropdown, div.dropdown'); }
  function close(block){
    block.classList.remove('expanded-btn');
    var p = panelOf(block); if (p) p.classList.remove('expanded');
  }
  function allBlocks(){
    return document.querySelectorAll('#kukubar-upper .bar-block-click, #kukubar-lower .bar-block-click');
  }
  document.addEventListener('click', function(e){
    var block = e.target.closest('#kukubar-upper .bar-block-click, #kukubar-lower .bar-block-click');
    /* 點在下拉選單「裡面」的連結不切換，讓它正常跳頁 */
    if (block && e.target.closest('.dropdown') && e.target.closest('a,button')) return;
    allBlocks().forEach(function(b){ if (b !== block) close(b); });
    if (!block) return;
    var p = panelOf(block); if (!p) return;
    if (e.target.closest('a') && !e.target.closest('.bar-block-btn, .bar-block-btn-login, .footer-subscription-btn')) return;
    e.preventDefault();
    var on = block.classList.toggle('expanded-btn');
    p.classList.toggle('expanded', on);
  });
  var sw = document.getElementById('footer-switch');
  if (sw) sw.addEventListener('click', function(){
    var bar = document.getElementById('kukubar-lower');
    var off = bar.classList.toggle('hidden-footer');
    sw.classList.toggle('off', off);
  });

  /* 頁首那兩個下拉：原站是 meetfriend.js 的 MeetFriend() 與一行 inline onChange。
     data-user-go="/album"      → 跳 /<選到的帳號>/album
     data-url-go="/albums?topic=" → 跳 /albums?topic=<選到的值> */
  document.addEventListener('change', function(e){
    var s = e.target;
    if (!s || s.tagName !== 'SELECT') return;
    var v = s.value; if (!v) return;
    var u = s.getAttribute('data-user-go');
    if (u) { location.href = '/' + encodeURIComponent(v) + u; return; }
    var q = s.getAttribute('data-url-go');
    if (q) { location.href = q + encodeURIComponent(v); }
  });

  /* 社群分享列：分享網址要「絕對網址」。href 在伺服器端就已經組好了
     （socialshare2012.ejs 用 res.locals.origin），沒有 JS 也分享得出去；
     這裡只是拿 location.origin 再覆寫一次。
     只有還活著的服務才接：fb / plurk / tw(X)。
     Yahoo 即時通（.yim）與 Google+ 已停止服務，DOM 照留但不連外。 */
  document.querySelectorAll('a[data-share]').forEach(function(a){
    var url = location.origin + a.getAttribute('data-path');
    var t   = a.getAttribute('data-title') || document.title;
    var k   = a.getAttribute('data-share');
    if (k === 'fb')    a.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);
    if (k === 'plurk') a.href = 'https://www.plurk.com/?qualifier=shares&status=' + encodeURIComponent(url + ' (' + t + ')');
    if (k === 'tw')    a.href = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(t);
  });

  /* 鍵盤：Enter／Space 等同點擊。
     那幾顆「展開」是 <span role="button">，瀏覽器不會幫 span 把 Enter 轉成
     click（只有 <button> 與 <a href> 有這個待遇），所以自己轉。
     不轉的話，用鍵盤的人 Tab 到那一顆按下去完全沒反應，底下整個選單
     （我的小站／我的相簿／個人設定／登出）永遠打不開。 */
  document.addEventListener('keydown', function(e){
    var t = e.target;
    if (!t || t.getAttribute('role') !== 'button') return;
    if (e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
    e.preventDefault();
    t.click();
  });

  /* 選單開合時同步 aria-expanded，讀螢幕軟體才唸得出「已展開／已收合」。
     用 MutationObserver 盯 class 的變化，就不必去改上面那段開合邏輯。 */
  (function(){
    var blocks = document.querySelectorAll('.bar-block-click');
    if (!blocks.length || typeof MutationObserver === 'undefined') return;
    var mo = new MutationObserver(function(rs){
      rs.forEach(function(r){
        var b = r.target, btn = b.querySelector('[role="button"]');
        if (btn) btn.setAttribute('aria-expanded', b.classList.contains('expanded-btn') ? 'true' : 'false');
      });
    });
    blocks.forEach(function(b){ mo.observe(b, { attributes: true, attributeFilter: ['class'] }); });
  })();
})();
</script>
<%- include('pagemeta2012', { pm: w2Meta || {} }) %>
</body>
</html>
