<%
  // 保留目前的篩選條件（分類／月份／站內分類／地區）
  const qp = [];
  if (typeof cat  !== 'undefined' && cat)   qp.push('cat='  + encodeURIComponent(cat));
  if (typeof ym   !== 'undefined' && ym)    qp.push('ym='   + encodeURIComponent(ym));
  if (typeof topic!== 'undefined' && topic) qp.push('topic='+ encodeURIComponent(topic));
  if (typeof place!== 'undefined' && place) qp.push('place='+ encodeURIComponent(place));
  const q = qp.length ? '&' + qp.join('&') : '';
%>
<% if (pages>1) { %><div class="pager">
<% if(page>1){ %><a href="?p=<%= page-1 %><%= q %>">上一頁</a><% } %>
<% for(let i=1;i<=pages;i++){ %><% if(i===page){ %><b>[<%= i %>]</b><% } else { %><a href="?p=<%= i %><%= q %>"><%= i %></a><% } %> <% } %>
<% if(page<pages){ %><a href="?p=<%= page+1 %><%= q %>">下一頁</a><% } %>
</div><% } %>
