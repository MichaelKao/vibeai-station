<%
  /* 無名小站 2012 最後版 — 網誌內頁外框（上半段）
     ─────────────────────────────────────────────────────────────
     骨架逐節點照抄 assets_src2/html/blog_2012_default_skin_afuuu.html
     （＝套用官方預設版型 skin 1/117 的網誌首頁），規格見
     assets_src2/spec/blog.md 第 8-0 / 8-1 節與 assets_src2/spec/skin.md 第三節。

       body#blog_main.yui-skin-sam
       └ #hugewrapper
         ├ #wretch-crumb / #static-path（hidden）
         ├ #kukubar-upper                       ← partials/kukubar2012.ejs
         └ #bigcontainer
           └ #container1 (750px)
             └ #container2
               ├ #banner > #pageheader > h1 + #description2
               └ #main2                         ← 由呼叫端塞 #content 與 #links
     收尾在 partials/blog2012_foot.ejs。

     樣式：public/wretch2012-blog.css（原站原始 CSS，只改素材路徑；
     串接順序 top.css → 版型 skin117 → sharing → font → trackback → kukubar，
     見 tools/build-css2012.mjs）。本站刻意偏離的部分另外兩支：
       wretch2012-chrome-site.css（工具列的表單化按鈕）
       wretch2012-blog-site.css  （原站沒有存檔的頁面：發文、檢舉、站長工具…）
     使用者自訂 CSS 一定放最後才蓋得過版型——這就是無名的「換造型」。

     可傳入的 include 參數：
       title    完整的 <title>（呼叫端自己組好）
       artTitle h1 裡 span.description 的字（文章頁放文章標題，列表頁留空）
       medium   <meta name="medium">：文章頁 "blog"，其餘空字串

     EJS 用 with(locals)，不能宣告和 local 同名的 const；
     非必定存在的 local 一律走 locals.xxx。 */
  const bhIntro = (u && u.intro) ? u.intro.split('\n')[0].slice(0, 200) : '';
  /* #wretch-crumb：原站是 Yahoo 的 CSRF token。本站靠 cookie 的 SameSite=lax，
     沒有那套 token，所以自己發一組同格式的（**只輸出、不驗證**）；
     後端把真正的 session token 放進 res.locals.crumb 之後這裡自動改用它。
     以前這裡是空字串，值換成我們自己的才和另外兩支外框一致。 */
  const bhCrumb = locals.crumb ||
    ('&.c=' + (locals.me ? 'u' + me.id : 'g') + Math.random().toString(36).slice(2, 12)
     + '&.t=' + Math.floor(Date.now() / 1000));
%><!DOCTYPE html>
<html lang="zh-Hant">
<head>
<%# 原站沒有這一行（2012 年還沒人在管手機）。沒有它的話手機瀏覽器會用
    980px 的虛擬視窗寬度來排版，wretch2012-rwd.css 的媒體查詢永遠不會觸發，
    使用者看到的就是被縮到很小的桌機版。這是刻意加的，桌機不受影響。 %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<meta http-equiv="imagetoolbar" content="no"/>
<meta name="description" content="<%= bhIntro %>" />
<meta name="medium" content="<%= locals.medium || '' %>" />
<title><%= locals.title %></title>
<link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
<meta property="og:type" content="<%= locals.medium === 'blog' ? 'article' : 'blog' %>" />
<meta property="og:title" content="<%= locals.title %>" />
<meta property="og:site_name" content="無名小站網誌" />
<link rel="alternate" type="application/rss+xml" title="RSS" href="/<%= u.name %>/blog/rss" />
<link rel="stylesheet" href="/wretch2012-blog.css" type="text/css" />
<link rel="stylesheet" href="/wretch2012-chrome-site.css" type="text/css" />
<link rel="stylesheet" href="/wretch2012-blog-site.css" type="text/css" />
<%# 使用者自訂 CSS 一定放最後，才蓋得過版型——這是無名的靈魂功能 %>
<%# 響應式圖層。原站沒有 RWD（2012 是 970px 固定寬），這是刻意加的，
    整支包在 @media (max-width:999px) 裡，桌機寬度一條都不生效。
    **一定要放在所有版型與偏離層之後**才蓋得過那些寫死的 px 寬度，
    但要放在使用者自訂 CSS 之前——自訂 CSS 依契約 §4-5 永遠是最後一個。 %>
<link rel="stylesheet" href="/wretch2012-rwd.css">
<%# 網誌吃 css_blog、相簿與其餘頁面吃 css——原站就是兩份
    （f10.wretch.yimg.com/<帳號>/files/album.css 與 blog.css，WRETCH_SPEC.md §6）。
    還沒填過 css_blog 的人退回 css，不然舊使用者的自訂樣式會突然消失。 %>
<% const w2UserCss = (u && (u.css_blog || u.css)) || ''; %>
<% if (w2UserCss) { %><style><%- safeCss(w2UserCss) %></style><% } %>
</head>
<%# body 上那三個 return false 是原站防右鍵／防拖曳／防選取的設定，照抄 %>
<body id="blog_main" onDragStart="return false" onContextmenu="return false" onSelectStart="return false" class="yui-skin-sam">
<!-- nv hugewrepper --><div id="hugewrapper"><input id="wretch-crumb" type="hidden" value="<%= bhCrumb %>">
<%# #static-path 是「素材根」（原站 l.yimg.com/e/serv/common/），不是服務層路徑。
    以前這裡寫成 /img/wretch2012/blog/，語意不對，改成和另外兩支一樣的 CDN。 %>
<input id="static-path" type="hidden" value="<%= CDN %>">
<%- include('kukubar2012', { kkService: 'blog' }) %>
<div id="bigcontainer" style="position: relative !important; zoom:1 !important;" >
<div id="container1">
<div id="container2">

  <div id="banner">
  <div id="pageheader">
    <h1>
      <a href="/<%= u.name %>/blog"><%= u.nick %></a>
      <span class="description">
        <%= locals.artTitle || '' %>      </span>
    </h1>

    <div id="description2">
      <span class="description">
        <%= locals.medium === 'blog' ? '' : bhIntro %>      </span>
    </div>
  </div>
</div>

<%# 原站沒有 flash 這種東西（它用整頁跳轉的提示頁），本站沿用既有機制，
    版面上放在 banner 與 #main2 之間，樣式在 wretch2012-blog-site.css %>
<% if (flash) { %><div class="w2b-flash"><%= flash %></div><% } %>

<div id="main2">
