<%
  /* 每篇文章的社群分享列 —— 這支現在只是 partials/socialshare2012.ejs 的轉接頭
     ─────────────────────────────────────────────────────────────
     為什麼不直接刪掉：views/blog.ejs 與 views/post.ejs 已經在用
     `include('partials/blogshare', {shPost, shOwner, shTb, shCan})` 這組參數，
     那兩支是別人的檔案。把 DOM 搬進共用 partial、這裡只轉參數，
     兩邊都不用改就吃得到「三份分享列合一」。
     新的呼叫請直接用 socialshare2012（參數與說明看那支的檔頭）。

     參數對應：
       shPost  → ssPath / ssTitle       shTb → ssTb
       shOwner → ssPath 的帳號段         shCan → 能不能轉貼（決定用 form 還是 <a>）

     「發文」在原站是把文章轉貼到自己的網誌。本站對應
     POST /:owner/blog/:id/trackback（src/server.js 的 site.post），
     不能轉貼時退回原站那顆 <a>，指向登入或發文頁。
     「找知識」是網誌專屬那一格，接本站的 /search。 */
  const shPath = '/' + shOwner + '/blog/' + shPost.id;
%><%- include('socialshare2012', {
      ssPath:  shPath,
      ssTitle: shPost.title,
      ssTb:    locals.shTb,
      ssKplizer: true,
      ssReblog: shCan ? { action: shPath + '/trackback' }
                      : { href: me ? '/' + me.name + '/blog/new' : '/login' } }) %>
