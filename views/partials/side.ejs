<%# 個人小站的側欄 = 留言板版型 skin 1/1911 的 #sidebar（寬 330px）
    ─────────────────────────────────────────────────────────────
    骨架逐字照 assets_src2/html/gb_guestbook_a000000010_20131226.html：

      #sidebar > ul > li#mine   > #namecard（#myImg / #myName / #myInfo / ul#myService）
                     > li#action.box       加好友 ｜ 我要留言 ｜ RSS
                     > li#friendlist.box   好友的留言板（下拉）
                     > li.box × N          誰來我家 ／ 好友連結 ／ 音樂盒
                     > li#stats.box        人氣

    必須放在 #main 裡、#content 之後——overwrite.css 的名片修正是
    `div#main div#sidebar ul li#mine div#namecard`，位置不對就不生效。

    li#ad_lrec（300×250）照原版做在 #friendlist 與 #stats 之間，
    內容換成本站自己的（站方公告／站內入口），見 partials/adslot2012.ejs。

    呼叫端可傳 visitors / friends；沒傳（例如留言板頁的 route 就沒送這兩份資料）
    或傳 null 就不顯示那一格。sideAvatar 已經不需要了：名片小卡本來就永遠有頭像。 %>
<%
  /* 嘀咕（原站的一句話動態）本站另一位 agent 正在做，網址約定 /:user/digu。
     原版 #namecard 是二選一：有嘀咕印 .myDigu、沒有印 .myDesc
     （兩個框都是 123×68，同時印會把 #myService 擠出可視區）。
     自我介紹在 gbtop.ejs 的 #description 已經有一份，這裡不會漏掉資訊。 */
  const sdDigu = locals.digu || null;
%>
<div id="sidebar">
<ul>

  <li id="mine">
    <div id="namecard">
      <div id="myImg">
        <a href="/<%= u.name %>"><span></span><img src="<%= u.avatar %>" alt="<%= u.nick %>"></a>
      </div>
      <div id="myName">
        <a class="myId" href="/<%= u.name %>/card"><%= u.name %></a>
      </div>
      <div id="myInfo">
        <p class="myNick"><%= u.nick %></p>
        <p class="myDigu"><span class="digu"><a href="/<%= u.name %>/digu"><%= sdDigu ? sdDigu.body : '還沒有嘀咕' %></a></span><span class="digu_date"><%= sdDigu ? sdDigu.created.slice(5,16) : '' %></span></p>
      </div>
      <%# 第七格 li#myVideo 是影音，網址照約定的 /:user/video %>
      <%- include('myspace2012', { msUser: u, msVariant: 'gb',
            msLabels: ['MyPage','相簿','網誌','留言板','名片','好友','影音'] }) %>
    </div>
  </li>

  <li id="action" class="box">
    <% if (me && !isOwner) { %>
    <form method="post" action="/<%= u.name %>/friend" style="display:inline">
      <button class="w2-linkbtn" type="submit"><%= isFriend ? '移出好友名單' : '加入好友名單' %></button>
    </form><span>&nbsp;&nbsp;|&nbsp;</span>
    <% } %>
    <a href="/<%= u.name %>/guestbook?tab=new">我要留言</a><span>&nbsp;&nbsp;|&nbsp;</span>
    <a class="rss" href="/<%= u.name %>/blog/rss">RSS <img align="bottom" border="0" src="/img/wretch2012/gb/rss.gif" alt="RSS"></a>
  </li>

  <%# 原站好友 0 人時 select 照樣輸出，只有佔位那一行，所以這裡不加 length 判斷 %>
  <li id="friendlist" class="box">
    <%- include('friendlist2012', {
          flFriends: (typeof friends !== 'undefined' && friends) ? friends : [],
          flLabel: "- Friends' Guestbook -", flGo: '/guestbook' }) %>
  </li>

  <%- include('adslot2012', { adId: 'ad_lrec', adTag: 'li',
        adNotices: locals.notices || (locals.siteNotice ? [locals.siteNotice] : []),
        adTopics: locals.blogTopics || locals.topics || [] }) %>

  <% if (typeof visitors !== 'undefined' && visitors) { %>
  <li class="box">
    <div class="w2-h3">誰來我家</div>
    <% if (!visitors.length) { %><div class="w2-empty">目前還沒有人來過</div><% } %>
    <% visitors.forEach(v => { %>
    <div><a href="/<%= v.who %>"><%= v.who %></a>
      <span class="w2-sub"><%= v.created.slice(5,16) %></span></div>
    <% }) %>
    <div class="w2-more"><a href="/<%= u.name %>/visitors">更多足跡..</a></div>
  </li>
  <% } %>

  <% if (typeof friends !== 'undefined' && friends) { %>
  <li class="box">
    <div class="w2-h3">好友連結</div>
    <% if (!friends.length) { %><div class="w2-empty">目前還沒有好友</div><% } %>
    <% friends.forEach(f => { %>
    <div><a href="/<%= f.name %>"><%= f.nick %></a>
      <span class="w2-sub">(<%= f.name %>)</span></div>
    <% }) %>
    <div class="w2-more"><a href="/<%= u.name %>/friends">更多好友..</a></div>
  </li>
  <% } %>

  <%# 音樂盒。無名側欄本來就有一台播放器（原站是 Flash 的 #automusic，
      版型 skin1911 最後一條就是 #automusic{display:block}）。
      本站改用 <audio>，以下這段 JavaScript 一字未動。 %>
  <li class="box">
    <div class="w2-h3">音樂盒</div>
    <div align="center">
<% const tracks=(u.music||'').split('\n').map(s=>s.trim()).filter(Boolean); if (tracks.length) { %>
<audio id="mbox" controls loop style="width:100%;height:26px"></audio>
<%# 曲目清單放在 data 屬性，交給 EJS 的 HTML escape 處理，避免使用者網址跳出 script 區塊 %>
<div id="mboxlist" data-tracks="<%= JSON.stringify(tracks) %>" style="max-height:80px;overflow:auto;margin-top:3px;font-size:11px"></div>
<script>
(function(){
  var L=document.getElementById('mboxlist'), a=document.getElementById('mbox');
  var t=[]; try{ t=JSON.parse(L.getAttribute('data-tracks'))||[]; }catch(e){ return; }
  if(!t.length) return;
  var i=0;
  function esc(s){ return String(s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function name(u,n){ try{ return decodeURIComponent(u.split('/').pop().split('?')[0])||('曲目 '+(n+1)); }catch(e){ return '曲目 '+(n+1); } }
  function draw(){ L.innerHTML=t.map(function(u,n){ return '<div><a href="#" data-i="'+n+'">'+(n===i?'▶ ':'　')+esc(name(u,n))+'</a></div>'; }).join(''); }
  function play(n){ i=(n+t.length)%t.length; a.src=t[i]; draw(); a.play().catch(function(){}); }
  L.addEventListener('click',function(e){ var el=e.target.closest('a'); if(el){ e.preventDefault(); play(+el.getAttribute('data-i')); } });
  a.addEventListener('ended',function(){ if(t.length>1) play(i+1); });
  a.src=t[0]; draw();
})();
</script>
<% } else { %>♪ 沒有背景音樂<br><span class="w2-sub">[▶] [■] 音量 ▮▮▮▮▯</span><% } %>
    </div>
  </li>

  <%# 原版這格是「Messages: 262」＋ span.totalmsg「Hot Ranks: 311」。
      class 名字和內容對不上（裝的是人氣不是留言數），但原始碼就是這樣寫的。
      本站沒有排名查詢，.totalmsg 裝累積人氣——同樣是「這個小站的熱度」。
      #stats 只有 90px 高且 overflow:hidden，所以最多放三行。 %>
  <li id="stats" class="box">
    留言：<%= typeof total !== 'undefined' ? total : 0 %><br>
    今日人氣：<%= u.hits_date === new Date().toLocaleDateString('sv-SE') ? (u.today_hits || 0) : 0 %><br>
    <span class="totalmsg">累積人氣：<%= u.visits %></span>
  </li>

</ul>
</div>
