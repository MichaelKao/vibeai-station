<td class="side">
<div class="box"><h3>個人資料</h3><div class="in" style="text-align:center">
<a href="/<%= u.name %>"><img class="avatar" src="<%= u.avatar %>" alt=""></a><br><b><%= u.nick %></b><br><span class="gray">(<%= u.name %>)</span>
<p style="text-align:left;margin:6px 0;white-space:pre-wrap"><%= u.intro %></p>
<div class="hits">今日人氣：<b><%= u.hits_date===new Date().toLocaleDateString('sv-SE')?(u.today_hits||0):0 %></b></div>
<div class="hits">累積人氣：<span class="counter"><%= String(u.visits).padStart(6,'0') %></span></div>
<div class="gray">加入日期：<%= u.created.slice(0,10) %></div>
<% if (me && !isOwner) { %><form method="post" action="/<%= u.name %>/friend"><button class="btn"><%= isFriend?'取消好友':'加為好友' %></button></form><% } %>
<% if (isOwner) { %><a href="/<%= u.name %>/settings">修改資料</a><br><a href="/<%= u.name %>/feed">好友動態</a> ｜ <a href="/<%= u.name %>/favs">我的收藏</a><% } else { %><br><a href="/<%= u.name %>/favs">TA的收藏</a><% } %></div></div>
<% if (typeof visitors!=='undefined') { %><div class="box"><h3>誰來我家 <span><a href="/<%= u.name %>/visitors">全部</a></span></h3><div class="in"><% if(!visitors.length){ %><span class="gray">還沒有人來過…</span><% } visitors.forEach(v=>{ %><div><a href="/<%= v.who %>"><%= v.who %></a> <span class="gray"><%= v.created.slice(5,16) %></span></div><% }) %></div></div><% } %>
<% if (typeof friends!=='undefined') { %><div class="box"><h3>好友連結 <span><a href="/<%= u.name %>/friends">全部</a></span></h3><div class="in"><ul class="list"><% friends.forEach(f=>{ %><li><a href="/<%= f.name %>"><%= f.nick %></a></li><% }) %><% if(!friends.length){ %><li class="gray">還沒有好友</li><% } %></ul></div></div><% } %>
<div class="box"><h3>音樂盒</h3><div class="in gray">
<% const tracks=(u.music||'').split('\n').map(s=>s.trim()).filter(Boolean); if (tracks.length) { %>
<audio id="mbox" controls loop style="width:100%;height:26px"></audio>
<%# 曲目清單放在 data 屬性，交給 EJS 的 HTML escape 處理，避免使用者網址跳出 script 區塊 %>
<div id="mboxlist" data-tracks="<%= JSON.stringify(tracks) %>" style="max-height:80px;overflow:auto;margin-top:3px;font-size:11px"></div>
<script>
(function(){
  var L=document.getElementById('mboxlist'), a=document.getElementById('mbox');
  var t=[]; try{ t=JSON.parse(L.getAttribute('data-tracks'))||[]; }catch(e){ return; }
  if(!t.length) return;
  var i=0;
  function esc(s){ return String(s).replace(/[&<>"']/g,function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function name(u,n){ try{ return decodeURIComponent(u.split('/').pop().split('?')[0])||('曲目 '+(n+1)); }catch(e){ return '曲目 '+(n+1); } }
  function draw(){ L.innerHTML=t.map(function(u,n){ return '<div><a href="#" data-i="'+n+'">'+(n===i?'▶ ':'　')+esc(name(u,n))+'</a></div>'; }).join(''); }
  function play(n){ i=(n+t.length)%t.length; a.src=t[i]; draw(); a.play().catch(function(){}); }
  L.addEventListener('click',function(e){ var el=e.target.closest('a'); if(el){ e.preventDefault(); play(+el.getAttribute('data-i')); } });
  a.addEventListener('ended',function(){ if(t.length>1) play(i+1); });
  a.src=t[0]; draw();
})();
</script>
<% } else { %>♪ 沒有背景音樂<br><span style="font-size:10px">[▶] [■] 音量 ▮▮▮▮▯</span><% } %></div></div>
</td>
