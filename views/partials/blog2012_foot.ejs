</div><!-- nv hugewrepper -->
<%- include('kukubar2012_lower') %>
<script>
/* 社群分享列的分享網址要絕對網址，樣板端拿不到 host，在這裡補。
   （partials/blogshare.ejs 只寫了 data-share / data-path / data-title） */
(function(){
  var base = location.protocol + '//' + location.host;
  document.querySelectorAll('a[data-share]').forEach(function(a){
    var url = encodeURIComponent(base + a.getAttribute('data-path'));
    var t   = encodeURIComponent(a.getAttribute('data-title') || '');
    var k   = a.getAttribute('data-share');
    if (k === 'fb')    a.href = 'https://www.facebook.com/sharer.php?u=' + url + '&t=' + t;
    if (k === 'plurk') a.href = 'https://www.plurk.com/?qualifier=shares&status=' + url + '+(' + t + ')';
    if (k === 'yim')   a.href = 'ymsgr:customstatus?' + t + '+' + url;
  });
})();
</script>
</body>
</html>
