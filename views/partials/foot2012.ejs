<%
  /* 2012 版頁尾（assets_src2/spec/index.md 第 6.14、7.14 節）
     文案逐字照抄，連結改指本站的頁。版權年份用 © 2012（最後版）。

     這支同時收掉 #lower-wrapper 與 #bg-wrapper——
     #lower-wrapper 由 views/index.ejs 開啟，.ft 是它的第二個子節點。 */
  const w2fPad = n => String(n).padStart(2, '0');
  const w2fNow = new Date();
  const w2fToday = w2fNow.getFullYear() + '-' + w2fPad(w2fNow.getMonth() + 1) + '-' + w2fPad(w2fNow.getDate());
  /* 首頁那顆叫 #global-crumb（內頁的是 #wretch-crumb，不同 id，別搞混）。
     原站是 Yahoo 的 CSRF token；本站靠 cookie 的 SameSite=lax，沒有那套 token，
     所以自己發一組同格式的，**只輸出、不驗證**（先驗證會把既有表單全部擋掉）。
     後端把真正的 session token 放進 res.locals.crumb 之後這裡自動改用它。 */
  const w2fCrumb = locals.crumb ||
    ('&.c=' + (locals.me ? 'u' + me.id : 'g') + Math.random().toString(36).slice(2, 12)
     + '&.t=' + Math.floor(Date.now() / 1000));
%>
  <div class="ft">

    <div id="wfp-footer">
      <div id="wfp-lang">
        <ul>
          <li class="on"><a class="zh-tw" href="/">中文</a></li>
          <li><a class="en" href="/">English</a></li>
        </ul>
      </div>
      <footer>
        <nav>
          <ul class="nav">
            <%# 原站的頁尾這幾條全部指向 Yahoo 的靜態頁，我們沒有那些頁，
                所以都落在 /help。「哈啦」是站上真的有的討論區，接過去。 %>
            <li class="first"><a href="/help">新首頁介紹</a></li>
            <li><a href="/hala">哈啦</a></li>
            <li><a href="/help">服務條款</a></li>
            <li><a href="/help">隱私權政策</a></li>
            <li><a href="/blogs">新聞中心</a></li>
            <li><a href="/help">聯絡我們</a></li>
            <li><a href="/help">網路行銷</a></li>
            <li><a href="/help">招賢納士</a></li>
          </ul>
        </nav>
        <div id="rss-bar">
          <div class="inner">
            <h5>RSS:</h5>
            <ul>
              <li><a href="/">今日主題</a></li>
              <li><a href="/albums">熱門相簿</a></li>
              <li><a href="/blogs">熱門內容</a></li>
              <li><a href="/rank">名家專欄</a></li>
              <li class="last"><a href="/blogs">熱門文章</a></li>
            </ul>
          </div>
        </div>
        <p><span><a href="/help">著作權侵權</a></span>本站設有管理員並依台灣網站內容分級規定處理</p>
        <p>雅虎資訊 版權所有 © 2012 Yahoo! Taiwan All Rights Reserved.</p>
      </footer>
      <input type="hidden" id="global-crumb" name="global-crumb" value="<%= w2fCrumb %>">
      <input type="hidden" id="today-date" name="today-date" value="<%= w2fToday %>">
      <input type="hidden" id="anchor" name="anchor" value="">
    </div>

  </div>
</div><!-- /#lower-wrapper -->

</div><!-- /#bg-wrapper -->
</body>
</html>
