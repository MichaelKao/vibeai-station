<%
  /* 無名小站 2012 最後版「內頁」外框（留言板／名片／好友／個人頁）
     ─────────────────────────────────────────────────────────────
     【驗】內頁沒有首頁那套 wfp 頁首與頁尾（assets_src2/spec/chrome.md 第 0 節）。
     內頁的頁首就是 30px 高的 #kukubar-upper，頁尾就是釘在視窗底部 25px 的
     #kukubar-lower。骨架逐字照 chrome.md 第 5.1／5.2 節：

       body > #hugewrapper > #kukubar-upper + #bigcontainer
       #kukubar-lower + #footer-switch      （在 #hugewrapper 之後）

     這支只負責 <head> 與 #bigcontainer 開頭，收尾在 partials/foot2012in.ejs。

     樣式全部來自 public/wretch2012-gb.css（官方原檔）＋ 各頁自己的原廠版型
     public/wretch2012-skin-*.css，載入順序見 assets_src2/spec/skin.md 第 3 節。
     本站刻意偏離的那幾條集中在 public/wretch2012-in.css，這裡不寫新 CSS。

     品牌：這一輪刻意保留原版 logo 與「無名小站」字樣。

     呼叫端可傳：
       title  <title>
       skin   要接在 wretch2012-gb.css 之後的版型檔（陣列，可省略）
       page   <body> 的頁別 class：w2-gb（留言板家族）/ w2-user / w2-friend
       ad     要不要印 #ad_banner（預設：名片與好友頁印，留言板家族不印——
              留言板原版是 #ad_gbook 且在 #container 裡，由 gbtop.ejs 負責）

     注意：EJS 用 with(locals)，不能宣告和 local 同名的 const，
     非必定存在的變數一律走 locals.xxx。 */
  /* #wretch-crumb 的值：原站是 Yahoo 的 CSRF token（&.c=…&.t=…）。
     本站目前靠 cookie 的 SameSite=lax 擋 CSRF，沒有那套 token；
     照抄別人的字串沒有意義，所以自己發一組同格式的。
     後端把真正的 session token 放進 res.locals.crumb 之後，這裡自動改用它。
     **這一輪只輸出、不做驗證**——先驗證會把既有表單全部擋掉。 */
  const w2Crumb = locals.crumb ||
    ('&.c=' + (locals.me ? 'u' + me.id : 'g') + Math.random().toString(36).slice(2, 12)
     + '&.t=' + Math.floor(Date.now() / 1000));
  /* 站方公告：原站 2013 年底這格放的是關站公告，本站接自己的 notices 表。
     沒有公告就整塊不輸出——原站 2012 的快照同樣沒有這個節點，
     這是「沒有資料就走空狀態」（WRETCH_2012.md §1-A），不是漏做。
     ⚠ notices 目前只在首頁 route 有，內頁要等後端把它放進全域 locals。 */
  const w2Notice = (locals.notices && notices.length) ? notices[0]
                 : (locals.siteNotice || null);
  const w2Ad = locals.ad !== undefined ? locals.ad
             : ['w2-user', 'w2-friend'].includes(locals.page || '');
%><!DOCTYPE HTML>
<html lang="zh-Hant">
<head>
<%# 原站沒有這一行（2012 年還沒人在管手機）。沒有它的話手機瀏覽器會用
    980px 的虛擬視窗寬度來排版，wretch2012-rwd.css 的媒體查詢永遠不會觸發，
    使用者看到的就是被縮到很小的桌機版。這是刻意加的，桌機不受影響。 %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta charset="utf-8">
<title><%= locals.title || '無名小站' %></title>
<link rel="icon" href="/favicon.ico">
<%# 官方 CSS（留言板 layout/namecard/overwrite、好友 fix/select、名片 font、kukubar） %>
<link rel="stylesheet" href="/wretch2012-gb.css">
<%# 這一頁的原廠預設版型 %>
<% /* 沒指定就依這一頁的服務，載站主選的版型（src/skins.js） */
   const w2Page = locals.page || 'w2-gb';
   const w2Svc = w2Page.includes('user') ? 'user' : w2Page.includes('friend') ? 'friend' : 'guestbook';
   const w2Skins = locals.skin || (locals.skinCss ? [skinCss(w2Svc)] : []);
   w2Skins.forEach(function(href){ %><link rel="stylesheet" href="<%= href %>">
<% }) %><%# 本站刻意偏離之處，每條都附理由 %>
<link rel="stylesheet" href="/wretch2012-in.css">
<%# 原站的漸層是寫在頁面 inline <style> 裡的，不在 kukubar.css（chrome.md 第 2.1 節） %>
<style>.kukubar-customized{background:#EEEDDD;background:-moz-linear-gradient(top,#FFFFFF 0%,#EEEDDD 100%);background:-webkit-gradient(linear,left top,left bottom,color-stop(0%,#FFFFFF),color-stop(100%,#EEEDDD));background:linear-gradient(to bottom,#FFFFFF 0%,#EEEDDD 100%)}</style>
<%# 使用者自訂 CSS 一定放最後，才蓋得過版型——這是無名的靈魂功能 %>
<%# 響應式圖層。原站沒有 RWD（2012 是 970px 固定寬），這是刻意加的，
    整支包在 @media (max-width:999px) 裡，桌機寬度一條都不生效。
    **一定要放在所有版型與偏離層之後**才蓋得過那些寫死的 px 寬度，
    但要放在使用者自訂 CSS 之前——自訂 CSS 依契約 §4-5 永遠是最後一個。 %>
<link rel="stylesheet" href="/wretch2012-rwd.css">
<% if (locals.u && u.css) { %><style><%- safeCss(u.css) %></style><% } %>
</head>
<body class="<%= locals.page || 'w2-gb' %>">
<!-- nv hugewrepper -->
<div id="hugewrapper"><input id="wretch-crumb" type="hidden" value="<%= w2Crumb %>">
<%# #static-path 是 kukubar.js 組素材網址用的根路徑（原站 l.yimg.com/e/serv/common/）。
    本站的素材根就是 CDN（R2；本機自動回退到 public/img/）。 %>
<input id="static-path" type="hidden" value="<%= CDN %>">

<div id="kukubar-upper" class="font-black kukubar-customized kukubar-bar">
  <div class="left-side">

    <div id="wretch-logo" class="bar-block bar-block-click">
      <h1><a class="bar-link" tabindex="1" href="/">無名小站</a></h1>
    </div>

    <%# 目前服務固定是 Blog：存檔的留言板頁就是這樣（li.blog-index 會被 CSS 藏起來） %>
    <div id="wretch-service" class="bar-block bar-block-click">
      <a class="current-service bar-link theme" tabindex="2" href="/blogs">Blog</a>
      <span class="bar-block-btn" tabindex="3">展開</span>
      <ul class="dropdown blog-service">
        <li class="album-index"><a class="bar-link" href="/albums">Album</a></li>
        <li class="blog-index"><a class="bar-link" href="/blogs">Blog</a></li>
        <%# 影音與嘀咕本站有（另一位 agent 正在做後端），指到約定好的網址；
            站台層級的總站還沒有，所以用手邊的站主／自己當入口。 %>
        <li class="video-index"><a class="bar-link" href="<%= locals.u ? '/'+u.name+'/video' : (me ? '/'+me.name+'/video' : '/help') %>">Video</a></li>
        <li class="digu-index"><a class="bar-link" href="<%= locals.u ? '/'+u.name+'/digu' : (me ? '/'+me.name+'/digu' : '/help') %>">Digu</a></li>
        <li class="join-index"><a class="bar-link" href="/help">Join</a></li>
        <li><a class="bar-link" href="/">Yahoo!</a></li>
        <li><a class="bar-link" href="/help">Help</a></li>
        <li><a class="bar-link" href="/rank">Premium</a></li>
      </ul>
    </div>

    <%# 原站這裡是每日更換的「今日主題：…」跑馬。本站沒有編輯台，指向排行榜。
        .announcement 是站方公告，優先度高於今日主題（原站 2013 底就是這樣排的，
        CSS 見 wretch2012-in.css §11）。 %>
    <div id="infozone">
      <% if (w2Notice) { %><p class="announcement"><a href="/help"><%= w2Notice.body || w2Notice %></a></p><% } %>
      <ul>
        <li><a href="/rank" class="theme">今日主題：本週人氣排行榜</a></li>
      </ul>
    </div>
  </div>

  <div class="right-side">

    <div id="wretch-search" class="bar-block">
      <%# 站內搜尋：src/server.js 的 app.get('/search') 只讀 q %>
      <form method="get" action="/search" name="searchForm">
        <fieldset>
          <legend>Article<span>選擇服務</span></legend>
          <div class="service-list dropdown">
            <input type="radio" id="srch-blog" name="type" value="article" checked="checked" data="checked">
            <label for="srch-blog" _target="Article Search">Article</label>
            <input type="radio" id="srch-album" name="type" value="photo">
            <label for="srch-album" _target="Album Search">Album</label>
            <input type="radio" id="srch-video" name="type" value="video">
            <label for="srch-video" _target="Video Search">Video</label>
          </div>
          <div class="search-field">
            <label for="wretch-search-text" class="hidden">搜尋</label>
            <%# .blur 是原站搜尋框沒焦點時的灰字 class（kukubar.css input.blur{color:#C6C6C6}）。
                kukubar2012.ejs 與 head2012_site.ejs 早就這樣寫，這支是三份 copy 裡唯一漏掉的。 %>
            <input id="wretch-search-text" type="text" name="q" title="Article Search" placeholder="Article Search" class="blur">
            <input id="wretch-search-btn" type="submit" value="送出">
          </div>
        </fieldset>
      </form>
    </div>

    <% if (me) { %>
    <%# 登入後的樣子沒有存檔（爬蟲永遠是登出狀態），依 kukubar.css 的選擇器組出來
        （chrome.md 第 5.3 節標【推】）：暱稱 + 展開箭頭 + 白底下拉。 %>
    <div id="wretch-login" class="bar-block bar-block-click bar-link">
      <a class="bar-link theme" href="/<%= me.name %>"><%= me.nick %></a>
      <span class="bar-block-btn-login">展開</span>
      <ul class="dropdown">
        <li><a class="bar-link" href="/<%= me.name %>">我的小站</a></li>
        <li><a class="bar-link" href="/<%= me.name %>/feed">好友動態</a></li>
        <li><a class="bar-link" href="/<%= me.name %>/settings">個人設定</a></li>
        <% if (me.admin) { %><li><a class="bar-link" href="/admin">站長後台</a></li><% } %>
        <li><form method="post" action="/logout"><button class="lnk" type="submit">登出</button></form></li>
      </ul>
    </div>
    <% } else { %>
    <div id="wretch-login" class="bar-block bar-block-click bar-link no-hover">
      <ul class="login-links">
        <li class="link-item first"><a class="bar-link theme" href="/login">Login</a></li>
        <li class="link-item"><a class="bar-link theme" href="/register">Register</a></li>
      </ul>
    </div>
    <% } %>

    <div id="cam"><a class="theme" href="/">Yahoo!</a></div>
  </div>
</div>

<%# 那兩個 inline style 是原站就有的（kukubar.js 開下拉時會改 #bigcontainer 的
    z-index，position:relative 是前提）。三支外框只有這裡漏掉，補齊。 %>
<div id="bigcontainer" style="position: relative !important; zoom:1 !important;" >
<% if (flash) { %><div class="w2-flash"><%= flash %></div><% } %>
<%# #ad_banner 在 #bigcontainer 內、#container 之前（名片與好友頁；
    留言板家族原版改用 #ad_gbook 且在 #container 裡面，見 gbtop.ejs）。 %>
<% if (w2Ad) { %><%- include('adslot2012', {
      adId: 'ad_banner',
      adNotices: locals.notices || (locals.siteNotice ? [locals.siteNotice] : []),
      adTopics: locals.blogTopics || locals.topics || [] }) %><% } %>
