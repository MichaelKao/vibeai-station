<%
  /* 網誌右側欄 #links 的內容（200px）
     ─────────────────────────────────────────────────────────────
     模組順序與 DOM 逐節點照抄 assets_src2/html/blog_2012_default_skin_afuuu.html，
     規格見 assets_src2/spec/blog.md 第 8-4 節：

       .calendar          ← 月曆（獨立一塊，不在任何 box 裡）
       #boxMySpace        ← 個人資訊
       #boxNewArticle     ← 最新文章
       #boxCategory       ← 文章分類
       #boxDate           ← 月份彙整
       #boxSearch         ← 站內搜尋
       #divThird > #divThird2 > #boxNewComment / #boxNewTrackback / #boxCounter
                 > .syndicate

     每個模組固定三層：#boxXxx > .boxXxx0 > .sidetitle ／ .boxXxx1 > .side，
     模組尾巴一個 <br />（`#links br{display:none}` 平常看不到，換造型時會跑出來，
     所以照抄要留著）。#boxMySpace 與 #boxCounter 在原始檔裡就沒有那個 <br />。

     這支只吐側欄內容，不含外框；呼叫端自己開 <div id="links"><div id="links2">。

     文案：存檔頁面全是英文語系表（爬蟲沒有語系 cookie），台灣使用者看到的中文
     blog.md 第 6-C 節列為【推】，這裡照那份對照表用中文。

     資料來自 src/server.js 的 blogSide()：cats / recent / recentC / months / cal。
     只在部分頁面存在的 local（ym、k、inBody、trackbacks）一律用 locals 保護。

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const todayHits = u.hits_date === new Date().toLocaleDateString('sv-SE') ? (u.today_hits || 0) : 0;
  const curYm     = locals.ym || '';
  const curK      = locals.k  || '';
  const curInBody = !!locals.inBody;
  /* 側欄的「最新引用」用 sideTbs，不能用 trackbacks——
     單篇文章頁自己也傳一個 trackbacks（那一篇的引用清單），
     而它展開在 blogSide() 之後，同名會把側欄這份整個蓋掉。 */
  const tbs       = locals.sideTbs || [];
  const wk        = ['日','一','二','三','四','五','六'];
  const wkAbbr    = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const IMG       = '/img/wretch2012/blog';
%>
<%# ── 月曆 .calendar（200×200，底圖 calendar.gif） ───────────────── %>
<div align="center" class="calendar">
  <%# ⚠ 這裡原本連到 ?cal=<目前正在顯示的月份>——點下去只是維持現狀，
      畫面一個像素都不會變。原站連到的是整頁月曆檢視（?schedule=1）。 %>
  <a href="/<%= u.name %>/blog?schedule=1&amp;ym=<%= cal.key %>" rel="nofollow">文章日曆</a>
  <table border="0" cellspacing="4" cellpadding="0" summary="Monthly calendar with links to each day's posts">
    <caption class="calendarhead">
      <a href="/<%= u.name %>/blog?cal=<%= cal.prevYm %>" rel="nofollow">&lt&lt</a>
      <a href="/<%= u.name %>/blog?ym=<%= cal.key %>" rel="nofollow"><%= cal.y %> 年 <%= cal.m %> 月</a>
      <% if (!cal.isFuture) { %><a href="/<%= u.name %>/blog?cal=<%= cal.nextYm %>" rel="nofollow">&gt&gt</a><% } %>
    </caption>
    <tr>
      <% wk.forEach((d,i)=>{ %><th abbr="<%= wkAbbr[i] %>" align="center"><span class="calendar"><%= d %></span></th><% }) %>
    </tr>
    <% for (let i=0; i<cal.cells.length; i+=7) { %>
    <tr>
      <% for (let j=i; j<i+7; j++) { const c=cal.cells[j]; %><td align="center"><span class="calendar"><% if (!c) { %>&nbsp;<% } else if (c.has) { %><a href="/<%= u.name %>/blog?d=<%= cal.key %>-<%= String(c.d).padStart(2,'0') %>" rel="nofollow"><%= c.d %></a><% } else { %><%= c.d %><% } %></span></td><% } %>
    </tr>
    <% } %>
  </table>
</div>

<%# ── #boxMySpace ─────────────────────────────────────────────── %>
<div id="boxMySpace">
 <div class="boxMySpace0">
  <div class="sidetitle">
   <%- include('vipicon2012', { viUser: u, viStyle: 'auth' }) %><%= u.nick %> 的小站  </div>
 </div>
 <div class="boxMySpace1">
  <div class="side">
   <div class="boxMySpaceImg">
    <a href="/<%= u.name %>/card">
     <img border="0" width="90" height="90" src="<%= u.avatar || (IMG + '/user_cover.gif') %>" alt="<%= u.nick %>"/>
    </a>
   </div>

   <%# 這個網誌的站內分類（原版 #blogCategory：連到網誌總站的該分類熱門榜）。
       users 表沒有「這個網誌屬於哪一類」的欄位，所以只在後端把它放進
       locals.blogTopic 時才印——原站沒設分類的使用者同樣整塊不印。 %>
   <% if (locals.blogTopic) { %>
   <div id="blogCategory">
    <span>站內分類：</span>
    <a href="/blogs?topic=<%= encodeURIComponent(blogTopic) %>"><%= blogTopic %></a>
   </div>
   <% } %>

   <div id="service">
    <%# 七顆服務鈕（第七顆是影音，網址照約定的 /:user/video），
        四種變體集中在 partials/myspace2012.ejs %>
    <%- include('myspace2012', { msUser: u, msVariant: 'blog',
          msLabels: ['MyPage','相簿','網誌','留言板','名片','好友','影音'] }) %>

    <%# 原站對未登入訪客也照樣印這一格（存檔就是爬蟲的登出狀態），
        點下去才導到登入頁——所以 li.boxAddFriendLink 永遠輸出。 %>
    <ul id="interactionList">
     <% if (me && !isOwner) { %>
     <li class="boxAddFriendLink"><form method="post" action="/<%= u.name %>/friend"><button class="mySpaceLink" id="link_addfriend"><%= isFriend ? '取消好友' : '加入好友名單' %></button></form></li>
     <% } else if (!me) { %>
     <li class="boxAddFriendLink"><a class="mySpaceLink" id="link_addfriend" href="/login">加入好友名單</a></li>
     <% } %>
     <% if (isOwner) { %>
     <li class="boxAddFriendLink"><a class="mySpaceLink" id="link_addfriend" href="/<%= u.name %>/blog/new">發表文章</a></li>
     <li class="boxAddFriendLink"><a class="mySpaceLink" href="/<%= u.name %>/settings">網誌樣式</a></li>
     <li class="boxAddFriendLink"><a class="mySpaceLink" href="/<%= u.name %>/settings">網誌設定</a></li>
     <% } %>
    </ul>
   </div>
   <%# 「去逛好友的網誌」下拉。原站好友 0 人時也照樣輸出，只有佔位那一行。 %>
   <%- include('friendlist2012', {
         flFriends: (typeof friends !== 'undefined' && friends) ? friends : [],
         flLabel: "- Friends' Blog -", flGo: '/blog' }) %>
  </div>
 </div>
</div>

<%# ── #boxNewArticle ──────────────────────────────────────────── %>
      <div id="boxNewArticle">
      <div class="boxNewArticle0">
        <div class="sidetitle">
          最新文章        </div>
      </div>
      <div class="boxNewArticle1">
        <div class="side">
          <% recent.forEach(r=>{ %><a href="/<%= u.name %>/blog/<%= r.id %>"><%= r.title %></a><br />
          <% }) %><% if (!recent.length) { %><a href="/<%= u.name %>/blog">尚無文章</a><br /><% } %>
        </div>
      </div>
      <br />
    </div>

<%# ── #boxCategory ────────────────────────────────────────────── %>
<%# 注意 .boxCategory1 是 font-size:0/color:#eee（原站用來藏樣板空白字的老招），
    只有 <a> 會被 #links .boxCategory1 a 拉回 12px，所以這一格裡不要放純文字。 %>
      <div id="boxCategory">
      <div class="boxCategory0">
        <div class="sidetitle">
          文章分類        </div>
      </div>
      <div class="boxCategory1">
        <div class="side">
          <% cats.forEach(c=>{ %><a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(c.category) %>"><%= c.category %>(<%= c.n %>)</a><br />
          <% }) %><a href="/<%= u.name %>/blog">全部文章</a><br />
        </div>
      </div>
      <br />
    </div>

<%# ── #boxDate ────────────────────────────────────────────────── %>
      <div id="boxDate">
      <div class="boxDate0">
        <div class="sidetitle">
          月份彙整        </div>
      </div>
      <div class="boxDate1">
        <div class="side">
          <a href="/<%= u.name %>/blog">全部文章</a>
          <br />
          <form action="/<%= u.name %>/blog" method="get" class="monthly">
          <select name="ym" onChange="if(this.value)this.form.submit();" aria-label="跳到哪個月份的文章">
            <option value="">- 月份彙整 -</option>
            <% months.forEach(m=>{ %><option value="<%= m.ym %>" <%= curYm===m.ym ? 'selected' : '' %>><%= m.ym.slice(0,4) %> 年 <%= +m.ym.slice(5,7) %> 月(<%= m.n %>)</option>
            <% }) %>
          </select>
          </form>
          <%# 「看地圖」照 WRETCH_SPEC.md:278 放在 boxDate 裡（月份下拉之後）。
              那個功能零存檔，只有這兩行文字轉寫，所以連過去的頁面是自製的
              ——按地區看文章與相簿，不做假的地圖，理由見 views/blog_map.ejs。 %>
          <a href="/<%= u.name %>/blog/map">看地圖</a>
          <br />
        </div>
      </div>
      <br />
    </div>

<%# ── #boxFolder（使用者自訂欄位，可以有 N 個）─────────────────────
    原版存檔實證見 assets_src2/spec/blog.md §1097：同一個 id 重複很多次，
    原站就是這樣（【About Me】【線上人數】【FLAG COUNTER】…），照抄不改成 class。
    `.side` 上那個 inline `style="width: 200px;"` 也照抄——
    blog.md §168 已經指出它加上 12px border 會超出 200px 欄寬，那是原站的小 bug。

    ⚠ 原站的自訂欄位可以塞任意 HTML（Facebook badge、廣告 iframe）。
    我們不行：WRETCH_2012.md §4-4 規定使用者輸入一律逸出，
    所以內容走站上通用的 render()（[img] [b] 連結那套），
    貼得進去圖片與連結，貼不進去 <script>。 %>
<% if (typeof folders !== 'undefined' && folders.length) { folders.forEach(fd => { %>
      <div id="boxFolder">
      <div class="boxFolder0"><div class="sidetitle"><%= fd.title %>          </div></div>
      <div class="boxFolder1">
        <div class="side" style="width: 200px; ">
          <%- render(fd.body) %>
        </div>
      </div>
      <br />
    </div>
<% }) } %>

<%# ── #boxSearch ──────────────────────────────────────────────── %>
      <div id="boxSearch">
      <div class="boxSearch0">
        <div class="sidetitle">
          搜尋本站        </div>
      </div>
      <div class="boxSearch1">
        <div class="side">
          <br />
          <%# 對應 src/server.js 的 site.get('/blog/search')：q 與 body。
              「標題」兩種模式都一定比對，所以那格固定勾選且不送出。 %>
          <form action="/<%= u.name %>/blog/search" method="get" >
            <input type="text" name="q" id="blog_search_key" size="12" maxlength="30" aria-label="在這個人的網誌裡搜尋" value="<%= curK %>">
            <input type="submit" id="blog_search_submit" value="搜尋">
            <br />

            <label><input type="checkbox" class="blog_search_filter" value="1" checked disabled>標題</label>
            <label><input type="checkbox" name="body" class="blog_search_filter" value="1" <%= curInBody ? 'checked' : '' %>>內容</label>
          </form>
        </div>
      </div>
      <br />
    </div>

  <div id="divThird">
    <div id="divThird2">
<%# ── #boxNewComment（標題右側有 RSS 圖） ─────────────────────── %>
        <div id="boxNewComment">
        <div class="boxNewComment0">
          <div class="sidetitle">
            最新回應
                        <span class="syndicate">
            <a href="/<%= u.name %>/blog/rss"><img border="0" src="<%= IMG %>/rss.gif" /></a>
            </span>
                      </div>
        </div>
        <div class="boxNewComment1">
          <div class="side">
            <% recentC.forEach(c=>{ %><a href="/<%= u.name %>/blog/<%= c.post_id %>#comments">Re: <%= c.title %></a>, by <%= c.author %><br />
            <% }) %><% if (!recentC.length) { %><a href="/<%= u.name %>/blog">尚無回應</a><br /><% } %>
          </div>
        </div>
        <br />
      </div>

<%# ── #boxRssList（我的訂閱）─────────────────────────────────────
    骨架逐字照 assets_src/html/blog_home.html:341（注意是 assets_src，不是 src2——
    assets_src2 那十份頁面沒有這個模組，blog.md §1271 有記這件事）：

      #boxRssList > .boxRssList0 > .sidetitle
                  > .boxRssList1 > .side
        span#boxRssEntryTitle 來源名 (日期) <br />
        span#boxRssEntryBody > a[target=_blank] 條目標題 <br />

    兩個特徵照抄：
      1. **末尾沒有 <br />**——其他每個模組都有，只有這一個沒有
      2. id 重複用在多筆上（原站就是這樣寫，不是 class）
    標題文字原檔是英文語系的 My subscription，中文對照表是「我的訂閱」
    （WRETCH_SPEC.md:279），與其他模組一樣走中文。
    位置也照原檔：夾在 #boxNewComment 與 #boxNewTrackback 之間。
    沒有訂閱（或還沒抓到東西）就整塊不印。 %>
<% if (typeof subs !== 'undefined' && subs.length) { %>
      <div id="boxRssList">
        <div class="boxRssList0">
          <div class="sidetitle">
            我的訂閱          </div>
        </div>
        <div class="boxRssList1">
          <div class="side">
<% subs.forEach(s => { %>            <span id="boxRssEntryTitle" ><%= s.title %></span>(<%= (s.last_date || '').slice(0,10) %>)<br />
            <span id="boxRssEntryBody" ><% if (s.last_url) { %><a target="_blank" rel="noopener nofollow" href="<%= s.last_url %>"><%= s.last_title %></a><% } else { %><%= s.last_title %><% } %> </span><br />
<% }) %>          </div>
        </div>
      </div>
<% } %>

<%# ── #boxNewTrackback ────────────────────────────────────────── %>
        <div id="boxNewTrackback">
        <div class="boxNewTrackback0">
          <div class="sidetitle">
            最新引用          </div>
        </div>
        <div class="boxNewTrackback1">
          <div class="side">
            <% tbs.forEach(t=>{ %><a href="/<%= t.uname %>/blog/<%= t.pid %>">Re: <%= t.title %></a><span>, by <a href="/<%= t.uname %>/blog"><%= t.uname %></a> (<%= t.created ? t.created.slice(5,10) : '' %>)</span><br />
            <% }) %><% if (!tbs.length) { %><a href="/<%= u.name %>/blog">尚無引用</a><br /><% } %>
          </div>
        </div>
        <br />
      </div>

<%# ── #boxCounter ─────────────────────────────────────────────── %>
        <div id="boxCounter">
        <div class="boxCounter0">
          <div class="sidetitle">
            訪客人數          </div>
        </div>
        <div class="boxCounter1">
          <div class="side">
            今日人氣: <%= todayHits %><br />
            累積人氣: <%= u.visits %>              </div>
        </div>
      </div>

    </div> <!-- end of divThird2 -->
      <div class="syndicate">
      <a href="/<%= u.name %>/blog/rss"><img border="0" src="<%= IMG %>/rss.gif" /></a>
      </div>
    </div> <!-- end of divThird -->
