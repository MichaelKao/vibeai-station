<%# 留言板 — 無名小站 2012 最後版，官方骨架 guestbook/css/layout.css ＋ 原廠版型 skin 1/1911
    ─────────────────────────────────────────────────────────────
    每一則留言的 DOM 逐字照 assets_src2/html/gb_guestbook_a000000010_20131226.html：

      ul.msg_body > li.msg_content > ul > li.msg_img    （60px 頭像，絕對定位 left:20 top:12）
                                        > li.msg_man    <span>暱稱：</span>
                                        > li.msg_title  <span>主題：</span><strong>…</strong><cite>鎖頭</cite>
                                        > li.msg_date   <span>時間：</span>… ＋ 檢舉
                                        > li.msg_word   <span>內容：</span><strong>…</strong>
                  > li.reply_content > ul > li.reply_word <span>板主回覆：</span>

    鎖頭在**主題後面**的 <cite> 裡（原始檔就是這樣寫的，不是放在主題前面）。

    ⚠ 2026-08-19 拿掉了 li.msg_info（「通知：」）。原因：那一格在原版**只有訪客
    留了 Email 時才出現**，裡面是一顆 mailto 的信封圖
    （gb_gbook_page2_a050907_20110816.html 十則訪客留言都是這樣；
      gb_guestbook_a000000010_20131226.html 整份 0 次）。本站的留言表單根本沒有
    Email 欄位，所以那一格永遠是空的，而版型給了它
    `.msg_info{border-bottom:1px dotted #a9a9a9;padding:5px 0}`——
    每一則留言底下都會多一條 27px 的空虛線，實測就是這樣（shot.mjs measure）。

    悄悄話：secret=1 且看的人不是站主時，暱稱／主題／內容三處全部顯示「悄悄話」，
    而且**整格 li.msg_img 不輸出**、板主回覆也一樣蓋成「悄悄話」——
    原版就是這樣做的（上面那份存檔裡的 Sealed 留言沒有 li.msg_img，
    但 li.reply_content 還在、內容是 Sealed）。看的人知道「有回覆但看不到」，
    而不是整塊消失。

    頁籤：留言板 / 系統訊息（只有站主看得到）；「我要留言」在原站是右邊那顆
    a.message 按鈕（message.gif 120×39），不是第三個頁籤——這裡照原樣。

    表單 action 與欄位 name 對應 src/server.js：
      POST /:name/guestbook            author / subject / body / secret
      POST /:name/guestbook/:id/reply  reply
      POST /:name/guestbook/:id/del
      POST /report                     kind / target / url / reason %>
<%
  // 表情圖：原站 guestbook/img/Smileys/ 那 20 張（18×18）。
  // 留言內容一律先過 format.js 的 render()（會 escape 全部字元），
  // 之後才把 [img]名稱[/img] 這種 token 換成 <img>——名稱是白名單裡的固定字串，
  // 使用者插不進任何自己的屬性或標籤。
  const GB_SMILEYS = ['angry','biggrin','bighug','blushing','broken_heart','confused','crying',
    'happy','laughing','lovestruck','notalking','phbbbbt','sad','shameonyou','straightface',
    'surprise','tongue','waiting','winking','worried'];
  const GB_SMILEY_RE = new RegExp('\\[img\\](' + GB_SMILEYS.join('|') + ')\\[\\/img\\]', 'g');
  const gbBody = s => render(s).replace(GB_SMILEY_RE,
    (m, n) => '<img class="smiley" src="/img/wretch2012/gb/Smileys/' + n + '.gif" width="18" height="18" alt="' + n + '">');
%>
<%- include('partials/head2012in', {
      title: u.nick + '的留言板 - 無名小站',
      page: 'w2-gb',
      skin: ['/wretch2012-skin-guestbook.css'] }) %>

<%- include('partials/gbtop', {
      head: u.nick + ' 的留言板',
      /* 原版只有兩個頁籤：#tab_normal（留言）與 #tab_bulletin（站方公告，
         發文者一律 wretchoffice、人人可見、會分頁）。我們的「系統訊息」是
         站主一個人的私人信箱，語意不同，所以另外掛在後面、只有本人看得到。 */
      tabs: [
        { id:'tab_normal',   href:'/'+u.name+'/guestbook', label:'留言板', on: tab==='list' },
        { id:'tab_bulletin', href:'/'+u.name+'/guestbook?tab=bulletin', label:'站方公告', on: tab==='bulletin' },
        ...(isOwner ? [{ href:'/'+u.name+'/guestbook?tab=sys',
                         label:'系統訊息' + (unread ? '('+unread+')' : ''), on: tab==='sys' }] : []),
      ] }) %>

<% if (tab === 'sys') { %>
<%# ===== 系統訊息（站方通知、板主收到新留言的通知） ===== %>
<div id="search">共 <b><%= total %></b> 則系統訊息</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'top', gpHref: n => '?tab=sys&p=' + n }) %>

<div id="msg_list">
  <% if (!sys.length) { %><div class="msg_body"><div class="w2-empty">沒有系統訊息</div></div><% } %>
  <% sys.forEach(m => { %>
  <ul class="msg_body">
    <li class="msg_content">
      <ul>
        <li class="msg_img"><img src="/favicon.ico" width="60" height="60" alt="無名小站"></li>
        <li class="msg_man"><span>暱稱：</span>無名小站</li>
        <li class="msg_title"><span>主題：</span><strong><%= m.title || '無標題' %></strong><cite></cite></li>
        <li class="msg_date"><span>時間：</span><%= m.created %></li>
        <li class="msg_word"><span>內容：</span><strong><%- gbBody(m.body) %></strong></li>
      </ul>
    </li>
  </ul>
  <% }) %>
</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'bottom', gpHref: n => '?tab=sys&p=' + n }) %>

<% } else if (tab === 'new') { %>
<%# ===== 我要留言 =====
    骨架照 assets_src2/html/gb_gbook_addpost_a0913375433_20110625.html：
      #msg_list > #msg_added > h2 + div.msg_body > form > ul > li.add_img / li.add_title / li.add_name / …
    原站還有 Email／URL／記住我／驗證碼四欄，本站的 POST /:name/guestbook
    只收 author / subject / body / secret，所以那四欄不做假的。 %>
<div id="msg_list">
  <div id="msg_added">
    <h2>我要留言</h2>
    <div class="msg_body">
      <form method="post" action="/<%= u.name %>/guestbook">
        <ul>
          <li class="add_img"><img src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"></li>
          <li class="add_title">
            <a href="/<%= u.name %>/guestbook"><b><%= u.nick %> 的留言板</b></a>
          </li>
          <li class="add_name"><span>暱稱</span>
            <% if (me) { %><b><%= me.nick %></b>
            <% } else { %><input class="small-c" type="text" name="author" size="20" maxlength="20" value="<%= guest && guest.nick ? guest.nick : '' %>" required><% } %>
          </li>
          <%# ⚠ 原站的留言表單有 Name / Email / URL / Remember Me 四欄
              （存檔 gb_gbook_addpost_a0913375433_20110625.html 逐字），
              我們只做了 Name——留言者留不下聯絡方式，板主也沒辦法回連到
              對方的站。網誌迴響那邊早就有這三欄了，留言板漏掉。
              登入的人不必填（帳號本身就連得回去），所以只印給訪客。 %>
          <% if (!me) { %>
          <li><label for="gb-email">E-mail</label>
            <input class="small-c" type="email" name="email" id="gb-email" size="30" maxlength="60"
                   value="<%= (guest && guest.email) || '' %>">
            <span class="w2-sub">不會公開，只有板主看得到</span>
          </li>
          <li><label for="gb-url">個人網頁</label>
            <input class="small-c" type="url" name="homepage" id="gb-url" size="30" maxlength="200"
                   placeholder="https://…" value="<%= (guest && guest.homepage) || '' %>">
          </li>
          <li><span>記住我的資料</span>
            <label><input type="radio" name="remember" value="1" <%= guest ? 'checked' : '' %>> 是</label>
            <label><input type="radio" name="remember" value="" <%= guest ? '' : 'checked' %>> 否</label>
            <span class="w2-sub">下次留言（含網誌迴響）自動帶入</span>
          </li>
          <% } %>
          <li><span>悄悄話</span>
            <label><input type="checkbox" name="secret" value="1"> 只有板主看得到</label>
          </li>
          <li><span>主題</span>
            <input class="small-c" type="text" name="subject" size="36" maxlength="40">
          </li>
          <li><span>表情圖案</span>
            <span class="w2-emo">
              <% GB_SMILEYS.forEach(n => { %><a href="#" data-emo="<%= n %>"><img src="/img/wretch2012/gb/Smileys/<%= n %>.gif" width="18" height="18" alt="<%= n %>"></a><% }) %>
            </span>
          </li>
          <li><span>內容</span>
            <textarea class="small-c" name="body" id="content_data" cols="50" rows="10" maxlength="500" required></textarea>
          </li>
          <li><span>&nbsp;</span>
            <input class="small-c" type="submit" name="leavemsg" value="送出">
            <input class="small-c" type="reset" value="清除">
          </li>
        </ul>
      </form>
    </div>
  </div>
</div>
<script>
/* 表情圖：把 [img]名稱[/img] 插到游標位置。原站是 emoticon() 那支 JS，做的事一樣。 */
document.addEventListener('click', function(e){
  var a = e.target.closest('.w2-emo a'); if (!a) return; e.preventDefault();
  var t = document.getElementById('content_data'), tag = '[img]' + a.getAttribute('data-emo') + '[/img]';
  var s = t.selectionStart, n = t.selectionEnd;
  t.value = t.value.slice(0, s) + tag + t.value.slice(n);
  t.selectionStart = t.selectionEnd = s + tag.length; t.focus();
});
</script>

<% } else if (tab === 'bulletin') { %>
<%# ===== 站方公告（原版的 #tab_bulletin） =====
    原版這個頁籤的每一則長得跟留言一模一樣，只是發文者固定是站方
    （原站是 wretchoffice），人人可見、會分頁。所以沿用 .msg_body 那套骨架，
    只把頭像換成站台 favicon、暱稱固定成站名，並且沒有「板主回覆」那一格。 %>
<div id="search">共 <b><%= total %></b> 則站方公告</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'top', gpHref: n => '?tab=bulletin&p=' + n }) %>

<div id="msg_list">
  <% if (!bulletins.length) { %><div class="msg_body"><div class="w2-empty">目前沒有站方公告</div></div><% } %>
  <% bulletins.forEach(m => { %>
  <ul class="msg_body">
    <li class="msg_content">
      <ul>
        <li class="msg_img"><img src="/favicon.ico" width="60" height="60" alt="<%= SITE_NAME %>"></li>
        <li class="msg_man"><span>暱稱：</span><%= m.author %></li>
        <li class="msg_title"><span>主題：</span><strong><%= m.title %></strong><cite></cite></li>
        <li class="msg_date"><span>時間：</span><%= m.created %></li>
        <li class="msg_word"><span>內容：</span><strong><%- gbBody(m.body) %></strong></li>
      </ul>
    </li>
  </ul>
  <% }) %>
</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'bottom', gpHref: n => '?tab=bulletin&p=' + n }) %>

<% } else { %>
<%# ===== 留言板本體 ===== %>
<div id="search">共 <b><%= total %></b> 則留言</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'top', gpHref: n => '?p=' + n }) %>

<div id="msg_list">
  <% if (!msgs.length) { %><div class="msg_body"><div class="w2-empty">還沒有留言，來當第一個吧</div></div><% } %>
  <% msgs.forEach(m => { const hide = m.secret && !isOwner; %>
  <ul class="msg_body">
    <li class="msg_content">
      <ul>
        <%# 原版這兩格：大頭貼與暱稱都是連回留言者的小站，暱稱前面掛認證章
            （gb_guestbook_a000000010_20131226.html:12441）。
            訪客留言（author_id 是 NULL）就沒有帳號可以連，退回純文字＋預設頭像。 %>
        <%# 悄悄話對外人**整格不輸出**（原版的 Sealed 留言就沒有這一格）；
            訪客留言沒有帳號可以連，原版是一張 No_Login_60.gif，我們用預設頭像。 %>
        <% if (!hide) { %><li class="msg_img"><% if (m.a_name) { %><a href="/<%= m.a_name %>/guestbook" target="_blank"><img src="<%= m.a_avatar %>" width="60" height="60" alt="<%= m.a_nick %>"></a><% } else { %><img src="/img/avatar.png" width="60" height="60" alt=""><% } %></li><% } %>
        <li class="msg_man"><span>暱稱：</span><% if (hide) { %>悄悄話<% } else { %><%- include('partials/vipicon2012', { viUser: { vip: m.a_vip }, viStyle: 'auth' }) %><% if (m.a_name) { %><a href="/<%= m.a_name %>/guestbook" target="_blank"><%= m.author %></a><% } else if (m.homepage) { %><%# 訪客留了個人網頁就把暱稱連過去（原站行為）。外站連結一律 nofollow noopener，不要把權重與 window.opener 送出去。 %><a href="<%= m.homepage %>" target="_blank" rel="nofollow noopener"><%= m.author %></a><% } else { %><%= m.author %><% } %><% } %></li>
        <li class="msg_title"><span>主題：</span><strong><%= hide ? '悄悄話' : (m.subject || '無標題') %></strong><cite><% if (m.secret) { %><img src="/img/wretch2012/gb/lock.gif" width="21" height="16" alt="悄悄話"><% } %></cite></li>
        <li class="msg_date"><span>時間：</span><%= m.created %>
          &nbsp;<a href="/report?kind=guestbook&amp;target=<%= m.id %>&amp;url=<%= encodeURIComponent("/" + u.name + "/guestbook") %>" class="reportlink" data-kind="guestbook" data-id="<%= m.id %>">檢舉</a></li>
        <li class="msg_word"><span>內容：</span><strong><% if (hide) { %>悄悄話<% } else { %><%- gbBody(m.body) %><% } %></strong></li>
      </ul>
    </li>
    <%# 悄悄話的回覆一樣蓋成「悄悄話」，但這一格照樣輸出——
        原版就是這樣（Sealed 留言底下還是有 li.reply_content，內容也是 Sealed），
        外人才看得出來「板主回過了，只是我看不到」。 %>
    <% if (m.reply) { %>
    <li class="reply_content">
      <ul><li class="reply_word"><span>板主回覆：</span><strong><% if (hide) { %>悄悄話<% } else { %><%- gbBody(m.reply) %><% } %></strong></li></ul>
    </li>
    <% } %>
    <% if (isOwner) { %>
    <li class="reply_content">
      <form method="post" action="/<%= u.name %>/guestbook/<%= m.id %>/reply">
        <span>板主回覆：</span>
        <textarea name="reply" rows="2" maxlength="500" aria-label="回覆這則留言"><%= m.reply %></textarea>
        <input class="small-c" type="submit" value="回覆">
      </form>
      <form class="w2-del" method="post" action="/<%= u.name %>/guestbook/<%= m.id %>/del" onsubmit="return confirm('刪除這則留言？')">
        <input class="small-c" type="submit" value="刪除這則留言">
      </form>
    </li>
    <% } %>
  </ul>
  <% }) %>
</div>

<%- include('partials/gbpager', { gpPage: page, gpPages: pages, gpPos: 'bottom', gpHref: n => '?p=' + n }) %>

<%# 檢舉：原站是跳到 cc.wretch.cc/help/prosecute.php 另一頁，本站同頁展開 %>
<div id="reportbox" class="w2-report" style="display:none">
  <form method="post" action="/report">
    <input type="hidden" name="kind" id="rkind"><input type="hidden" name="target" id="rtarget">
    <input type="hidden" name="url" value="/<%= u.name %>/guestbook">
    請說明檢舉原因：<br>
    <textarea class="small-c" name="reason" cols="45" rows="3" maxlength="500" required></textarea><br>
    <input class="small-c" type="submit" value="送出檢舉">
    <input class="small-c" type="button" id="rcancel" value="取消">
  </form>
</div>
<script>
document.addEventListener('click',function(e){
  var a=e.target.closest('.reportlink');
  if(a){ e.preventDefault();
    document.getElementById('rkind').value=a.getAttribute('data-kind');
    document.getElementById('rtarget').value=a.getAttribute('data-id');
    var box=document.getElementById('reportbox');
    box.style.display='block'; box.scrollIntoView({behavior:'smooth'}); }
  if(e.target.id==='rcancel'){ document.getElementById('reportbox').style.display='none'; }
});
</script>
<% } %>

<%# ⚠ 側欄 li#friendlist 那顆下拉（「去逛好友的留言板」）目前是空的：
    partials/side.ejs 讀的 local 叫 `friends`，這條 route 送出來的叫 `gbFriends`，
    兩邊名字對不上。這裡不從 view 硬接，因為 side.ejs 用同一個 `friends`
    同時決定要不要印「好友連結」那一格——接上去下拉會活，但留言板側欄會多出
    一格原版沒有的 35 筆好友清單。根在共用檔，留給 side.ejs／route 統一處理。 %>
<%- include('partials/gbfoot') %>
<%- include('partials/foot2012in') %>
