<%
  /* 影音總站 /video
     ─────────────────────────────────────────────────────────────
     原站導覽列的「影音」指向 http://www.wretch.cc/video/
     （index_20120610082113.html 的 Yahoo 轉址網址剝掉之後就是這個），
     但**那一頁 archive.org 沒有任何存檔**——assets_src2/html/ 44 份裡一份都沒有。
     所以這一頁是自製的，照 WRETCH_2012.md §3-A 的規矩：救不回來的就用站台既有的
     元件語言補上，並標明是刻意偏離，不自創新的視覺。

     跟 /blogs 一樣走 2012 的站台外框（partials/head2012 + foot2012 ＋
     public/wretch2012.css 的 .mod / .main / .side 模組語言），不吃個人頁的版型。

     資料來自 src/server.js 的 app.get('/video')：
       page / pages / total / videos / hot。

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const qs = p => '/video?p=' + p;
%>
<%- include('partials/head2012', { title: '影音 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>最新影音</h2></div>
        <div class="bd">

          <p class="w2-blog-count">共 <b><%= total %></b> 支影片</p>

          <% if (!videos.length) { %>
          <p>還沒有人分享影片。<a href="/register">開一個帳號</a>，第一支就是你的。</p>
          <% } %>

          <ol class="w2-bloglist w2-videolist">
            <% videos.forEach(v => { %>
            <li>
              <%# 縮圖直接用 YouTube 的，不必自己存一份。
                  影片本體是 iframe 內嵌，只有點進單一支才載，列表頁不要放 iframe——
                  一頁二十個 iframe 會把瀏覽器拖垮。

                  錨點一定要寫成 #v_<id>：個人影音頁（views/video.ejs）每一支的
                  id 是 v_123，之前這裡寫 #v123 對不上，點進去永遠停在頁首，
                  一頁十二支根本找不到剛剛點的那一支。 %>
              <a class="thumbnail" href="/<%= v.uname %>/video#v_<%= v.id %>">
                <img src="https://i.ytimg.com/vi/<%= v.vid %>/mqdefault.jpg" width="85" height="85" alt="<%= v.title %>">
              </a>
              <div class="content">
                <p class="meta">
                  <a class="uname" href="/<%= v.uname %>"><%= v.uname %></a>
                </p>
                <h3><a class="skin-main-link" href="/<%= v.uname %>/video#v_<%= v.id %>"><%= v.title %></a></h3>
                <p class="description"><%= v.descr %></p>
                <p class="stat"><span>播放: <%= v.views %></span></p>
              </div>
            </li>
            <% }) %>
          </ol>

          <% if (pages > 1) { %>
          <div class="w2-pager">
            <% if (page > 1) { %><a href="<%= qs(page-1) %>">上一頁</a><% } %>
            <% for (let i=1; i<=pages; i++) { %><% if (i === page) { %><b><%= i %></b><% } else { %><a href="<%= qs(i) %>"><%= i %></a><% } %><% } %>
            <% if (page < pages) { %><a href="<%= qs(page+1) %>">下一頁</a><% } %>
          </div>
          <% } %>

        </div>
      </div>

    </div>
    <div class="side">

      <div class="mod w2-auth-side">
        <div class="hd"><h2>熱門影音</h2></div>
        <div class="bd">
          <ul>
            <% hot.forEach(v => { %>
            <li><a href="/<%= v.uname %>/video#v_<%= v.id %>"><%= v.title %></a>
              <span class="w2-blog-n">(<%= v.views %>)</span></li>
            <% }) %>
          </ul>
        </div>
      </div>

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/join">揪團</a></li>
            <li><a href="/digu">嘀咕</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
