<%- include('partials/head',{title:u.nick+'的網誌'}) %>
<table id="main"><tr><td>
<div class="box"><h3><%= u.nick %>的網誌<%= cat?" ・ "+cat:"" %><%= ym?" ・ "+ym:"" %><%= day?" ・ "+day:"" %></h3><div class="in">
<% if(!posts.length){ %><span class="gray">還沒有文章</span><% } %>
<% let lastDay=null; posts.forEach(p=>{ const d=p.created.slice(0,10); if(d!==lastDay){ lastDay=d; %><div class="datediv"><%= d %></div><% } %><div class="entry"><h4><a href="/<%= u.name %>/blog/<%= p.id %>"><%= p.pass?'[鎖] ':'' %><%= p.title %></a></h4><div class="meta"><%= p.created.slice(0,16) %> ｜ 分類：<a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(p.category) %>"><%= p.category %></a> ｜ 人氣：<%= p.views %> ｜ 推：<%= p.likes %><% if(p.mood){ %> ｜ 心情：<%= p.mood %><% } %><% if(p.weather){ %> ｜ 天氣：<%= p.weather %><% } %></div><div class="body"><% if(p.pass && !isOwner){ %><span class="gray">＊ 這篇文章已上鎖，需要密碼才能觀看 ＊</span><% } else { %><%- render(p.body.length>300?p.body.slice(0,300)+'…':p.body) %><% } %></div><div class="meta"><a href="/<%= u.name %>/blog/<%= p.id %>#comments">迴響(<%= p.nc %>)</a><% if(p.body.length>300){ %> ｜ <a href="/<%= u.name %>/blog/<%= p.id %>">(繼續閱讀)</a><% } %></div></div><% }) %>
<%- include('partials/pager') %>
</div></div>
</td><%- include('partials/blogside') %></tr></table>
<%- include('partials/foot') %>
