<%- include('partials/head',{title:'站長後台',layout:'index'}) %>

<%# 站長後台：原站沒有公開後台，這裡沿用首頁綠版的外框與 class，
    讓外觀跟站上其他頁一致（WRETCH_DOM.md 第 7 節） %>
<table width="760" border="0" cellpadding="0" cellspacing="0" align="center"><tr>
  <td class="side1"></td>
  <td id="banner1">
    <div id="banner">
      <a href="/"><img id="sitelogo" src="<%= SITE_LOGO %>" alt="<%= SITE_NAME %>"></a>
      <div id="pageheader">
        <h1><a href="/"><%= SITE_NAME %></a></h1>
        <span class="description">站長後台</span>
      </div>
    </div>
  </td>
  <td class="side2"></td>
</tr></table>

<table id="bigtab" width="760" border="0" cellspacing="0" cellpadding="0" align="center"><tr>
  <td class="side1"></td>
  <td width="750" valign="top" class="album_content">

    <a name="users" id="users"></a>
    <div class="album_title">站友 (<%= users.length %>)</div>
    <div class="side">
      <table class="data" width="100%">
        <tr><th>ID</th><th>帳號</th><th>暱稱</th><th>人氣</th><th>照片</th><th>加入</th><th>認證徽章</th><th></th></tr>
        <% users.forEach(x=>{
             /* 認證徽章（.vip_icon）：後端已經有 POST /admin/user/:id/vip，
                但後台一直沒有對應的介面，等於這個功能只能用 curl 打——所以補上。
                值域與 src/server.js 相同：0 無／1 銀／2 金／3 白金。
                ⚠ /admin 的 users 查詢目前沒有撈 u.vip，所以現在每一列都會顯示「無」，
                改了之後看不出來現在掛的是哪一級。要等 src/server.js 把 u.vip
                加進那句 SELECT，下面的 selected 判斷就會自己正確（見交接報告）。 */
             const vipNow = Number(x.vip || 0);
        %>
        <tr>
          <td><%= x.id %></td>
          <td><a href="/<%= x.name %>"><%= x.name %></a><%= x.admin?' ★':'' %></td>
          <td><%= x.nick %></td>
          <td><span class="point_grade"><%= x.visits %></span></td>
          <td><%= (x.bytes/1024/1024).toFixed(1) %>M</td>
          <td><%= x.created.slice(0,10) %></td>
          <td>
            <form method="post" action="/admin/user/<%= x.id %>/vip" style="display:inline">
              <select name="vip">
                <option value="0"<%= vipNow===0?' selected':'' %>>無</option>
                <option value="1"<%= vipNow===1?' selected':'' %>>銀</option>
                <option value="2"<%= vipNow===2?' selected':'' %>>金</option>
                <option value="3"<%= vipNow===3?' selected':'' %>>白金</option>
              </select><button class="btn">設定</button>
            </form>
          </td>
          <td><% if(x.id!==me.id){ %>
            <form method="post" action="/admin/user/<%= x.id %>/admin" style="display:inline"><button class="btn"><%= x.admin?'取消站長':'設為站長' %></button></form>
            <form method="post" action="/admin/user/<%= x.id %>/del" style="display:inline" onsubmit="return confirm('刪除 <%= x.name %> 及其所有內容（含照片）？')"><button class="btn red">刪除</button></form>
          <% } %></td>
        </tr>
        <% }) %>
      </table>
    </div>

    <a name="reports" id="reports"></a>
    <div class="album_title">檢舉處理</div>
    <div class="side">
      待處理 <span class="point_grade"><%= reports.filter(r=>!r.done).length %></span> 件
      <% if(!reports.length){ %>　<span class="gray">目前沒有檢舉</span><% } %>
      <% reports.forEach(r=>{ %>
      <div class="gbitem" style="<%= r.done?'opacity:.5':'' %>">
        <div>項目：<b><%= r.kind %>#<%= r.target_id %></b>　時間：<%= r.created.slice(5,16) %>　來自：<%= r.reporter %></div>
        <div>內容：<%= r.reason %></div>
        <div>
          <%# 只渲染站內相對路徑，舊資料若含 javascript: 一律不變成連結 %>
          <% if(r.url && r.url.startsWith('/') && !r.url.startsWith('//')){ %><a href="<%= r.url %>">前往查看</a>　<% } else if(r.url){ %><%= r.url %>　<% } %>
          <% if(!r.done){ %><form method="post" action="/admin/report/<%= r.id %>/done" style="display:inline"><button class="lnk">標記已處理</button></form>　<% } %>
          <form method="post" action="/admin/report/<%= r.id %>/del" style="display:inline"><button class="lnk">刪除</button></form>
        </div>
      </div>
      <% }) %>
    </div>

    <a name="broadcast" id="broadcast"></a>
    <div class="blog_title">群發系統訊息</div>
    <div class="side">
      <form method="post" action="/admin/broadcast">
        標題：<input name="title" size="40" maxlength="60" required><br>
        內容：<br><textarea name="body" cols="60" rows="4" maxlength="1000" required></textarea><br>
        <button class="btn">送給所有站友</button>
      </form>
      <span class="gray">會進到每個人留言板的「系統訊息」頁籤。</span>
    </div>

    <a name="notices" id="notices"></a>
    <div class="album_title">站內公告</div>
    <div class="side">
      <form method="post" action="/admin/notice">
        <input name="body" size="60" maxlength="200" required>
        <input type="submit" class="btn" value="發布">
      </form>
      <% if(!notices.length){ %><span class="gray">目前沒有公告</span><% } %>
      <% notices.forEach(n=>{ %>
      <div class="gbitem">
        <%= n.created.slice(0,10) %>　<%= n.body %>
        <form method="post" action="/admin/notice/<%= n.id %>/del" style="display:inline"><button class="lnk">刪除</button></form>
      </div>
      <% }) %>
    </div>

    <a name="feature" id="feature"></a>
    <div class="blog_title">精選</div>
    <div class="side">
      <span class="gray">精選的相簿與文章會出現在首頁的精選區。編號就是網址結尾的數字
      （例如 /someone/album/<b>12</b>、/someone/blog/<b>34</b>），再按一次就取消精選。</span>
      <form method="post" action="/admin/feature/album/0"
            onsubmit="var i=(this.pid.value||'').replace(/[^0-9]/g,''); if(!i){return false;} this.action='/admin/feature/'+this.kind.value+'/'+i; return true;">
        <select name="kind"><option value="album">相簿</option><option value="post">文章</option></select>
        <%# required + pattern：沒填或填了非數字時，onsubmit 只會 return false，
            畫面上不會有任何反應，看起來像按鈕壞掉。交給瀏覽器原生驗證講話。 %>
        編號 <input name="pid" size="6" required pattern="[0-9]+" inputmode="numeric" title="請填數字編號">
        <input type="hidden" name="back" value="/admin">
        <input type="submit" class="btn" value="切換精選">
      </form>
    </div>

    <a name="storage" id="storage"></a>
    <div class="album_title">儲存空間</div>
    <div class="side">
      照片總量：<b><%= storage.mb(storage.total) %> MB</b><br>
      儲存方式：<%= storage.r2?'Cloudflare R2（不佔伺服器硬碟）':'伺服器 Volume' %><br>
      <% if(!storage.r2){ %>
      磁碟可用：<b class="<%= storage.free<2*1024*1024*1024?'red':'' %>"><%= storage.mb(storage.free) %> MB</b><br>
      <span class="gray">低於保留水位時會自動停止上傳，保護資料庫。</span><br>
      <% } %>
      每人配額：<%= storage.mb(storage.quota) %> MB <span class="gray">（USER_QUOTA_MB）</span>
    </div>

  </td>
  <td class="side2"></td>
</tr></table>

<%- include('partials/foot') %>
