<%- include('partials/head',{title:'站長後台'}) %>
<table id="main"><tr><td>
<div class="box"><h3>站友 (<%= users.length %>)</h3><div class="in"><table class="grid"><tr><th>ID</th><th>帳號</th><th>暱稱</th><th>人氣</th><th>照片</th><th>加入</th><th></th></tr><% users.forEach(x=>{ %><tr><td><%= x.id %></td><td><a href="/<%= x.name %>"><%= x.name %></a><%= x.admin?' ★':'' %></td><td><%= x.nick %></td><td><%= x.visits %></td><td><%= (x.bytes/1024/1024).toFixed(1) %>M</td><td><%= x.created.slice(0,10) %></td><td><% if(x.id!==me.id){ %><form method="post" action="/admin/user/<%= x.id %>/admin" style="display:inline"><button class="btn"><%= x.admin?'取消站長':'設為站長' %></button></form>
<form method="post" action="/admin/user/<%= x.id %>/del" style="display:inline" onsubmit="return confirm('刪除 <%= x.name %> 及其所有內容（含照片）？')"><button class="btn red">刪除</button></form><% } %></td></tr><% }) %></table></div></div>
</td><td class="side" style="width:280px">
<div class="box"><h3>檢舉處理 <span><%= reports.filter(r=>!r.done).length %> 件待處理</span></h3><div class="in">
<% if(!reports.length){ %><span class="gray">目前沒有檢舉</span><% } %>
<% reports.forEach(r=>{ %><div class="msg" style="<%= r.done?'opacity:.5':'' %>">
<b><%= r.kind %>#<%= r.target_id %></b> <span class="gray"><%= r.created.slice(5,16) %> by <%= r.reporter %></span><br>
<%= r.reason %><br><%# 只渲染站內相對路徑，舊資料若含 javascript: 一律不變成連結 %>
<% if(r.url && r.url.startsWith('/') && !r.url.startsWith('//')){ %><a href="<%= r.url %>">前往查看</a> <% } else if(r.url){ %><span class="gray"><%= r.url %></span> <% } %>
<% if(!r.done){ %><form method="post" action="/admin/report/<%= r.id %>/done" style="display:inline"><button class="lnk" style="font-size:10px">標記已處理</button></form><% } %>
<form method="post" action="/admin/report/<%= r.id %>/del" style="display:inline"><button class="lnk" style="font-size:10px">刪除</button></form>
</div><% }) %></div></div>
<div class="box"><h3>儲存空間</h3><div class="in">
照片總量：<b><%= storage.mb(storage.total) %> MB</b><br>
儲存方式：<%= storage.r2?'Cloudflare R2（不佔伺服器硬碟）':'伺服器 Volume' %><br>
<% if(!storage.r2){ %>磁碟可用：<b style="color:<%= storage.free<2*1024*1024*1024?'#c00':'#360' %>"><%= storage.mb(storage.free) %> MB</b><br>
<span class="gray">低於保留水位時會自動停止上傳，保護資料庫。</span><br><% } %>
每人配額：<%= storage.mb(storage.quota) %> MB <span class="gray">(USER_QUOTA_MB)</span>
</div></div>
<div class="box"><h3>站內公告</h3><div class="in"><form method="post" action="/admin/notice"><input name="body" size="30" maxlength="200" required> <input type="submit" class="btn" value="發布"></form><% notices.forEach(n=>{ %><div class="msg"><%= n.created.slice(0,10) %> <%= n.body %> <form method="post" action="/admin/notice/<%= n.id %>/del" style="display:inline"><button class="lnk" style="font-size:10px">刪</button></form></div><% }) %></div></div>
</td></tr></table>
<%- include('partials/foot') %>
