<%# 檢舉表單（點「檢舉這張相片」才展開）。原站是跳到 prosecute.php 另一頁。 %>
<div id="w2a-reportbox" class="w2a-report" style="display:none">
  <form method="post" action="/report">
    <input type="hidden" name="kind" id="w2a-rkind">
    <input type="hidden" name="target" id="w2a-rtarget">
    <input type="hidden" name="url" value="<%= phPath %>">
    請說明檢舉原因：<br>
    <textarea name="reason" cols="45" rows="3" maxlength="500" required></textarea><br>
    <input type="submit" class="yui3_button_content" value="送出檢舉">
    <input type="button" class="yui3_button_content yui3_button_cancel" id="w2a-rcancel" value="取消">
  </form>
</div>

<script>
/* 熱鍵：原站是 album/js/hotkey.js 的 show_hotkey()，鍵位照抄
   z 第一張 / x 上一張 / c 下一張 / v 最後一張 / b 回上一層 / s 自動播放。
   方向鍵是本站多加的（2012 沒有），在輸入框裡一律不觸發。 */
(function(){
  var go = {
    z: <%- first && prev ? JSON.stringify('/' + u.name + '/photo/' + first) : 'null' %>,
    x: <%- prev ? JSON.stringify('/' + u.name + '/photo/' + prev) : 'null' %>,
    c: <%- next ? JSON.stringify('/' + u.name + '/photo/' + next) : 'null' %>,
    v: <%- last && next ? JSON.stringify('/' + u.name + '/photo/' + last) : 'null' %>,
    b: <%- JSON.stringify(phBook) %>,
    s: <%- JSON.stringify(phBook + '/slide?i=' + idx) %>
  };
  document.addEventListener('keydown', function(e){
    var t = e.target, n = t.tagName;
    if (n === 'INPUT' || n === 'TEXTAREA' || n === 'SELECT' || t.isContentEditable) return;
    if (e.ctrlKey || e.altKey || e.metaKey) return;
    var k = (e.key || '').toLowerCase();
    if (k === 'arrowright') k = 'c';
    if (k === 'arrowleft')  k = 'x';
    if (go[k]) { e.preventDefault(); location.href = go[k]; }
  });
  document.addEventListener('click', function(e){
    var a = e.target.closest('.w2a-reportlink');
    if (a) {
      e.preventDefault();
      document.getElementById('w2a-rkind').value   = a.getAttribute('data-kind');
      document.getElementById('w2a-rtarget').value = a.getAttribute('data-id');
      var b = document.getElementById('w2a-reportbox');
      b.style.display = 'block';
      b.scrollIntoView({ behavior: 'smooth' });
    }
    if (e.target.id === 'w2a-rcancel') document.getElementById('w2a-reportbox').style.display = 'none';
  });
})();
</script>

<%# 圖片資訊（EXIF）。原站是把同一頁帶 &e 重載，PHP 在頁面下方多印一塊表格，
    #et 是那塊表格的錨點（熱鍵 i）。
    **原版那塊表格的 DOM 完全沒有存檔**——全 assets_src2/ 只搜得到那顆
    <a id="exif"> 和 hotkey 旗標，帶 &e 的快照一份都沒有。所以表格本身只能自製，
    照 WRETCH_2012.md §3-A 的規矩標明是刻意偏離。
    我們不用重載，直接同頁展開；沒有 EXIF 的照片（截圖、轉檔過的圖）是多數，
    那就只印尺寸與檔案大小，不要印空欄位。 %>
<div id="et" class="w2a-exif">
  <table border="0" cellspacing="1">
    <tr><td class="sidetitle" align="right">尺寸：</td>
        <td class="side"><% if (p.width) { %><%= p.width %> × <%= p.height %> 像素<% } else { %>—<% } %></td></tr>
    <tr><td class="sidetitle" align="right">檔案大小：</td>
        <td class="side"><%= p.bytes ? Math.round(p.bytes / 1024) + ' KB' : '—' %></td></tr>
    <tr><td class="sidetitle" align="right">拍攝時間：</td>
        <td class="side"><%= p.taken || '—' %></td></tr>
    <tr><td class="sidetitle" align="right">相機：</td>
        <td class="side"><%= p.camera || '—' %></td></tr>
    <tr><td class="sidetitle" align="right">上傳時間：</td>
        <td class="side"><%= p.created %></td></tr>
  </table>
</div>
<script>
/* 原站按「圖片資訊」是重載整頁（&e），我們同頁展開就好。
   熱鍵 i 照原站保留（show_hotkey_parameters['exif']）。 */
(function () {
  var link = document.getElementById('exif'), box = document.getElementById('et');
  if (!link || !box) return;
  var toggle = function (e) { if (e) e.preventDefault();
    box.classList.toggle('open');
    if (box.classList.contains('open')) box.scrollIntoView({ behavior: 'smooth' }); };
  link.addEventListener('click', toggle);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'i' && !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)) toggle();
  });
})();
</script>

<%# 推銷浮層。原站位置是 #bigcontainer 收掉之後、#hugewrapper 收掉之前的
    兄弟節點，也就是版面的最後——所以放在 foot2012_site 之前。 %>
<%- include('partials/remindvers2012', { rvHref: '/' + u.name + '/album/' + p.album_id + '?all=1' }) %>
<script>
/* 「一週後提醒我」：原站的 remindvers.js 沒有存檔，這裡做等價的最小行為。
   原站寫 cookie，本專案沒有 cookie-parser，改用 localStorage。

   ⚠ **預設不主動跳出來**，跟原始存檔一樣（那份快照裡整個浮層就包在 .hidden 裡）。
   理由：浮層的標題與三顆圖示都是**原版的圖片素材**，上面印死了
   「相片頁全新改版上線」「留言 / 社交 / 介面」——那是無名當年在推銷他們自己的
   新版相片頁，我們沒有那個東西。圖換不掉，只換下面三行字的話，
   整塊就變成在宣傳一個不存在的功能，那就是 WRETCH_2012.md §1-A 說的假資料。
   所以：DOM、素材、樣式全部照原版留著（結構還原度算得到），但不主動顯示；
   要看的人可以自己在 console 打 document.querySelector('#remindvers').parentNode
     .classList.remove('hidden')。 */
(function () {
  var box = document.getElementById('remindvers');
  if (!box) return;
  var KEY = 'w2-remindvers-until';
  var hide = function () {
    localStorage.setItem(KEY, Date.now() + 7 * 24 * 3600 * 1000);
    box.parentNode.classList.add('hidden');
  };
  box.querySelector('.attlater').addEventListener('click', function (e) { e.preventDefault(); hide(); });
  box.querySelector('.attnow').addEventListener('click', hide);
})();
</script>

<%- include('partials/foot2012_site') %>
