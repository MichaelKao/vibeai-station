<%# 誰來我家 — 完整足跡名單
    無名的足跡在留言板側欄與 MyPage 上都有，但沒有獨立的「完整名單」頁，
    所以這一頁沿用留言板骨架與原廠版型 skin 1/1911（同 views/home.ejs 的取捨）。 %>
<%- include('partials/head2012in', {
      title: '誰來我家 - ' + u.nick + '的小站',
      page: 'w2-gb',
      skin: ['/wretch2012-skin-guestbook.css'] }) %>

<%- include('partials/gbtop', { here: 'visitors', head: u.nick + ' 的小站' }) %>

<div id="search">共 <b><%= total %></b> 筆足跡</div>

<% if (pages > 1) { %>
<ul class="page_control">
  <% if (page > 1) { %><a id="prev" href="?p=<%= page-1 %>">上一頁</a><% } %>
  <% for (let i = 1; i <= pages; i++) { %><% if (i === page) { %><%= i %><% } else { %><a href="?p=<%= i %>"><%= i %></a><% } %><% } %>
  <% if (page < pages) { %><a id="next" href="?p=<%= page+1 %>">下一頁</a><% } %>
</ul>
<% } %>

<div class="msg_body">
  <% if (!rows.length) { %><div class="w2-empty">目前還沒有人來過</div><% } else { %>
  <table class="w2-rows">
    <% rows.forEach(v => { /* visitors 存的是「當時的帳號名」字串，users 是 LEFT JOIN：
         帳號後來被刪掉的話 nick 會是 null，再連過去就是一條 404 死連結
         （tools/linksweep.mjs 抓到過 /test/visitors 連到已消失的帳號）。
         紀錄照留，但不給連結。 */ %>
    <% const gone = !v.nick %>
    <tr>
      <td width="60" align="center">
        <% if (gone) { %><img src="/img/avatar.png" width="48" height="48" alt="<%= v.who %>">
        <% } else { %><a href="/<%= v.who %>"><img src="<%= v.avatar || '/img/avatar.png' %>" width="48" height="48" alt="<%= v.nick || v.who %>"></a><% } %>
      </td>
      <td>
        <% if (gone) { %><span class="w2-who"><%= v.who %></span>
        <% } else { %><a href="/<%= v.who %>" class="w2-who"><%= v.nick %></a><% } %>
        <span class="w2-sub">(<%= v.who %>)</span>
      </td>
      <td class="w2-when"><%= v.created %></td>
    </tr>
    <% }) %>
  </table>
  <% } %>
</div>

<% if (pages > 1) { %>
<ul class="page_control">
  <% if (page > 1) { %><a id="prev" href="?p=<%= page-1 %>">上一頁</a><% } %>
  <% for (let i = 1; i <= pages; i++) { %><% if (i === page) { %><%= i %><% } else { %><a href="?p=<%= i %>"><%= i %></a><% } %><% } %>
  <% if (page < pages) { %><a id="next" href="?p=<%= page+1 %>">下一頁</a><% } %>
</ul>
<% } %>

<%# 這一頁本身就是完整的足跡名單，側欄不用再列一次 %>
<%- include('partials/gbfoot', { visitors: null }) %>
<%- include('partials/foot2012in') %>
