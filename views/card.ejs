<%# 名片 /:name/card — 無名的 www.wretch.cc/user/<帳號>
    ─────────────────────────────────────────────────────────────
    骨架逐字照 assets_src2/html/gb_user_a014042_20120326.html：

      #container[align=center]
        table[width=600]  → tr td #banner（a#id_title + br + span.description）
                          → tr td [ 服務連結 ] + 好友下拉 + span.boxAddFriendLink
        table[width=600][cellspacing=1]
                          → tr td.sidetitle[colspan=2]#sidetitle_img  大頭照
                          → tr td.sidetitle[align=right]「暱稱：」+ td.side[width=450] 值

    這一頁**沒有官方版面 CSS**（skin.md 第 3 節：名片只載 版型 → user/font → kukubar），
    寬度完全由 HTML 的 <table width="600"> 決定，內層值欄 width="450"。
    版型（原廠預設，無素材）只給配色：#banner #CC9933 x-large、
    .sidetitle #999 + 1px dotted #666 底線、.side #CCC。淺到看不清楚是原檔就這樣。

    ⚠ 2026-08-19：**沒填的欄位不印那一列**。兩份原始存檔的欄位組完全不一樣
    （a000000010 只有 Gender／Birthday／Education／Favorite／Dislike／E-Mail／
      Introduction 七列，a014042 有十一列，多了 Nickname／Blood type／Occupation／
      Hobby、少了 Favorite 以外的…），可見原站是「有填才印」，不是固定十五列。
    照舊全印的話，一張新名片會是一整面空白虛線。
    暱稱／自我介紹／加入日期三列永遠印：前後兩者一定有值，
    自我介紹那格帶 id="id_introduction"，兩份存檔都有、也是使用者自訂 CSS 的掛點。

    表單 action 與欄位 name 對應 src/server.js 的 POST /:name/card。 %>
<%
  // 禮物圖示。站上沒有專門的禮物素材，借原站留言板的表情圖（18×18）。
  // ⚠ 以前這裡寫 'bigdrin'——沒有這張圖，星星禮物每次都是一個 404 破圖。
  // 名稱一律對得上 public/img/wretch2012/gb/Smileys/ 真的存在的檔。
  const GIFT_ICON = { flower:'blushing', cake:'happy', coffee:'winking',
                      heart:'lovestruck', star:'surprise', gift:'bighug' };
%>
<%- include('partials/head2012in', {
      title: u.nick + '的名片 - 無名小站',
      page: 'w2-user',
      skin: ['/wretch2012-skin-user.css'] }) %>

<div id="container" align="center">

<table width="600" border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <div id="banner">
        <a href="/<%= u.name %>" id="id_title"><%= u.nick %> 的名片</a>
        <br>
        <span class="description" id="id_desc"><%= u.intro ? u.intro.split('\n')[0].slice(0,60) : '' %></span>
      </div>
    </td>
  </tr>
  <tr>
    <td>
      <%- include('partials/myspace2012', {
            msUser: u, msVariant: 'card',
            msLabels: ['MyPage','相簿','網誌','留言板','名片','好友','影音'] }) %>
      <span class="small-c">
        <%- include('partials/friendlist2012', { flFriends: friends, flGo: '/card' }) %>
      </span>
      <br>
      <%# 原版這一格不分登入狀態一律輸出（gb_user_a000000010_20120531.html:12449，
          該存檔是登出態的爬蟲抓的，照樣有這個節點）。訪客點了導去登入，
          本人看到的是停用態——節點永遠在，變的只是裡面那顆連結。 %>
      <span class="boxAddFriendLink"><% if (isOwner) { %>[<span class="small-c">Your Card</span>]<% } else if (me) { %>[<form method="post" action="/<%= u.name %>/friend" style="display:inline"><button class="w2-linkbtn small-c" type="submit"><%= isFriend ? '移出好友名單' : '加入好友名單' %></button></form>]<% } else { %>[<a class="small-c" href="/login?next=<%= encodeURIComponent('/' + u.name + '/card') %>">加入好友名單</a>]<% } %></span>
    </td>
  </tr>
</table>

<table class="w2-card" width="600" border="0" cellpadding="0" cellspacing="1">
  <tr>
    <td class="sidetitle" align="center" colspan="2" id="sidetitle_img">
      <table border="1"><tr><td>
        <img src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>">
      </td></tr></table>
    </td>
  </tr>
  <tr><td class="sidetitle" align="right">暱稱：</td>
      <td class="side" width="450"><%= u.nick %> (<%= u.name %>) &nbsp;</td></tr>
  <% if (u.realname) { %>
  <tr><td class="sidetitle" align="right">姓名：</td>
      <td class="side" width="450"><%= u.realname %> &nbsp;</td></tr>
  <% } %>
  <% if (u.sex) { %>
  <tr><td class="sidetitle" align="right">性別：</td>
      <td class="side" width="450"><%= u.sex %> &nbsp;</td></tr>
  <% } %>
  <% if (u.birthday) { %>
  <tr><td class="sidetitle" align="right">生日：</td>
      <td class="side" width="450"><%= u.birthday %> &nbsp;</td></tr>
  <% } %>
  <% if (u.zodiac) { %>
  <tr><td class="sidetitle" align="right">星座：</td>
      <td class="side" width="450"><%= u.zodiac %> &nbsp;</td></tr>
  <% } %>
  <% if (u.blood) { %>
  <tr><td class="sidetitle" align="right">血型：</td>
      <td class="side" width="450"><%= u.blood %> 型 &nbsp;</td></tr>
  <% } %>
  <% if (u.city) { %>
  <tr><td class="sidetitle" align="right">居住地：</td>
      <td class="side" width="450"><%= u.city %> &nbsp;</td></tr>
  <% } %>
  <% if (u.job) { %>
  <tr><td class="sidetitle" align="right">職業：</td>
      <td class="side" width="450"><%= u.job %> &nbsp;</td></tr>
  <% } %>
  <% if (u.school) { %>
  <tr><td class="sidetitle" align="right">學校：</td>
      <td class="side" width="450"><%= u.school %> &nbsp;</td></tr>
  <% } %>
  <% if (u.hobby) { %>
  <tr><td class="sidetitle" align="right">興趣：</td>
      <td class="side" width="450"><%= u.hobby %> &nbsp;</td></tr>
  <% } %>
  <% if (u.motto) { %>
  <tr><td class="sidetitle" align="right">座右銘：</td>
      <td class="side" width="450"><%= u.motto %> &nbsp;</td></tr>
  <% } %>
  <% if (u.msn) { %>
  <tr><td class="sidetitle" align="right">MSN：</td>
      <td class="side" width="450"><%= u.msn %> &nbsp;</td></tr>
  <% } %>
  <% if (u.homepage) { %>
  <tr><td class="sidetitle" align="right">個人網頁：</td>
      <td class="side" width="450"><a href="<%= u.homepage %>" rel="nofollow noopener" target="_blank"><%= u.homepage %></a> &nbsp;</td></tr>
  <% } %>
  <%# 原版這一格帶 id="id_introduction"（gb_user_a000000010_20120531.html:14097）——
      當年是留給那段 Flash 偵測 JS 用 innerHTML 換掉的掛點（放 slide.com 的相片輪播）。
      我們沒有 Flash，但這個 id 是版面的一部分，使用者自訂 CSS 也會拿它當選擇器。 %>
  <tr><td class="sidetitle" align="right">自我介紹：</td>
      <td class="side" width="450" id="id_introduction" style="white-space:pre-wrap"><%= u.intro %> &nbsp;</td></tr>
  <tr><td class="sidetitle" align="right">加入日期：</td>
      <td class="side" width="450"><%= u.created.slice(0,10) %> &nbsp;</td></tr>
</table>

<% if (isOwner) { %>
<%# <form> 要包在 <table> 外面：放進 table 裡瀏覽器會把它挪到表格前面，欄位就送不出去了 %>
<form method="post">
<table class="w2-card" width="600" border="0" cellpadding="0" cellspacing="1">
  <tr><td class="sidetitle" align="center" colspan="2">編輯我的名片</td></tr>
  <tr><td class="sidetitle" align="right">姓名：</td>
      <td class="side" width="450"><input type="text" name="realname" value="<%= u.realname %>" maxlength="20"></td></tr>
  <tr><td class="sidetitle" align="right">性別：</td>
      <td class="side" width="450"><select name="sex"><option value="">（不公開）</option><% sexes.forEach(s=>{ %><option <%= u.sex===s?'selected':'' %>><%= s %></option><% }) %></select></td></tr>
  <tr><td class="sidetitle" align="right">生日：</td>
      <td class="side" width="450"><input type="date" name="birthday" value="<%= u.birthday %>"></td></tr>
  <tr><td class="sidetitle" align="right">星座：</td>
      <td class="side" width="450"><select name="zodiac"><option value="">（不設定）</option><% zodiacs.forEach(z=>{ %><option <%= u.zodiac===z?'selected':'' %>><%= z %></option><% }) %></select></td></tr>
  <tr><td class="sidetitle" align="right">血型：</td>
      <td class="side" width="450"><select name="blood"><option value="">（不設定）</option><% bloods.forEach(b=>{ %><option <%= u.blood===b?'selected':'' %>><%= b %></option><% }) %></select></td></tr>
  <tr><td class="sidetitle" align="right">居住地：</td>
      <td class="side" width="450"><select name="city"><option value="">（不設定）</option><% cities.forEach(c=>{ %><option <%= u.city===c?'selected':'' %>><%= c %></option><% }) %></select></td></tr>
  <tr><td class="sidetitle" align="right">職業：</td>
      <td class="side" width="450"><input type="text" name="job" value="<%= u.job %>" maxlength="20"></td></tr>
  <tr><td class="sidetitle" align="right">學校：</td>
      <td class="side" width="450"><input type="text" name="school" value="<%= u.school %>" size="30" maxlength="30"></td></tr>
  <tr><td class="sidetitle" align="right">興趣：</td>
      <td class="side" width="450"><input type="text" name="hobby" value="<%= u.hobby %>" size="40" maxlength="100"></td></tr>
  <tr><td class="sidetitle" align="right">座右銘：</td>
      <td class="side" width="450"><input type="text" name="motto" value="<%= u.motto %>" size="40" maxlength="100"></td></tr>
  <tr><td class="sidetitle" align="right">MSN：</td>
      <td class="side" width="450"><input type="text" name="msn" value="<%= u.msn %>" size="30" maxlength="50"></td></tr>
  <tr><td class="sidetitle" align="right">個人網頁：</td>
      <td class="side" width="450"><input type="text" name="homepage" value="<%= u.homepage %>" size="40" maxlength="200" placeholder="http://"></td></tr>
  <tr><td class="sidetitle" align="right">&nbsp;</td>
      <td class="side" width="450"><input type="submit" value="儲存名片">
        <span class="w2-note">自我介紹在「個人設定」修改</span></td></tr>
</table>
</form>
<% } %>

<%# 送禮物。原站在 bill.wretch.cc/gift.php?to=<帳號>（付費網域），
    我們沒有金流也不接，但這個功能本身不需要收錢，所以照做、一律免費。
    收到的禮物就掛在名片上，跟原站一樣。 %>
<table class="w2-card" width="600" border="0" cellpadding="0" cellspacing="1">
  <tr><td class="sidetitle" align="center" colspan="2">禮物</td></tr>
  <tr><td class="sidetitle" align="right" valign="top">收到的：</td>
      <td class="side" width="450">
        <% if (!gifts.length) { %>還沒有收到禮物 &nbsp;
        <% } else { %>
        <ul class="w2-gifts">
          <% gifts.forEach(g => { %>
          <li><img src="/img/wretch2012/gb/Smileys/<%= GIFT_ICON[g.kind] || 'biggrin' %>.gif" width="18" height="18" alt="">
            <a href="/<%= g.fname %>"><%= g.fnick %></a>
            <% if (g.msg) { %><span class="w2-giftmsg">「<%= g.msg %>」</span><% } %>
            <span class="w2-sub"><%= g.created.slice(5,10) %></span></li>
          <% }) %>
        </ul>
        <% } %>
      </td></tr>
  <% if (me && !isOwner) { %>
  <tr><td class="sidetitle" align="right">送一個：</td>
      <td class="side" width="450">
        <form method="post" action="/<%= u.name %>/gift">
          <select name="kind">
            <% giftKinds.forEach(k => { %><option value="<%= k[0] %>"><%= k[1] %></option><% }) %>
          </select>
          <input type="text" name="msg" size="24" maxlength="60" placeholder="說句話（可留空）">
          <input type="submit" value="送出">
        </form>
      </td></tr>
  <% } %>
</table>

<table width="600" border="0" cellpadding="0" cellspacing="0">
  <tr><td>
    <div class="powered">POWERED BY <a href="/">無名小站</a></div>
  </td></tr>
</table>

</div><!-- /#container -->

<%- include('partials/foot2012in') %>
