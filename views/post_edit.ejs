<%
  /* 發表／編輯文章
     ─────────────────────────────────────────────────────────────
     原站的發文頁（/blog/post.php）**存檔裡查無**（spec/blog.md 第 11 節），
     所以這一頁沒有可照抄的 DOM。做法是不自創新的視覺語言：
     整頁套用文章卡片那組骨架（.date > .datediv ＋ .blogbody > .blogbody2 > .articletext），
     表單本身用一張 .w2b-form 表格，樣式集中在 wretch2012-blog-site.css 並附理由。

     表單 action／method／欄位 name 一律沿用原本的（對得上 src/server.js）：
       新增 POST /:name/blog/new     編輯 POST /:name/blog/:id/edit
       欄位 title / category / topic / pass / mood / weather / body
     （form 沒有 action，就送回目前這個網址，跟原本的作法一樣。）

     **三個編輯功能一個都沒少**，只換外觀：
       1. 格式工具列 [b] [i] [u] [color] [img]   → button[data-wrap]
       2. 顏文字（src/format.js 的 EMOTES）      → button[data-ins]
       3. 插入自己的照片                          → a[data-img]（點縮圖插到游標位置）
     行為由頁尾那段 JS 提供，與改版前一字未改。

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const isNew = !post;
%>
<%- include('partials/blog2012_head', { title: (isNew ? '發表文章' : '編輯文章') + ' - ' + u.nick + ' - 無名小站',
                                        artTitle: isNew ? '發表文章' : '編輯文章', medium: '' }) %>

<div id="content">
<input type="hidden" name="check_url" value="on">
<div class="blog" >

      <div class="date">
        <div class="datediv">
          <%= isNew ? '發表文章' : '編輯文章' %>        </div>
      </div>

      <div class="blogbody">
        <div class="blogbody2">
          <div class="articletext">

            <form method="post">
              <%# ⚠ 標題或內容空白時，後端原本是 302 回這一頁——那一跳把使用者
                  剛打完的整篇文章丟掉，而且一個字都不解釋。現在把填過的內容
                  原樣送回來（locals.form），並在這裡講清楚缺什麼。 %>
              <% if (locals.formErr) { %><p class="w2-formerr"><%= formErr %></p><% } %>
            <table class="w2b-form">
              <tr>
                <th><label for="ed_title">標題</label></th>
                <td><input id="ed_title" name="title" size="48" maxlength="100" value="<%= post ? post.title : (locals.form?.title || '') %>" required></td>
              </tr>
              <tr>
                <th><label for="ed_cat">個人分類</label></th>
                <td><input id="ed_cat" name="category" list="cats" maxlength="20" value="<%= post ? post.category : '' %>" placeholder="未分類"><datalist id="cats"><% cats.forEach(c=>{ %><option value="<%= c.category %>"><% }) %></datalist></td>
              </tr>
              <tr>
                <th><label for="ed_topic">站內分類</label></th>
                <td><select id="ed_topic" name="topic"><option value="">（不分類）</option><% blogTopics.forEach(t=>{ %><option <%= post && post.topic===t ? 'selected' : '' %>><%= t %></option><% }) %></select>
                  <span class="w2b-hint">會出現在網誌總站</span></td>
              </tr>
              <tr>
                <%# 地區：給側欄那顆「看地圖」用的。相簿早就有這個欄位，
                    文章沒有的話「看地圖」就沒有東西可看。白名單同一份（PLACES）。 %>
                <th><label for="ed_place">地區</label></th>
                <td><select id="ed_place" name="place"><option value="">（不指定）</option><% (locals.places || []).forEach(pl=>{ %><option <%= post && post.place===pl ? 'selected' : '' %>><%= pl %></option><% }) %></select>
                  <span class="w2b-hint">會出現在<a href="/<%= u.name %>/blog/map">看地圖</a></span></td>
              </tr>
              <tr>
                <th><label for="ed_pass">密碼</label></th>
                <td><input id="ed_pass" name="pass" size="14" maxlength="20" value="<%= post ? post.pass : '' %>">
                  <span class="w2b-hint">留空＝公開；設了密碼別人要輸入才看得到</span></td>
              </tr>
              <tr>
                <th><label for="ed_mood">心情／天氣</label></th>
                <td><select id="ed_mood" name="mood"><option value="">（不設定）</option><% moods.forEach(m=>{ %><option <%= post && post.mood===m ? 'selected' : '' %>><%= m %></option><% }) %></select>
                  　<select name="weather" aria-label="天氣"><option value="">（不設定）</option><% weathers.forEach(w=>{ %><option <%= post && post.weather===w ? 'selected' : '' %>><%= w %></option><% }) %></select></td>
              </tr>

              <tr>
                <th>工具</th>
                <td>
                  <div class="edtools">
                    <button type="button" data-wrap="[b]|[/b]">粗體</button>
                    <button type="button" data-wrap="[i]|[/i]">斜體</button>
                    <button type="button" data-wrap="[u]|[/u]">底線</button>
                    <button type="button" data-wrap="[color=#cc3399]|[/color]">顏色</button>
                    <button type="button" data-wrap="[img]|[/img]">圖片</button>
                  </div>
                  <div class="edtools">顏文字：<% emotes.forEach(e=>{ %><button type="button" class="emo" data-ins="<%= e[0] %>" title="<%= e[0] %>"><%= e[1] %></button><% }) %></div>
                </td>
              </tr>

              <tr>
                <th><label for="body">內容</label></th>
                <td><textarea id="body" name="body" cols="56" rows="18" required><%= post ? post.body : (locals.form?.body || '') %></textarea>
                  <span class="w2b-hint">可用 [b]粗體[/b]、[i]斜體[/i]、[u]底線[/u]、[color=#f60]顏色[/color]、[img]圖片網址[/img]，網址會自動變連結。</span></td>
              </tr>

              <% if (photos.length) { %>
              <tr>
                <th>插入照片</th>
                <td>
                  <div class="photopick">
                    <% photos.forEach(p=>{ %><a href="#" data-img="<%= p.url %>" title="點一下插入文章"><img src="<%= p.thumb || p.url %>" alt=""></a><% }) %>
                  </div>
                  <span class="w2b-hint">點縮圖就會把該張照片插入游標位置。</span>
                </td>
              </tr>
              <% } %>

              <tr>
                <th></th>
                <td><input type="submit" value="<%= isNew ? '發表' : '儲存' %>">
                  <input type="button" id="ed_cancel" value="取消"></td>
              </tr>
            </table>
            </form>

              <br clear="all" />
          </div>
        </div>
      </div>

</div> <!-- end of class=blog -->
</div> <!-- end of content -->

<div id="links">

  <div id="links2">
  <%- include('partials/blogside') %>
  </div> <!-- end of links2 -->

</div> <!-- end of links -->

<script>
(function(){
  var ta=document.getElementById('body');
  function insert(before,after){
    after=after||'';
    var s=ta.selectionStart, e=ta.selectionEnd, v=ta.value;
    ta.value=v.slice(0,s)+before+v.slice(s,e)+after+v.slice(e);
    ta.focus(); ta.selectionStart=s+before.length; ta.selectionEnd=e+before.length;
  }
  document.addEventListener('click',function(ev){
    var w=ev.target.closest('[data-wrap]');
    if(w){ ev.preventDefault(); var parts=w.getAttribute('data-wrap').split('|'); insert(parts[0],parts[1]); return; }
    var m=ev.target.closest('[data-ins]');
    if(m){ ev.preventDefault(); insert(m.getAttribute('data-ins')); return; }
    var p=ev.target.closest('[data-img]');
    if(p){ ev.preventDefault(); insert('\n[img]'+p.getAttribute('data-img')+'[/img]\n'); return; }
    if(ev.target.id==='ed_cancel'){ location.href='/<%= u.name %>/blog'; }
  });
})();
</script>
<%- include('partials/blog2012_foot') %>
