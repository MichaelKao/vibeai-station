<%# MyPage — 個人小站首頁
    ─────────────────────────────────────────────────────────────
    無名的 MyPage（www.wretch.cc/mypage/）是另一支服務，它的版型檔沒有存下來
    （assets_src2/spec/skin.md 只找到 album / blog / guestbook / user / friend 五支）。
    所以這一頁沿用留言板那一套骨架與原廠版型 skin 1/1911：
    958px 容器、612px 主欄、330px 名片側欄，內容放在版型的白色面板 .msg_body 裡。
    這是刻意的取捨，理由與其餘偏離一起記在 public/wretch2012-in.css。 %>
<%
  // 7 天內建立的相簿掛 new_album.gif（WRETCH_DOM.md 第 8 節第 7 條）
  const isNew = c => { const t = Date.parse(String(c||'').replace(' ','T'));
                       return !!t && (Date.now() - t) < 7*864e5; };

  // 「最新留言」跟留言板同一批資料，就要用同一套顯示規則。
  // 留言板的表情圖存進資料庫是 [img]名稱[/img] 這種 token，src/format.js 的
  // render() 只認得「網址」型的 [img]，認不出名稱，所以 token 會原封不動印出來——
  // MyPage 上真的看得到「訪客留言內容[img]happy[/img]」這種東西。
  // 名單與 views/guestbook.ejs 的 GB_SMILEYS 相同；共用的話要動 partials/，
  // 那不是這一輪能改的檔，所以就地複製一份並在兩邊互相標註。
  const HOME_SMILEYS = ['angry','biggrin','bighug','blushing','broken_heart','confused','crying',
    'happy','laughing','lovestruck','notalking','phbbbbt','sad','shameonyou','straightface',
    'surprise','tongue','waiting','winking','worried'];
  const HOME_SMILEY_RE = new RegExp('\\[img\\](' + HOME_SMILEYS.join('|') + ')\\[\\/img\\]', 'g');
  // render() 已經把使用者輸入整串逸出，這裡換掉的只是白名單裡的固定字串
  const gbBody = s => render(s).replace(HOME_SMILEY_RE,
    (m, n) => '<img class="smiley" src="/img/wretch2012/gb/Smileys/' + n + '.gif" width="18" height="18" alt="' + n + '">');
%>
<%- include('partials/head2012in', {
      title: u.nick + '的小站 - 無名小站',
      page: 'w2-gb',
      skin: ['/wretch2012-skin-guestbook.css'] }) %>

<%- include('partials/gbtop', { here: 'home' }) %>

<%# ── 站主小檔案 ─────────────────────────────────────────────── %>
<div class="msg_body">
  <table width="100%" border="0" cellpadding="0" cellspacing="0"><tr>
    <td width="100" valign="top" align="center">
      <a href="/<%= u.name %>/card"><img src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"></a>
    </td>
    <td valign="top">
      <span class="w2-who"><%= u.nick %></span> <span class="w2-sub">(<%= u.name %>)</span><br>
      <div style="white-space:pre-wrap"><%= u.intro %></div>
      <% if (u.motto) { %><div class="w2-sub">「<%= u.motto %>」</div><% } %>
      <div class="w2-stats">
        相簿 <b><%= counts.albums %></b> 本　照片 <b><%= counts.photos %></b> 張　網誌 <b><%= counts.posts %></b> 篇　留言 <b><%= counts.gb %></b> 則　好友 <b><%= counts.friends %></b> 人
      </div>
    </td>
  </tr></table>
</div>

<%# ── 最新相簿 ───────────────────────────────────────────────── %>
<div class="msg_body">
  <div class="w2-h3">最新相簿</div>
  <% if (!albums.length) { %><div class="w2-empty">目前沒有相簿</div><% } else { %>
  <ul class="w2-grid">
    <% albums.forEach(a => { %>
    <li>
      <a href="/<%= u.name %>/album/<%= a.id %>"><% if (a.cover) { %><img src="<%= a.cover %>" width="120" height="120" alt="<%= a.title %>"><% } else { %><img src="/img/wretch2012/blog/user_cover.gif" width="85" height="85" alt="<%= a.title %>"><% } %></a>
      <span class="w2-cap">
        <% if (a.pass) { %><img src="/img/wretch2012/gb/lock.gif" width="21" height="16" alt="上鎖"><% } %><a href="/<%= u.name %>/album/<%= a.id %>"><%= a.title %></a><br>
        <span class="w2-sub"><%= a.n %> 張<% if (isNew(a.created)) { %> NEW<% } %></span>
      </span>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <div class="w2-more"><a href="/<%= u.name %>/album">更多相簿..</a></div>
</div>

<%# ── 最新文章 ───────────────────────────────────────────────── %>
<div class="msg_body">
  <div class="w2-h3">最新文章</div>
  <% if (!posts.length) { %><div class="w2-empty">目前沒有文章</div><% } else { %>
  <table class="w2-rows">
    <% posts.forEach(p => { %>
    <tr>
      <td><a href="/<%= u.name %>/blog/<%= p.id %>"><%= p.title %></a></td>
      <td class="w2-when"><%= p.created.slice(0,10) %>　<%= p.views %> 人次</td>
    </tr>
    <% }) %>
  </table>
  <% } %>
  <div class="w2-more"><a href="/<%= u.name %>/blog">更多網誌..</a></div>
</div>

<%# ── 最新留言（DOM 與留言板同一套：ul.msg_body > li.msg_content） ── %>
<div class="msg_body">
  <div class="w2-h3">最新留言</div>
  <% if (!gb.length) { %><div class="w2-empty">目前沒有留言</div><% } else { %>
  <table class="w2-rows">
    <% gb.forEach(m => { %>
    <tr>
      <td width="90" valign="top"><span class="w2-who"><%= m.author %></span></td>
      <td valign="top"><span class="w2-sub"><%= m.subject || '無標題' %></span><br><%- render(m.body) %></td>
      <td class="w2-when" valign="top"><%= m.created.slice(0,16) %></td>
    </tr>
    <% }) %>
  </table>
  <% } %>
  <div class="w2-more"><a href="/<%= u.name %>/guestbook">更多留言..</a></div>
</div>

<%# 側欄 li#stats 那格印的是「留言：N」，它讀的是 local `total`。
    MyPage 這條 route 沒有 total（它給的是 counts），不傳的話那格永遠印 0，
    上面才剛寫「留言 64 則」，下面就變 0，自相矛盾。 %>
<%- include('partials/gbfoot', { total: counts.gb }) %>
<%- include('partials/foot2012in') %>
