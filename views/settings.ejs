<%# 個人設定
    ─────────────────────────────────────────────────────────────
    無名的設定在 www.wretch.cc/admin/ 底下，那幾頁沒有存檔（登入才看得到），
    所以這一頁沿用留言板骨架與原廠版型 skin 1/1911，表單則直接借用
    版型為「我要留言」準備好的那一套（#msg_added：標籤 105px 靠右、
    底線 #b8d7f0、表單頂端 msg_added_form.gif）——原站的表單長相就是這個。

    三個區塊標題逐字：網誌設定 / 網誌樣式 / 相簿設定（WRETCH_SPEC.md 5-8）。
    表單 action 與欄位 name 對應 src/server.js：
      POST /:name/settings          nick / intro / avatar / pass / pass2 / theme / css / music
      POST /:name/settings/delete   pass %>
<%- include('partials/head2012in', {
      title: '個人設定 - ' + u.nick + '的小站',
      page: 'w2-gb',
      skin: ['/wretch2012-skin-guestbook.css'] }) %>

<%- include('partials/gbtop', { here: 'settings', head: u.nick + ' 的小站' }) %>

<div id="msg_list">
  <div id="msg_added">
    <h2>個人設定</h2>
    <div class="msg_body">
      <form method="post" enctype="multipart/form-data">
        <ul>

          <li><div class="w2-h3">網誌設定</div></li>
          <li><span>帳號</span><b><%= u.name %></b> <span class="w2-sub">（不可更改）</span></li>
          <li><label for="set-nick">暱稱</label><input class="small-c" type="text" name="nick" id="set-nick" value="<%= u.nick %>" size="20" maxlength="20" required></li>
          <li><label for="set-intro">自我介紹</label><textarea class="small-c" name="intro" id="set-intro" cols="50" rows="4" maxlength="500"><%= u.intro %></textarea></li>
          <li><span>&nbsp;</span><span class="w2-sub">會出現在小站標題下方與名片上。</span></li>
          <li><span>大頭貼</span><img src="<%= u.avatar %>" width="90" height="90" alt="<%= u.nick %>"></li>
          <li><span>&nbsp;</span><input type="file" name="avatar" accept="image/*" id="set-avatar" aria-label="大頭貼檔案"> <span class="w2-sub">建議 90×90</span></li>
          <li><label for="set-oldpass">舊密碼</label>
            <input class="small-c" type="password" name="oldpass" id="set-oldpass" size="12" autocomplete="current-password">
            <span class="w2-sub">要換密碼才需要填</span></li>
          <li><label for="set-pass">新密碼</label>
            <input class="small-c" type="password" name="pass" id="set-pass" size="12" autocomplete="new-password">
            　<label for="set-pass2">再輸入一次</label>
            <input class="small-c" type="password" name="pass2" id="set-pass2" size="12" autocomplete="new-password">
            <span class="w2-sub">不改請留空</span></li>

          <%# ⚠ 這裡本來寫「網誌樣式／版面樣式」，但那兩個色票（粉紅／灰白）
              **只定義了相簿的 CSS**（src/skins.js 的 css:{album:...}）——
              網誌、留言板、名片、好友各自吃自己的原廠版型，不會跟著變。
              第一個真實使用者一打開就發現「明明寫粉紅是預設，畫面卻是灰藍色」。
              標籤說謊比少一個功能更糟，所以照它實際控制的東西改名。 %>
          <li><div class="w2-h3">相簿樣式</div></li>
          <li><span>相簿版型</span>
            <span class="w2-themepick">
              <% themes.forEach(t => { %><a href="#" data-theme="<%= t.id %>" class="<%= (u.theme||'')===t.id ? 'on' : '' %>"><span class="sw"><i style="background:<%= t.swatch[0] %>"></i><i style="background:<%= t.swatch[1] %>"></i></span><%= t.name %></a><% }) %>
            </span>
            <input type="hidden" name="theme" value="<%= u.theme || '' %>">
          </li>
          <li><span>&nbsp;</span><span class="w2-sub">只換<a href="/<%= u.name %>/album">相簿</a>的版型。網誌、留言板、名片、好友各有自己的原廠版型，要改請用下面的自訂樣式。</span></li>
          <li><label for="set-css">相簿自訂樣式</label>
            <textarea class="small-c" name="css" id="set-css" cols="60" rows="8" maxlength="20000" placeholder="/* 相簿與其餘頁面的專屬 CSS，例如 */&#10;body{background:#000}&#10;#content{background:#333}"><%= u.css %></textarea></li>
          <li><span>&nbsp;</span><span class="w2-sub">套在相簿與其餘頁面上，蓋得過預設版型。玩壞了清空即可復原。</span></li>

          <li><div class="w2-h3">網誌樣式</div></li>
          <li><label for="set-cssblog">網誌自訂樣式</label>
            <textarea class="small-c" name="css_blog" id="set-cssblog" cols="60" rows="8" maxlength="20000" placeholder="/* 只套在網誌上的 CSS */&#10;.title a{color:#c8508c}"><%= locals.u.css_blog || '' %></textarea></li>
          <li><span>&nbsp;</span><span class="w2-sub">原站的自訂樣式本來就是兩份（album.css 與 blog.css），網誌可以跟相簿長得完全不一樣。留空的話沿用上面那份。</span></li>

          <li><div class="w2-h3">相簿設定</div></li>
          <li><label for="set-music">音樂盒</label>
            <textarea class="small-c" name="music" id="set-music" cols="50" rows="4" maxlength="2000" placeholder="一行一個 mp3 網址，可放多首組成播放清單"><%= u.music %></textarea></li>
          <li><span>&nbsp;</span><span class="w2-sub">一行一首。放在小站側欄，訪客可切換曲目。</span></li>
          <li><span>相簿權限</span>每本相簿的密碼、好友限定、封面、站內分類與地區，
            請到 <a href="/<%= u.name %>/album">相簿</a> 頁各本相簿自己設定。</li>
          <li><span>快速入口</span><a href="/<%= u.name %>/album">上傳照片</a>　<a href="/<%= u.name %>/blog/new">發表文章</a></li>

          <li><span>&nbsp;</span><input class="small-c" type="submit" value="儲存設定"></li>
        </ul>
      </form>

      <%# ── 網誌側欄的自訂欄位（原站的 #boxFolder）──────────────────────
          ⚠ 這一段**一定要在上面那個 <form> 外面**：HTML 不允許表單巢狀，
          塞進去的話瀏覽器會把內層的 form 丟掉，按鈕全部變成送出外層那一份
          （＝按「刪除欄位」其實是在存設定）。 %>
      <%# ── 我的訂閱（原站側欄的 #boxRssList）───────────────────────── %>
      <div class="w2-h3" id="subs">我的訂閱</div>
      <div class="w2-sub">
        訂閱別人的 RSS，最新一則會出現在你的網誌側欄。站內的網誌都有 RSS，
        網址是 <code>/帳號/blog/rss</code>。最多 <%= 5 %> 個。
      </div>
      <ul class="w2-form">
<% (locals.subs || []).forEach(s => { %>
        <li>
          <span><%= s.title %></span>
          <span class="w2-sub"><%= s.url %><br>
            <% if (s.last_title) { %>最新：<%= s.last_title %><% } else { %>還沒抓到內容（下次進網誌頁時會再試一次）<% } %></span>
          <form method="post" action="/<%= u.name %>/subs/<%= s.id %>/del"
                onsubmit="return confirm('取消訂閱？')"><button class="w2-linkbtn" type="submit">取消訂閱</button></form>
        </li>
<% }) %>
<% if ((locals.subs || []).length < 5) { %>
        <li>
          <form method="post" action="/<%= u.name %>/subs">
            <input type="text" name="title" placeholder="來源名稱，例如 站方公告" aria-label="訂閱來源名稱" maxlength="30" size="18">
            <input type="text" name="url" placeholder="https://…/rss" aria-label="訂閱的 RSS 網址" size="30">
            <input class="small-c" type="submit" value="訂閱">
          </form>
        </li>
<% } %>
      </ul>

      <div class="w2-h3" id="folders">網誌側欄自訂欄位</div>
      <div class="w2-sub">
        原站叫「自訂欄位」，可以在網誌側欄多開幾塊自己的區塊（About Me、線上人數…）。
        原站能貼任意 HTML，本站一律逸出，改用站上通用的標記：
        <code>[img]網址[/img]</code>、<code>[b]粗體[/b]</code>、網址會自動變連結。
        最多 <%= 8 %> 塊。
      </div>
      <ul class="w2-form">
<% (locals.folders || []).forEach(fd => { %>
        <li>
          <form method="post" action="/<%= u.name %>/folders/<%= fd.id %>/edit">
            <input type="text" name="title" value="<%= fd.title %>" maxlength="30" size="20" aria-label="自訂欄位標題">
            <textarea class="small-c" name="body" cols="50" rows="3" maxlength="5000" aria-label="自訂欄位內容"><%= fd.body %></textarea>
            <input class="small-c" type="submit" value="儲存">
          </form>
          <form method="post" action="/<%= u.name %>/folders/<%= fd.id %>/del"
                onsubmit="return confirm('刪除這個欄位？')"><button class="w2-linkbtn" type="submit">刪除</button></form>
        </li>
<% }) %>
<% if ((locals.folders || []).length < 8) { %>
        <li>
          <form method="post" action="/<%= u.name %>/folders">
            <input type="text" name="title" placeholder="欄位標題，例如【About Me】" maxlength="30" size="20" aria-label="自訂欄位標題">
            <textarea class="small-c" name="body" cols="50" rows="3" maxlength="5000" placeholder="內容。可用 [img]網址[/img] 放圖，網址會自動變連結" aria-label="自訂欄位內容"></textarea>
            <input class="small-c" type="submit" value="新增欄位">
          </form>
        </li>
<% } %>
      </ul>
    </div>
  </div>
</div>

<div class="msg_body">
  <div class="w2-h3">刪除帳號</div>
  <div class="w2-sub">刪除後你的相簿、照片、網誌、留言板都會一起消失，無法復原。</div>
  <form method="post" action="/<%= u.name %>/settings/delete" onsubmit="return confirm('真的要刪除帳號嗎？所有內容都會消失，無法復原。')">
    輸入密碼確認：<input class="small-c" type="password" name="pass" size="14" required aria-label="輸入密碼以確認刪除帳號">
    <input class="small-c" type="submit" value="永久刪除我的帳號">
  </form>
</div>

<script>
document.addEventListener('click',function(e){
  var a=e.target.closest('.w2-themepick a'); if(!a) return; e.preventDefault();
  document.querySelectorAll('.w2-themepick a').forEach(function(x){ x.classList.remove('on'); });
  a.classList.add('on');
  document.querySelector('input[name=theme]').value=a.getAttribute('data-theme');
});
</script>

<%- include('partials/gbfoot') %>
<%- include('partials/foot2012in') %>
