<%
  /* 免費註冊
     ─────────────────────────────────────────────────────────────
     與 login.ejs 同樣是刻意偏離：2012 年無名沒有自己的註冊頁，
     Register 連結一樣導去 Yahoo 帳號系統。理由與樣式來源見 login.ejs 檔頭。

     表單對應 src/server.js 的 app.post('/register')：
     欄位 name / nick / pass / pass2，帳號限 3~20 位英數字或底線。
     出錯時 server 會把使用者填過的值放在 form 裡回傳，要填回去，
     不然使用者每錯一次就要全部重打。 */
  const f = locals.form || {};
%>
<%- include('partials/head2012', { title: '免費註冊 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>免費註冊</h2></div>
        <div class="bd">

          <% if (err) { %><p class="w2-auth-err"><%= err %></p><% } %>

          <form action="/register" method="POST">
            <table class="w2-auth-form">
              <tr>
                <th><label for="w2-name">帳號</label></th>
                <td>
                  <input type="text" id="w2-name" name="name" size="24" value="<%= f.name || '' %>" autofocus>
                  <span class="w2-auth-hint">3~20 位英數字或底線，之後就是你的小站網址</span>
                </td>
              </tr>
              <tr>
                <th><label for="w2-nick">暱稱</label></th>
                <td>
                  <input type="text" id="w2-nick" name="nick" size="24" value="<%= f.nick || '' %>">
                  <span class="w2-auth-hint">顯示在小站與留言上的名字</span>
                </td>
              </tr>
              <tr>
                <th><label for="w2-pass">密碼</label></th>
                <td>
                  <input type="password" id="w2-pass" name="pass" size="24" autocomplete="new-password">
                  <span class="w2-auth-hint">至少 4 個字</span>
                </td>
              </tr>
              <tr>
                <th><label for="w2-pass2">確認密碼</label></th>
                <td><input type="password" id="w2-pass2" name="pass2" size="24" autocomplete="new-password"></td>
              </tr>
              <tr>
                <th></th>
                <td>
                  <button type="submit" class="w2-btn">送出</button>
                  <a class="w2-auth-alt" href="/login">已經有帳號了</a>
                </td>
              </tr>
            </table>
          </form>

        </div>
      </div>

    </div>

    <div class="side">
      <div class="mod w2-auth-side">
        <div class="hd"><h2>註冊之後可以做什麼</h2></div>
        <div class="bd">
          <ul>
            <li>開自己的<strong>相簿</strong>，整本或單張都能上鎖</li>
            <li>寫<strong>網誌</strong>，單篇可以設密碼，只給想看的人看</li>
            <li>有自己的<strong>留言板</strong>與<strong>名片</strong></li>
            <li>加好友、看好友動態、收藏別人的文章</li>
            <li>換版面樣式，也可以自己寫 CSS</li>
          </ul>
          <p class="w2-auth-cta">完全免費，不放廣告。</p>
        </div>
      </div>
    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
