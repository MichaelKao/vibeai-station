<%
  /* 網誌總站 /blogs
     ─────────────────────────────────────────────────────────────
     這一頁**不是**個人網誌頁，所以不吃 750px 的 skin117 版型，
     跟首頁、登入、註冊一樣走 2012 的站台外框（partials/head2012 + foot2012 ＋
     public/wretch2012.css 的 .mod / .main / .side 模組語言）。

     為什麼不照抄原站的 /blog/：那一頁載的是 2008 年的
     l.yimg.com/e/serv/index/blog/css/{layout,style}.css（原始檔已經收在
     assets_src2/css/assets_l_index-blog-css_*.css），但它引用的 27 張
     ../img/*.gif 一張都還沒抓，也還沒有對應的 bundle。
     在素材補齊、build-css2012.mjs 加一組 bundle 之前，先用站台既有的元件語言組，
     不自創新的視覺。這件事列在回報的「還沒做」清單。

     資料來自 src/server.js 的 app.get('/blogs')：
       topic / page / pages / total / topics（BLOG_TOPICS 12 類）/ counts / posts。

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const CAP = (s, n) => {
    const t = String(s || '')
      .replace(/\[img\][\s\S]*?\[\/img\]/gi, '')
      .replace(/\[[^\[\]\n]{1,40}\]/g, '')
      .replace(/\s+/g, ' ').trim();
    return t.length > n ? t.slice(0, n) + '  ...' : t;
  };
  const qs = p => '/blogs?p=' + p + (topic ? '&topic=' + encodeURIComponent(topic) : '');
  const COVER = '/img/wretch2012/blog/user_cover.gif';
%>
<%- include('partials/head2012', { title: (topic ? topic + ' - ' : '') + '網誌 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2><%= topic || '熱門網誌' %></h2></div>
        <div class="bd">

          <p class="w2-blog-count">共 <b><%= total %></b> 篇文章<% if (topic) { %>　<a href="/blogs">看全部分類</a><% } %></p>

          <% if (!posts.length) { %>
          <p>這個分類還沒有文章。<a href="/register">開一個帳號</a>，第一篇就是你的。</p>
          <% } %>

          <ol class="w2-bloglist">
            <% posts.forEach(p => { %>
            <li>
              <a class="thumbnail" href="/<%= p.uname %>/blog/<%= p.id %>"><img src="<%= COVER %>" width="85" height="85" alt=""></a>
              <div class="content">
                <p class="meta">
                  <a class="uname" href="/<%= p.uname %>"><%= p.uname %></a>
                  <% if (p.topic) { %><a class="topic" href="/blogs?topic=<%= encodeURIComponent(p.topic) %>"><%= p.topic %></a><% } %>
                </p>
                <h3><a class="skin-main-link" href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></h3>
                <p class="description"><%= CAP(p.body, 90) %>
                  <a href="/<%= p.uname %>/blog/<%= p.id %>">(繼續閱讀)</a></p>
                <p class="stat">
                  <a href="/<%= p.uname %>/blog/<%= p.id %>#postComments">回應(<%= p.nc %>)</a>
                  <span>得點: <%= p.views * 10 + p.likes * 50 %></span>
                </p>
              </div>
            </li>
            <% }) %>
          </ol>

          <% if (pages > 1) { %>
          <div class="w2-pager">
            <% if (page > 1) { %><a href="<%= qs(page-1) %>">上一頁</a><% } %>
            <% for (let i=1; i<=pages; i++) { %><% if (i === page) { %><b><%= i %></b><% } else { %><a href="<%= qs(i) %>"><%= i %></a><% } %><% } %>
            <% if (page < pages) { %><a href="<%= qs(page+1) %>">下一頁</a><% } %>
          </div>
          <% } %>

        </div>
      </div>

    </div>
    <div class="side">

      <div class="mod w2-auth-side">
        <div class="hd"><h2>網誌站內分類</h2></div>
        <div class="bd">
          <ul>
            <% topics.forEach(t => { %>
            <li><a href="/blogs?topic=<%= encodeURIComponent(t) %>"><% if (topic === t) { %><b><%= t %></b><% } else { %><%= t %><% } %></a>
              <span class="w2-blog-n">(<%= counts[t] || 0 %>)</span></li>
            <% }) %>
          </ul>
        </div>
      </div>

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/search">站內搜尋</a></li>
            <li><a href="/help">服務說明</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
