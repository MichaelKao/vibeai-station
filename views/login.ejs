<%
  /* 會員登入
     ─────────────────────────────────────────────────────────────
     原站沒有這一頁：2012 年無名的 Login / Register 兩個連結都指向
     www.wretch.cc/IDintegration/，302 轉去 Yahoo!奇摩的登入頁
     （assets_src2/spec/chrome.md 第 7 節有原始 HTML 與逐字欄位）。

     本站有自己的會員系統，一定要有這頁，所以這是**刻意偏離原站**。
     做法是只用 2012 既有的元件語言組出來——.mod 卡片框、.hd h2 標題、
     my-promotion 的按鈕漸層——不自創新的視覺，樣式集中在 wretch2012-site.css
     的「刻意偏離」段落，每條都有理由。

     表單對應 src/server.js 的 app.post('/login')：欄位 name / pass / next。 */
%>
<%- include('partials/head2012', { title: '會員登入 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>會員登入</h2></div>
        <div class="bd">

          <% if (err) { %><p class="w2-auth-err"><%= err %></p><% } %>

          <form action="/login" method="POST">
            <input type="hidden" name="next" value="<%= locals.next || '' %>">
            <table class="w2-auth-form">
              <tr>
                <th><label for="w2-name">帳號</label></th>
                <td><%# ⚠ 一定要回填。原本登入失敗後帳號欄是空的，每試一次密碼就要重打一次帳號。 %>
                    <input type="text" id="w2-name" name="name" size="24" autocomplete="username" value="<%= locals.name || '' %>" autofocus></td>
              </tr>
              <tr>
                <th><label for="w2-pass">密碼</label></th>
                <td><input type="password" id="w2-pass" name="pass" size="24" autocomplete="current-password"></td>
              </tr>
              <%# 這裡本來有一個「記住我的帳號」checkbox（name=remember）。
                  拿掉的理由：src/server.js 的 app.post('/login') 從頭到尾沒有讀 remember，
                  勾不勾結果都一樣——而且 session cookie 本來就設 maxAge 30 天，
                  不勾也會記住。留著等於給使用者一顆按了沒有反應的開關。
                  真的要做「不要記住我」的話得先讓後端支援 session cookie 改成
                  browser-session，屆時再連同這個欄位一起加回來。 %>
              <tr>
                <th></th>
                <td>
                  <button type="submit" class="w2-btn">登入</button>
                  <a class="w2-auth-alt" href="/register">免費註冊</a>
                </td>
              </tr>
            </table>
          </form>

        </div>
      </div>

    </div>

    <div class="side">
      <div class="mod w2-auth-side">
        <div class="hd"><h2>一個帳號，多項功能</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/albums">個人相簿</a>　放照片、分相簿、可以上鎖</li>
            <li><a href="/blogs">個人網誌</a>　寫文章、貼圖、單篇可設密碼</li>
            <li><a href="/rank">個人留言板</a>　朋友來留言，可以寫悄悄話</li>
          </ul>
          <p class="w2-auth-cta"><a href="/register">還沒有帳號？免費註冊一個</a>
            <%# 忘記密碼的入口一定要在登入頁上——那正是使用者發現自己
                忘記密碼的那一刻。藏在 /help 裡等於沒有。 %>
            &nbsp;·&nbsp;<a href="/forgot">忘記密碼？</a></p>
        </div>
      </div>
    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
