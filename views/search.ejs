<%
  /* 站內搜尋 /search
     ─────────────────────────────────────────────────────────────
     跟 views/rank.ejs 同一個理由（見那一支的檔頭）：這一頁原本吃
     partials/head（2005 綠版），但 2012 外框**每一頁**右上角的搜尋框
     都送到這裡（partials/head2012.ejs 的 form action="/search"），
     首頁的深色站內搜尋條也是。搜一次就從 2012 掉進 2005，
     是整站被踩最多次的混搭，所以改成 2012 的外框與元件。

     原站的搜尋結果頁沒有存檔（Yahoo 搜尋是另一個網域），照 §3-A
     用既有元件組，不自創新的視覺。

     表單契約不動：action="/search"、GET、欄位名 q
     （src/server.js 的 app.get('/search') 只讀 q）。

     資料來自 app.get('/search')：k / users / albums / posts。 */
  const seTotal = users.length + albums.length + posts.length;
%>
<%- include('partials/head2012', { title: (k ? k + ' - ' : '') + '搜尋 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>站內搜尋</h2></div>
        <div class="bd">

          <form action="/search" method="GET" class="w2-searchform">
            <input type="text" name="q" value="<%= k %>" size="24" maxlength="40"
                   placeholder="找相簿 / 找文章 / 找朋友" autofocus>
            <input type="submit" class="w2-btn" value="搜尋">
          </form>

          <% if (k) { %>
          <p class="w2-blog-count">「<%= k %>」找到 <b><%= seTotal %></b> 筆</p>
          <% } else { %>
          <p class="w2-blog-count">輸入關鍵字，會同時找站友、相簿與網誌文章。</p>
          <% } %>

        </div>
      </div>

      <% if (k) { %>

      <div class="mod w2-auth" id="users">
        <div class="hd"><h2>站友（<%= users.length %>）</h2></div>
        <div class="bd">
          <% if (!users.length) { %><p class="w2-note">找不到相符的站友。</p><% } %>
          <ol class="w2-ranklist">
            <% users.forEach(x => { %>
            <li>
              <a class="ava" href="/<%= x.name %>"><img src="<%= x.avatar %>" width="20" height="20" alt="<%= x.nick %>"></a>
              <span class="num">
                <a href="/<%= x.name %>/album">相簿</a>
                <a href="/<%= x.name %>/blog">網誌</a>
                <a href="/<%= x.name %>/guestbook">留言板</a>
              </span>
              <a href="/<%= x.name %>"><%= x.nick %></a>
              <span class="w2-blog-n">(<%= x.name %>)</span>
            </li>
            <% }) %>
          </ol>
        </div>
      </div>

      <div class="mod w2-auth" id="albums">
        <div class="hd"><h2>相簿（<%= albums.length %>）</h2></div>
        <div class="bd">
          <% if (!albums.length) { %><p class="w2-note">找不到相符的相簿。</p><% } %>
          <ul class="w2-albumgrid">
            <% albums.forEach(a => { %>
            <li>
              <a href="/<%= a.uname %>/album/<%= a.id %>" title="<%= a.title %>">
                <img src="<%= a.cover || (CDN + '/icon/user_cover.gif') %>" alt="<%= a.title %>">
              </a>
              <a class="t" href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a>
              <span class="n"><%= a.views %> 人次</span>
              <a class="n" href="/<%= a.uname %>"><%= a.uname %></a>
            </li>
            <% }) %>
          </ul>
          <% if (albums.length) { %><p class="w2-more"><a href="/albums">更多相簿</a></p><% } %>
        </div>
      </div>

      <div class="mod w2-auth" id="posts">
        <div class="hd"><h2>網誌（<%= posts.length %>）</h2></div>
        <div class="bd">
          <% if (!posts.length) { %><p class="w2-note">找不到相符的文章。</p><% } %>
          <ol class="w2-bloglist w2-nothumb">
            <% posts.forEach(p => { %>
            <li>
              <div class="content">
                <p class="meta">
                  <a class="uname" href="/<%= p.uname %>"><%= p.uname %></a>
                  <span class="topic"><%= p.created.slice(0, 10) %></span>
                  <%# 上鎖的文章只比對標題（src/server.js 的查詢），內文不會外流，
                      這裡標出來讓人知道點進去要輸入密碼。 %>
                  <% if (p.pass) { %><span class="topic">（上鎖）</span><% } %>
                </p>
                <h3><a class="skin-main-link" href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></h3>
              </div>
            </li>
            <% }) %>
          </ol>
          <% if (posts.length) { %><p class="w2-more"><a href="/blogs">更多網誌</a></p><% } %>
        </div>
      </div>

      <% } %>

    </div>
    <div class="side">

      <% if (k) { %>
      <div class="mod w2-auth-side">
        <div class="hd"><h2>搜尋結果</h2></div>
        <div class="bd">
          <ul>
            <li><a href="#users">站友（<%= users.length %>）</a></li>
            <li><a href="#albums">相簿（<%= albums.length %>）</a></li>
            <li><a href="#posts">網誌（<%= posts.length %>）</a></li>
          </ul>
        </div>
      </div>
      <% } %>

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/video">影音</a></li>
            <li><a href="/join">揪團</a></li>
            <li><a href="/digu">嘀咕</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
