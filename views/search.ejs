<%
  /* 站內搜尋 /search
     ─────────────────────────────────────────────────────────────
     跟 views/rank.ejs 同一個理由（見那一支的檔頭）：這一頁原本吃
     partials/head（2005 綠版），但 2012 外框**每一頁**右上角的搜尋框
     都送到這裡（partials/head2012.ejs 的 form action="/search"），
     首頁的深色站內搜尋條也是。搜一次就從 2012 掉進 2005，
     是整站被踩最多次的混搭，所以改成 2012 的外框與元件。

     原站的搜尋結果頁沒有存檔（Yahoo 搜尋是另一個網域），照 §3-A
     用既有元件組，不自創新的視覺。

     表單契約：action="/search"、GET、欄位名 q ＋ type（搜尋範圍）。

     ⚠ type 這個欄位原本是**擺著好看的**——views/albums.ejs 頁首那四顆
     radio（相簿／網誌／影音／網頁）印出來了，但 src/server.js 的
     app.get('/search') 根本沒讀它，點哪一顆結果都一樣。使用者的感受
     就是「那排頁籤不能點」。現在後端真的分範圍，這一頁也把範圍做成
     **純連結**的頁籤：沒有 JS 也切得動，網址可以直接分享。

     資料來自 app.get('/search')：k / type / users / albums / posts / videos。 */
  const seC = locals.counts || { users: users.length, albums: albums.length, posts: posts.length, videos: 0 };
  const seV = locals.videos || [];
  /* 標題的數字要用**真的命中數**（後端傳來的 counts），不是這一頁的筆數。
     各區各自 LIMIT 30，用 .length 的話搜到 2000 筆也只會顯示 30。 */
  const seTotal = seC.users + seC.albums + seC.posts + seC.videos;
  const seType  = locals.type || '';
  /* 值照抄原站的 name=type。'' ＝ 全部；'web' 原站是送去 Yahoo 網頁搜尋，
     本站不連外，當成全部。 */
  const seTabs = [['', '全部'], ['photo', '相簿'], ['site', '網誌'], ['video', '影音'], ['web', '網頁']];
  const seQ    = t => '/search?q=' + encodeURIComponent(k) + (t ? '&type=' + t : '');
  const seShow = s => !seType || seType === 'web'
                   || ({ photo: 'albums', site: 'posts', article: 'posts', video: 'videos' })[seType] === s;
%>
<%- include('partials/head2012', { title: (k ? k + ' - ' : '') + '搜尋 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>站內搜尋</h2></div>
        <div class="bd">

          <form action="/search" method="GET" class="w2-searchform">
            <input type="text" name="q" value="<%= k %>" size="24" maxlength="40"
                   placeholder="找相簿 / 找文章 / 找朋友" autofocus>
            <input type="submit" class="w2-btn" value="搜尋">
            <%# 目前的範圍要跟著表單走，不然在結果頁重搜一次會跳回「全部」 %>
            <% if (seType) { %><input type="hidden" name="type" value="<%= seType %>"><% } %>
          </form>

          <% if (k) { %>
          <p class="w2-search-scope">
<%# article 是個人頁搜尋列用的別名，等同 site，頁籤要標在「網誌」那顆上 %>
<% const seOn = seType === 'article' ? 'site' : seType; %>
<% seTabs.forEach(t => { %>            <a href="<%= seQ(t[0]) %>"<% if (seOn === t[0]) { %> class="on"<% } %>><%= t[1] %></a>
<% }) %>          </p>
          <p class="w2-blog-count">「<%= k %>」找到 <b><%= seTotal %></b> 筆</p>
          <% } else { %>
          <p class="w2-blog-count">輸入關鍵字，會同時找站友、相簿、網誌文章與影音。</p>
          <% } %>

        </div>
      </div>

      <% if (k) { %>

      <% if (seShow('users')) { %>
      <div class="mod w2-auth" id="users">
        <div class="hd"><h2>站友（<%= seC.users %>）</h2></div>
        <div class="bd">
          <% if (!users.length) { %><p class="w2-note">找不到相符的站友。</p><% } %>
          <ol class="w2-ranklist">
            <% users.forEach(x => { %>
            <li>
              <a class="ava" href="/<%= x.name %>"><img src="<%= x.avatar %>" width="20" height="20" alt="<%= x.nick %>"></a>
              <span class="num">
                <a href="/<%= x.name %>/album">相簿</a>
                <a href="/<%= x.name %>/blog">網誌</a>
                <a href="/<%= x.name %>/guestbook">留言板</a>
              </span>
              <a href="/<%= x.name %>"><%= x.nick %></a>
              <span class="w2-blog-n">(<%= x.name %>)</span>
            </li>
            <% }) %>
          </ol>
        </div>
      </div>
      <% } %>

      <% if (seShow('albums')) { %>
      <div class="mod w2-auth" id="albums">
        <div class="hd"><h2>相簿（<%= seC.albums %>）</h2></div>
        <div class="bd">
          <% if (!albums.length) { %><p class="w2-note">找不到相符的相簿。</p><% } %>
          <ul class="w2-albumgrid">
            <% albums.forEach(a => { %>
            <li>
              <a href="/<%= a.uname %>/album/<%= a.id %>" title="<%= a.title %>">
                <img src="<%= a.cover || '/img/wretch2012/blog/user_cover.gif' %>" alt="<%= a.title %>">
              </a>
              <a class="t" href="/<%= a.uname %>/album/<%= a.id %>"><%= a.title %></a>
              <span class="n"><%= a.views %> 人次</span>
              <a class="n" href="/<%= a.uname %>"><%= a.uname %></a>
            </li>
            <% }) %>
          </ul>
          <% if (albums.length) { %><p class="w2-more"><a href="/albums">更多相簿</a></p><% } %>
        </div>
      </div>
      <% } %>

      <% if (seShow('posts')) { %>
      <div class="mod w2-auth" id="posts">
        <div class="hd"><h2>網誌（<%= seC.posts %>）</h2></div>
        <div class="bd">
          <% if (!posts.length) { %><p class="w2-note">找不到相符的文章。</p><% } %>
          <ol class="w2-bloglist w2-nothumb">
            <% posts.forEach(p => { %>
            <li>
              <div class="content">
                <p class="meta">
                  <a class="uname" href="/<%= p.uname %>"><%= p.uname %></a>
                  <span class="topic"><%= p.created.slice(0, 10) %></span>
                  <%# 上鎖的文章只比對標題（src/server.js 的查詢），內文不會外流，
                      這裡標出來讓人知道點進去要輸入密碼。 %>
                  <% if (p.pass) { %><span class="topic">（上鎖）</span><% } %>
                </p>
                <h3><a class="skin-main-link" href="/<%= p.uname %>/blog/<%= p.id %>"><%= p.title %></a></h3>
              </div>
            </li>
            <% }) %>
          </ol>
          <% if (posts.length) { %><p class="w2-more"><a href="/blogs">更多網誌</a></p><% } %>
        </div>
      </div>
      <% } %>

      <% if (seShow('videos')) { %>
      <div class="mod w2-auth" id="videos">
        <div class="hd"><h2>影音（<%= seC.videos %>）</h2></div>
        <div class="bd">
          <% if (!seV.length) { %><p class="w2-note">找不到相符的影音。</p><% } %>
          <ol class="w2-bloglist w2-nothumb">
            <% seV.forEach(v => { %>
            <li>
              <div class="content">
                <p class="meta"><a class="uname" href="/<%= v.uname %>"><%= v.uname %></a>
                  <span class="topic"><%= v.views %> 人次</span></p>
                <%# 單支影音沒有獨立頁面（只有 /:name/video 列表），連到那個人的影音頁 %>
                <h3><a class="skin-main-link" href="/<%= v.uname %>/video"><%= v.title %></a></h3>
              </div>
            </li>
            <% }) %>
          </ol>
          <% if (seV.length) { %><p class="w2-more"><a href="/video">更多影音</a></p><% } %>
        </div>
      </div>
      <% } %>

      <% } %>

    </div>
    <div class="side">

      <%# 縮了範圍就不印這一塊：範圍外的 count 一律是 0（後端根本沒查），
          印出來會變成「站友（0）」但其實有七個，比不印更誤導。 %>
      <% if (k && (!seType || seType === 'web')) { %>
      <div class="mod w2-auth-side">
        <div class="hd"><h2>搜尋結果</h2></div>
        <div class="bd">
          <ul>
            <li><a href="<%= seQ('') %>#users">站友（<%= seC.users %>）</a></li>
            <li><a href="<%= seQ('') %>#albums">相簿（<%= seC.albums %>）</a></li>
            <li><a href="<%= seQ('') %>#posts">網誌（<%= seC.posts %>）</a></li>
            <li><a href="<%= seQ('') %>#videos">影音（<%= seC.videos %>）</a></li>
          </ul>
        </div>
      </div>
      <% } %>

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/video">影音</a></li>
            <li><a href="/join">揪團</a></li>
            <li><a href="/digu">嘀咕</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
