<%
  /* 通用訊息頁：找不到頁面／沒有權限／好友限定／空間不足／已送出檢舉／人數已滿。
     ─────────────────────────────────────────────────────────────
     ⚠ 這一頁本來還掛在 **2005 版的外框**（partials/head + sitetop + sitefoot + foot），
     所以只要被擋一次——好友限定 403、空間不足、非站主、404——整站就從 2012 的皮
     跳回 2005 的綠色 table 版，一眼就看得出是兩個時代的東西拼起來的。
     全站早就統一 2012（WRETCH_2012.md §1-B），這頁是漏網的。

     改成跟登入／註冊同一組站台外框（partials/head2012 + foot2012），
     並沿用 wretch2012.css 的 .mod / .main / .side 模組語言，不自創視覺。

     為什麼不用個人小站的外框（head2012in）：被擋下來的人**不一定看得到那個小站**
     （好友限定就是最典型的），套上人家的版型與側欄反而奇怪。站台外框最中性。

     「回上一頁」的落點：路由多半會帶 back 進來；沒帶的時候（例如 src/auth.js 的
     requireOwner）有 u 就退回那個小站的門口——使用者是在別人的小站上被擋的，
     丟回站台首頁等於要他重走一遍。 */
  const backUrl = (typeof back !== 'undefined' && back) ? back
                : (locals.u ? '/' + u.name : '/');
%>
<%- include('partials/head2012', { title: title + ' - ' + SITE_NAME }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2><%= title %></h2></div>
        <div class="bd">
          <p class="w2-msg"><%= msg %></p>
          <p class="w2-msg-back"><a href="<%= backUrl %>">回上一頁</a>
            <% if (locals.u) { %>　<a href="/<%= u.name %>"><%= u.nick %> 的小站</a><% } %>
            　<a href="/">回首頁</a></p>
        </div>
      </div>

    </div>
    <div class="side">
      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/help">服務說明</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
