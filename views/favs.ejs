<%# 我的收藏 — 收藏的網誌文章
    無名的「收藏」在 2012 是網誌文章下的一顆按鈕，沒有獨立版型，
    這一頁沿用留言板骨架與原廠版型 skin 1/1911（同 views/home.ejs 的取捨）。 %>
<%- include('partials/head2012in', {
      title: u.nick + '的收藏 - 無名小站',
      page: 'w2-gb',
      skin: ['/wretch2012-skin-guestbook.css'] }) %>

<%- include('partials/gbtop', { here: 'favs', head: u.nick + ' 的收藏' }) %>

<div id="search">共 <b><%= total %></b> 篇</div>

<div class="msg_body">
  <% if (!favs.length) { %>
  <div class="w2-empty">目前沒有收藏的文章。<br>看到喜歡的文章可以按「收藏」。</div>
  <% } else { %>
  <table class="w2-rows">
    <% favs.forEach(f => { %>
    <tr>
      <td><a href="/<%= f.uname %>/blog/<%= f.id %>"><%= f.title %></a>
        <span class="w2-sub">by <a href="/<%= f.uname %>"><%= f.nick %></a></span></td>
      <td class="w2-when"><%= f.created.slice(0,10) %></td>
    </tr>
    <% }) %>
  </table>
  <%# 分頁：收藏原本硬砍 100 筆，第 101 篇之後看不到。 %>
  <%- include('partials/pager2012', { pgPage: page, pgPages: pages,
        pgHref: n => '/' + u.name + '/favs?p=' + n }) %>
  <% } %>
</div>

<%- include('partials/gbfoot') %>
<%- include('partials/foot2012in') %>
