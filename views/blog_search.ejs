<%
  /* 搜尋這個網誌的結果（無名小站 2012 最後版）
     ─────────────────────────────────────────────────────────────
     原站側欄 #boxSearch 送出後回到 blog.php 的「列表模式」，
     版面就是 spec/blog.md 第 8-5 節那一種：

       .date > .datediv（放這一頁的標題，例如原站的 `Category: 搞笑影片`）
       .blogbody > .blogbody2 > .articletext
         .list-linkcontrol（分頁）＋ <table> 一列一篇：日期 + 標題 + 作者

     列表模式的日期格式是 YYYY.MM.DD（跟文章區的 Month D, YYYY 不同），照抄。
     外面那層 <form action="do_modify.php"> 是原站給站長批次刪除用的，
     本站沒有這個功能就不放。

     表單 action／method／欄位 name 沿用原本的：GET /:name/blog/search 的 q 與 body。
     ☑標題 ☐內容：src/server.js 兩種模式都一定比對標題，勾了「內容」才多送 body=1，
     所以「標題」那格固定勾選且不送出。

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const wDot  = s => String(s).slice(0,4) + '.' + String(s).slice(5,7) + '.' + String(s).slice(8,10);
  const IMG   = '/img/wretch2012/blog';
%>
<%- include('partials/blog2012_head', { title: '搜尋本站 - ' + u.nick + ' - 無名小站',
                                        artTitle: k ? '搜尋：' + k : '搜尋本站', medium: '' }) %>

<div id="content">
<input type="hidden" name="check_url" value="on">
<div class="blog" >

      <div class="date">
        <div class="datediv">
          搜尋本站        </div>
      </div>

      <div class="blogbody">
        <div class="blogbody2">
          <div class="articletext" >
            <br />
            <form action="/<%= u.name %>/blog/search" method="get">
              <input name="q" type="text" size="20" maxlength="30" value="<%= k %>">
              <input type="submit" value="搜尋">
              <br />
              <input type="checkbox" class="blog_search_filter" value="1" checked disabled>標題
              <input type="checkbox" name="body" class="blog_search_filter" value="1" <%= inBody ? 'checked' : '' %>>內容
            </form>
            <br />

            <% if (k) { %>
            <p>「<b><%= k %></b>」找到 <b><%= rows.length %></b> 篇</p>
            <table>
              <% rows.forEach(p => { %>
              <tr>
                <td nowrap>
                <%= wDot(p.created) %> <% if (p.pass) { %><img src="<%= IMG %>/lock.gif" width="21" height="16" border="0" align="absmiddle" alt="[鎖]"><% } %><a href="/<%= u.name %>/blog/<%= p.id %>"><%= p.title %></a>
                </td>
                <td><a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(p.category) %>"><%= p.category %></a></td>
              </tr>
              <% }) %>
              <% if (!rows.length) { %>
              <tr><td nowrap>找不到符合的文章</td><td></td></tr>
              <% } %>
            </table>
            <br />
            <% } %>
          </div>
        </div>
      </div>

</div> <!-- end of class=blog -->
</div> <!-- end of content -->

<div id="links">

  <div id="links2">
  <%- include('partials/blogside') %>
  </div> <!-- end of links2 -->

</div> <!-- end of links -->

<%- include('partials/blog2012_foot') %>
