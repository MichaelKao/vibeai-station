<%
  /* 重設密碼 /reset/:token
     ─────────────────────────────────────────────────────────────
     跟 forgot.ejs 同一組（原站沒有這一頁，見那一支的說明）。

     token 從網址來，這一頁只負責收新密碼。**不印 token 本身**，
     只放進表單的 action——印在畫面上的話，使用者截圖分享就等於把
     重設連結交出去。 */
%>
<%- include('partials/head2012', { title: '重設密碼 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>重設密碼</h2></div>
        <div class="bd">

          <% if (!token) { %>
          <p class="w2-formerr"><%= err %></p>
          <p><a href="/forgot">重新申請一次</a>　·　<a href="/login">回登入頁</a></p>

          <% } else { %>
          <% if (err) { %><p class="w2-formerr"><%= err %></p><% } %>
          <p class="w2-blog-count">設定一組新密碼就可以了。改完會直接幫你登入。</p>

          <form method="post" action="/reset/<%= token %>" class="w2-searchform">
            <ul class="w2-form">
              <li>
                <label for="reset-pass">新密碼</label>
                <input type="password" name="pass" id="reset-pass" size="20" minlength="4"
                       autocomplete="new-password" required autofocus>
                <span class="w2-sub">至少 4 碼</span>
              </li>
              <li>
                <label for="reset-pass2">再輸入一次</label>
                <input type="password" name="pass2" id="reset-pass2" size="20" minlength="4"
                       autocomplete="new-password" required>
              </li>
              <li>
                <input type="submit" class="w2-btn" value="設定新密碼">
              </li>
            </ul>
          </form>
          <% } %>

        </div>
      </div>

    </div>
    <div class="side">
      <div class="mod w2-auth-side">
        <div class="hd"><h2>改完之後</h2></div>
        <div class="bd">
          <ul>
            <li>這個連結會立刻失效，不能再用第二次。</li>
            <li>其他裝置上的登入會全部失效 —— 如果帳號被別人用了，
                這一步就是把對方踢出去。</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
