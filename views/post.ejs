<%- include('partials/head',{title:post.title}) %>
<table id="main"><tr><td>
<div class="box"><h3><a href="/<%= u.name %>/blog">網誌</a> &raquo; <%= post.category %></h3><div class="in">
<div class="entry" style="border:0"><h4><%= post.title %></h4><div class="meta"><%= post.created %> ｜ 人氣：<%= post.views %> ｜ 推薦：<%= post.likes %></div><div class="body"><%= post.body %></div>
<div class="meta"><form method="post" action="/<%= u.name %>/blog/<%= post.id %>/like" style="display:inline"><button class="lnk">推薦</button></form>｜ <% if(me && !isOwner){ %><form method="post" action="/<%= u.name %>/blog/<%= post.id %>/trackback" style="display:inline"><button class="lnk">引用到我的網誌</button></form>｜ <% } %><% if(isOwner){ %><a href="/<%= u.name %>/blog/<%= post.id %>/edit">編輯</a> ｜ <form method="post" action="/<%= u.name %>/blog/<%= post.id %>/del" style="display:inline" onsubmit="return confirm('刪除這篇文章？')"><button class="lnk">刪除</button></form><% } %></div></div>
<div class="gray" style="margin-top:8px"><% if(prev){ %>« <a href="/<%= u.name %>/blog/<%= prev.id %>"><%= prev.title %></a><% } %><span style="float:right"><% if(next){ %><a href="/<%= u.name %>/blog/<%= next.id %>"><%= next.title %></a> »<% } %></span></div>
</div></div>
<% if(trackbacks.length){ %><div class="box"><h3>引用 <span><%= trackbacks.length %></span></h3><div class="in"><% trackbacks.forEach(t=>{ %><div>↳ <a href="/<%= t.uname %>/blog/<%= t.pid %>"><%= t.title %></a> <span class="gray"><%= t.created.slice(0,10) %></span></div><% }) %></div></div><% } %>
<div class="box" id="comments"><h3>回應 <span><%= comments.length %> 則</span></h3><div class="in">
<% comments.forEach((c,i)=>{ %><div class="msg"><span class="gray">#<%= i+1 %></span> <span class="who"><%= c.author %></span> <span class="gray"><%= c.created.slice(0,16) %></span><% if(isOwner){ %> <form method="post" action="/<%= u.name %>/blog/<%= post.id %>/comment/<%= c.id %>/del" style="display:inline"><button class="lnk" style="font-size:10px">刪</button></form><% } %><br><span style="white-space:pre-wrap"><%= c.body %></span></div><% }) %>
<form method="post" action="/<%= u.name %>/blog/<%= post.id %>/comment" class="gb" style="margin-top:8px"><table class="pf"><% if(!me){ %><tr><td width="50">暱稱</td><td><input name="author" maxlength="20"></td></tr><% } %><tr><td>回應</td><td><textarea name="body" cols="55" rows="4" maxlength="1000" required></textarea></td></tr><tr><td></td><td><input type="submit" class="btn" value="送出回應"></td></tr></table></form></div></div>
</td><%- include('partials/blogside') %></tr></table>
<%- include('partials/foot') %>
