<%
  /* 網誌單篇文章 ＋ 迴響／引用區（無名小站 2012 最後版）
     ─────────────────────────────────────────────────────────────
     DOM 照抄 assets_src2/html/blog_2012_article_boogier_16702046.html 與
     blog_2013_article_comments_page2.html，規格見 spec/blog.md 第 8-3、8-3-2 節：

       #content > .blog > .blogbody > .blogbody2
         ├ .articletext
         │   a[name] + h3.title + .social-wrapper + .innertext(含 #push 與第二條分享列)
         │   + #article_counter + .extended
         ├ .posted
         └ .total-comments-div
             .trackback-url / .trackbacks-head / #HiddenTrackback
             .comments-head + .comments-body × N
             .comments-bottom + 發表回應表單

     迴響區只有 300px 寬、左邊再縮 30px（.total-comments-div{width:300px;margin-left:30px}），
     夾在 530px 的 #content 裡看起來偏窄偏左——這是原站行為，不是 bug（spec 第 10 節第 1 點）。

     表單 action／method／欄位 name 一律沿用原本的（對得上 src/server.js）：
       推薦   POST /:name/blog/:id/like
       收藏   POST /:name/blog/:id/fav
       引用   POST /:name/blog/:id/trackback         ← 就是分享列上那顆「發文」
       迴響   POST /:name/blog/:id/comment           author / email / homepage / remember / body
       板主回覆 POST /:name/blog/:id/comment/:cid/reply   reply
       刪迴響 POST /:name/blog/:id/comment/:cid/del
       檢舉   POST /report                           kind / target / url / reason

     EJS 用 with(locals)，不能宣告和 local 同名的 const。 */
  const wDate = s => String(s).slice(0,4) + ' 年 ' + (+String(s).slice(5,7)) + ' 月 ' + (+String(s).slice(8,10)) + ' 日';
  const wTime = s => { let h = +String(s).slice(11,13); const ap = h < 12 ? 'AM' : 'PM';
                       h = h % 12 || 12;
                       return String(h).padStart(2,'0') + ':' + String(s).slice(14,16) + ' ' + ap; };
  /* 迴響時間：原站是 December 9, 2011 07:13 PM */
  const wStamp = s => wDate(s) + ' ' + wTime(s);
  const here  = '/' + u.name + '/blog/' + post.id;
  const IMG   = '/img/wretch2012/blog';
  /* 樓層別名：只有前三樓有，第 4 樓以後就是 N樓（spec 第 6-B 節逐字） */
  const floorAlias = ['1樓搶頭香','2樓頸推','3樓坐沙發'];
  const todayHits2 = u.hits_date === new Date().toLocaleDateString('sv-SE') ? (u.today_hits || 0) : 0;
  /* 迴響與引用的分頁列。
     ⚠ 原本兩份清單都沒有分頁，一篇文章有一萬則迴響就一次全部印出來——
     不只是慢，那是一個不用登入、任何人都可以重複觸發的資源消耗點。
     原站本來就有分頁，存檔看得到參數：
       …/blog/<帳號>/<文章>&page=2#postComments    迴響 20 則／頁
       …/blog/<帳號>/<文章>&tpage=2#trackbacks     引用 30 筆／頁
     （Reply(124) 分 7 頁、Trackback(128) 分 5 頁反推出來的每頁筆數） */
  const pgUrl = (key, n, anchor) => {
    const q = new URLSearchParams(locals.query || {});
    if (n <= 1) q.delete(key); else q.set(key, n);
    const s = q.toString();
    return here + (s ? '?' + s : '') + '#' + anchor;
  };
%>
<%- include('partials/blog2012_head', { title: post.title + ' - ' + u.nick + ' - 無名小站',
                                        artTitle: post.title, medium: 'blog' }) %>

<div id="content">
<input type="hidden" name="check_url" value="on">
<div class="blog" >

      <div class="date">
        <div class="datediv">
          <%= wDate(post.created) %>        </div>
      </div>

      <div class="blogbody">
        <div class="blogbody2">
            <div class="articletext">
            <a name="<%= post.id %>"></a>
            <h3 class="title"><% if (post.pass) { %><img src="<%= IMG %>/lock.gif" width="21" height="16" border="0" align="absmiddle" alt="[鎖]"><% } %><%= post.title %><% if (post.featured) { %><a href="/blogs" target="_blank"><img src="<%= IMG %>/hot.png" border="0" alt=""></a><% } %></h3>
            <%- include('partials/blogshare', { shPost: post, shOwner: u.name, shTb: locals.trackbackN ?? trackbacks.length, shCan: !!(me && !isOwner) }) %>

            <div class="innertext">
              <%- render(post.body) %>

              <div class="clearfix">
                <div id="push">
                  <span id="recommendcount"><%= post.likes %></span>推薦此文章
                  <%# 推過的人看到的是「已推」的樣子。原本推前推後長得一模一樣，
                      重複按沒有任何回饋，使用者只會覺得按鈕壞了。 %>
                  <% const liked = (locals.likedByMe === true); %>
                  <form method="post" action="<%= here %>/like"><button id="pushbtn" class="push<%= liked ? ' on' : '' %>" title="<%= liked ? '你已經推過了' : '推薦此文章' %>">推</button></form>
                  <% if (me) { %>
                  <%# 收藏是切換狀態的按鈕，樣子要跟著狀態走，不然第二次點會
                      在使用者不知情的狀況下把收藏取消掉。 %>
                  <form method="post" action="<%= here %>/fav"><button id="collectbtn" class="pull<%= faved ? ' on' : '' %>" title="<%= faved ? '取消收藏' : '收藏這篇文章' %>">收</button></form>
                  <% } else { %>
                  <a href="/login?next=<%= encodeURIComponent(here) %>" id="collectbtn" class="pull" title="收藏這篇文章">收</a>
                  <% } %>
                </div>
                <%- include('partials/blogshare', { shPost: post, shOwner: u.name, shTb: locals.trackbackN ?? trackbacks.length, shCan: !!(me && !isOwner) }) %>
              </div>
            </div>

            <div id="article_counter" align="right">
              今日人氣: <%= todayHits2 %>            累積人氣: <%= u.visits %>            </div>

            <div class="extended">
              個人分類：<a href="/<%= u.name %>/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a>
              <% if (post.topic) { %><span>站內分類：<a href="/blogs?topic=<%= encodeURIComponent(post.topic) %>" target="_blank"><%= post.topic %></a></span><% } %>
              <% if (post.mood) { %><span>心情：<%= post.mood %></span><% } %><% if (post.weather) { %><span>天氣：<%= post.weather %></span><% } %>
              <br />
              <% if (prev) { %>上一篇：<a href="/<%= u.name %>/blog/<%= prev.id %>"><%= prev.title %></a> &nbsp;<% } %>
              <% if (next) { %>下一篇：<a href="/<%= u.name %>/blog/<%= next.id %>"><%= next.title %></a><% } %>
            </div>

            <%# 站長／站方的操作鈕。原站的存檔都是訪客視角（spec 第 11 節「查無」），
                所以這一塊是本站自己加的，樣式在 wretch2012-blog-site.css %>
            <% if (isOwner || (me && me.admin)) { %>
            <div class="w2b-owner">
              <% if (isOwner) { %>
              [ <a href="<%= here %>/edit">編輯</a> ]
              [ <form method="post" action="<%= here %>/del" onsubmit="return confirm('刪除這篇文章？')"><button>刪除</button></form> ]
              <% } %>
              <% if (me && me.admin) { %>
              [ <form method="post" action="/admin/feature/post/<%= post.id %>"><input type="hidden" name="back" value="<%= here %>"><button><%= post.featured ? '取消精選' : '設為精選' %></button></form> ]
              <% } %>
            </div>
            <% } %>

<%# ── 歷史上的今天 ────────────────────────────────────────────────
    位置與 class 照 assets_src2/html/blog_2013_article_a0000000_32846743.html:354：
    在 .extended 之後、`end of articletext` 之前，
    `.history > .history_title + .history_articles`，標題硬中文且帶冒號。
    樣式在 assets_src2/css/blog_top.css:4-7（兩塊 float 並排、self-clearing）。

    ⚠ 四份存檔的 .history_articles **全部是空的**，所以「每一筆長什麼樣」
    是零存檔、由我們自己決定（一行一篇，年份＋標題）。
    blog.md §744 註明「只有部分文章有」——往年同一天沒發過文就整塊不印。 %>
<% if (typeof onThisDay !== 'undefined' && onThisDay.length) { %>
            <div class="history">
              <div class="history_title">歷史上的今天:</div>
              <div class="history_articles">
<% onThisDay.forEach(h => { %>                <a href="/<%= u.name %>/blog/<%= h.id %>"><%= h.created.slice(0,4) %>：<%= h.title %></a><br />
<% }) %>              </div>
            </div>
<% } %>

            </div> <!-- end of articletext -->

            <div class="posted">
            <a href="/<%= u.name %>/blog"><%= u.name %></a> at <a href="/blogs">無名小站</a> at <%= wTime(post.created) %> post            | <a href="<%= here %>#postComments">回應(<%= locals.commentN ?? comments.length %>)</a>
            | <a href="<%= here %>#trackbacks">引用(<%= locals.trackbackN ?? trackbacks.length %>)</a>
            <%# 原版這裡是 `<a href="javascript:void(0)" id="showCollector">Collection(0)</a>`
                （blog_2013_article_a0000000_32846743.html:369）——它的工作是**開啟
                「誰來收藏」彈窗**，不是收藏本身；收藏是上面 .innertext 裡那顆
                #collectbtn。我原本把兩件事併成一顆送出鈕，結果彈窗只能用 hover 開、
                移開又關不掉，觸控與鍵盤更是完全打不開。照原版拆回兩顆。 %>
            | <a href="javascript:void(0)" id="showCollector" role="button" tabindex="0">收藏(<%= favN %>)</a>
            | <a href="/report?kind=post&amp;target=<%= post.id %>&amp;url=<%= encodeURIComponent(here) %>" class="reportlink" data-kind="post" data-id="<%= post.id %>">檢舉</a>
            <%# 站長專用的「設為精選」。POST /admin/feature/:kind/:id 這支一直都在，
                但唯一的入口是管理後台那個**要自己輸入編號**的表單——站長逛到一篇
                想精選的文章，得先記住網址結尾的數字、回後台、再貼進去。
                這裡直接給一顆鈕，back 帶回本頁（那支路由本來就吃 back）。
                只有站長看得到；一般訪客與作者本人都不會看到這一節。 %>
            <% if (locals.me && me.admin) { %>
            | <form method="post" action="/admin/feature/post/<%= post.id %>" class="w2-inline-form">
                <input type="hidden" name="back" value="<%= here %>">
                <button type="submit" class="w2-linkbtn"><%= post.featured ? '取消精選' : '設為精選' %></button>
              </form>
            <% } %>
                      </div>

<%# ── 誰來收藏（#friend-picker 彈窗）─────────────────────────────
    骨架逐節點照 assets_src2/html/blog_2013_article_a0000000_32846743.html:1165：
      #friend-picker > #friend-picker-container
        > #friend-picker-hd（span 標題 + #loading + a#friend-picker-closebtn）
        > #friend-picker-pagination
        > #friend-picker-bd
    樣式在 assets_src2/css/blog_friend_picker.css（整支就是這個功能）：
    #friend-picker 是 position:absolute + visibility:hidden，按 #showCollector 才顯示。

    ⚠ 兩處刻意偏離，理由：
    1. 原站是 AJAX（friend_picker.js 去打 /ajax/ 拿名單，還帶 ajax_crumb）。
       我們沒有那組 API，改成**後端直接把格子印出來**、按鈕只切 visibility。
       對訪客來說行為一樣，而且不必等一個往返。
    2. #loading 那格原站是「等 AJAX 回來」用的。我們沒有等待，
       所以照抄節點但維持 display:none（CSS 本來就是 none），不會閃一下。
    沒有人收藏就不印彈窗——按鈕上的數字已經是 0，開一個空盒子沒有意義。 %>
<% if (collectors && collectors.length) { %>
  <div id="friend-picker">
    <div id="friend-picker-container">
      <div id="friend-picker-hd">
        <span>誰來收藏</span>
        <div id="loading">Loading ...</div>
        <a id="friend-picker-closebtn" href="javascript:void(0)" title="關閉">×</a>
      </div>
      <div id="friend-picker-pagination"></div>
      <div id="friend-picker-bd">
<% collectors.forEach(c => { %>        <div class="friend-picker-cell"><a href="/<%= c.name %>"><p><img src="<%= c.avatar || '/img/avatar.png' %>" width="60" height="60" alt="<%= c.nick || c.name %>"></p><span id="label"><%= c.nick || c.name %></span></a></div>
<% }) %>      </div>
    </div>
  </div>
  <script>
  /* 按收藏數開關「誰來收藏」。原站這一段在 friend_picker.js 裡，
     那支還要跟 /ajax/ 要資料；我們的名單已經印在 DOM 裡，只剩顯示與隱藏。 */
  (function () {
    var btn = document.getElementById('showCollector');
    var box = document.getElementById('friend-picker');
    if (!btn || !box) return;
    /* ⚠ 座標要用 **offsetParent 相對**的，不是頁面絕對座標。
       #friend-picker 是 position:absolute，它的定位基準是最近的 positioned 祖先
       ——在網誌頁那是 #bigcontainer（position:relative）。
       用 window.scrollY + rect.top 會多算 offsetParent 的位移，彈窗往下偏。 */
    function place() {
      var r = btn.getBoundingClientRect();
      var op = box.offsetParent || document.body;
      var o = op.getBoundingClientRect();
      box.style.left = (r.left - o.left) + 'px';
      box.style.top = (r.bottom - o.top + 4) + 'px';
    }
    function open() { place(); box.style.visibility = 'visible'; }
    function close() { box.style.visibility = 'hidden'; }
    function toggle(e) {
      if (e) e.preventDefault();
      box.style.visibility === 'visible' ? close() : open();
    }
    /* 用**點擊**開關，不要用 hover：hover 在觸控裝置上根本觸發不了，
       而且滑鼠移開就關會讓人來不及點裡面的頭像。
       鍵盤也要能操作（btn 有 tabindex），所以 Enter/空白鍵一起接。 */
    btn.addEventListener('click', toggle);
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') toggle(e);
    });
    var closeBtn = document.getElementById('friend-picker-closebtn');
    if (closeBtn) closeBtn.addEventListener('click', close);
    /* 點外面、按 Esc 都要關得掉——不然那個白盒子會一直蓋住底下的內容 */
    document.addEventListener('click', function (e) {
      if (box.style.visibility === 'visible' && !box.contains(e.target) && e.target !== btn) close();
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
  </script>
<% } %>

            <div class="total-comments-div">

    <%# ── (a) 引用網址 ─────────────────────────────────────── %>
    <div class="trackback-url">
      [引用網址]
      <%# ⚠ value 要是**絕對網址**。原本印 here（站內相對路徑），靠頁尾的 JS
          補上 location.origin；JS 沒跑（或使用者在 JS 補完之前就按了複製）
          就會複製到「/jaychou/blog/20」這種貼到哪裡都打不開的東西。
          origin 是 res.locals 攤出來的（req.protocol + host，跟 RSS 同一套）。
          data-path 保留，頁尾那段 JS 還在用。 %>
      <input type="text" id="trackback_url" data-path="<%= here %>" value="<%= origin + here %>">
      <input type="button" id="trackback_copy" value="複製引用網址">
    </div>

    <%# ── (b) 引用列表（預設收合，#HiddenTrackback.hide-list{display:none}） ── %>
    <div class="trackbacks-head">
      <div class="comments-head">
        <a name="trackbacks"><span>引用(<%= locals.trackbackN ?? trackbacks.length %>)</span><span id="trackback-switch"></span></a>
      </div>
    </div>
    <div id="HiddenTrackback" class="hide-list">
      <% trackbacks.forEach(t => { %>
      <div class="trackbacks-body">
        <div class="comments-body">
          <a name="trackback<%= t.id %>"></a>
          <ul class="comments-user">
            <li></li>
            <li><p>本篇文章引用自此</p></li>
            <li class="trackbacks-post">
              <div class="comments-post">
                <a target="_blank" href="/<%= t.uname %>/blog/<%= t.pid %>"><%= t.title %></a>
                at <%= t.created ? wStamp(t.created) : '' %> Trackback
              </div>
            </li>
          </ul>
        </div>
      </div>
      <% }) %>
      <%- include('partials/pager2012', {
        pgPage: locals.trackbackPage || 1, pgPages: locals.trackbackPages || 1,
        pgHref: n => pgUrl('tpage', n, 'trackbacks'), pgId: 'trackback_pager' }) %>
      <% if (!trackbacks.length) { %>
      <div class="trackbacks-body">
        <div class="comments-body">
          <ul class="comments-user">
            <li><p>還沒有人引用這篇文章</p></li>
          </ul>
        </div>
      </div>
      <% } %>
    </div>

    <br />

    <%# ── (c) 迴響列表 ─────────────────────────────────────── %>
    <div class="comments-head">
      <a name="comments"></a>回應                </div>

    <% comments.forEach((c, i) => { %>
    <div class="comments-body">
      <a name="comment<%= c.id %>"></a>
      <ul class="comments-user">
        <%# 迴響者的頭像與連結。原版每一則都連到那個人的小站
            （blog_2013_article_*.html 的 .bighead）。
            ⚠ 原本這裡寫死 No_Login_90.gif、連結還 fallback 到**文章作者**的網誌，
            於是每一則迴響看起來都像站主自己回的。
            登入者連自己的小站、用自己的頭貼；訪客留自己填的個人網頁，
            都沒有就維持原版的未登入圖（那才是真的「沒有帳號」）。 %>
        <span><a target="_blank" href="<%= c.cname ? ('/' + c.cname) : (c.homepage || 'javascript:void(0)') %>" class="bighead"><img src="<%= c.cavatar || (IMG + '/No_Login_90.gif') %>" width="90" height="90" alt="<%= c.author %>"><cite></cite></a></span>
        <li class="comments-word">
          <p id="floor_<%= i+1 %>" class="cmt_floor"><%= i+1 %>樓</p>
          <p id="fhide_<%= i+1 %>" class="cmt_floor_hide"><%= floorAlias[i] || ((i+1) + '樓') %></p>
          <p><%= c.body %></p>
        </li>
        <li class="comments-post">
          <% if (c.homepage) { %><a class='postuser' target='_blank' href='<%= c.homepage %>'><%= c.author %></a><% } else { %><a class='postuser'><%= c.author %></a><% } %><% if (c.email) { %><a class='postemail' href='mailto:<%= c.email %>'><img src='<%= IMG %>/email.gif' width="25" height="25" border="0" align='absmiddle' alt="email"></a><% } %> at <%= wStamp(c.created) %> comment
          | <a href="/report?kind=comment&amp;target=<%= c.id %>&amp;url=<%= encodeURIComponent(here) %>" class="reportlink" data-kind="comment" data-id="<%= c.id %>">檢舉</a>
          <% if (isOwner) { %>| <form method="post" action="<%= here %>/comment/<%= c.id %>/del" onsubmit="return confirm('刪除這則回應？刪掉之後救不回來。')"><button>刪除</button></form><% } %>
        </li>
      </ul>

      <% if (c.reply) { %>
      <div class="comments-reply" id="comments-reply-<%= c.id %>">
        <ul class="comments-author">
          <li><p><%= c.reply %></p></li>
          <li class="comments-post">
            板主回覆 at <%= wStamp(c.created) %> Reply                                            </li>
        </ul>
      </div>
      <% } %>

      <% if (isOwner) { %>
      <div class="comments-reply">
        <ul class="comments-author">
          <li>
            <form method="post" action="<%= here %>/comment/<%= c.id %>/reply">
              <input name="reply" size="24" maxlength="500" value="<%= c.reply %>">
              <input type="submit" value="板主回覆">
            </form>
          </li>
        </ul>
      </div>
      <% } %>
    </div>
    <% }) %>

    <%- include('partials/pager2012', {
      pgPage: locals.commentPage || 1, pgPages: locals.commentPages || 1,
      pgHref: n => pgUrl('page', n, 'postComments'), pgId: 'comment_pager' }) %>
    <% if (!comments.length) { %>
    <%# 零迴響時原站的空狀態 HTML 查無（spec 第 11 節），這句是本站自己補的 %>
    <div class="comments-body">
      <ul class="comments-user">
        <li class="comments-word"><p>還沒有人留下回應</p></li>
      </ul>
    </div>
    <% } %>

    <%# ── (d) 發表迴響 ─────────────────────────────────────── %>
    <div class="comments-bottom">
      <div class="comments-head">
        <a name="postComments"></a>發表回應                    </div>
    </div>

    <div class="comments-body">
      <form method="post" name='form' action="<%= here %>/comment"
            onSubmit="return check_new_comment_input('請輸入內容', '回應最多 1000 字…');">
        <% if (!me) { %>
        <label for="name_id">暱稱：</label><br />
        <input type='text' id='name_id' name='author' maxlength='20' value='<%= (guest && guest.author) || "" %>' />
        <br /><br />
        <label for="email">E-mail：</label><br />
        <input type='text' id="email" name='email' maxlength='60' value='<%= (guest && guest.email) || "" %>' />
        <br /><br />
        <label for="url">個人網頁：</label><br />
        <input type='text' id="url" name='homepage' maxlength='200' value='<%= (guest && guest.homepage) || "" %>' />
        <br /><br />
        <label for="rem">記住我的資料</label>
        <input type="radio" id="rem" name="remember" value="1" <%= guest ? 'checked' : '' %> />是
        <input type="radio" name="remember" value="" <%= guest ? '' : 'checked' %> />否
        <br /><br />
        <% } %>
        <label for="text">回應內容（最多 1000 字）：</label>
        <br /><textarea style="width: 90%" id="text" name='body' rows="10" cols="64" wrap="hard" maxlength="1000" required></textarea>
        <br />
        <input type="submit" name="confirm" value="送出" />
        <input type="reset" name="go_prev" value="取消" />
      </form>
    </div>

    <%# 檢舉：平常收起來，按 .posted 或迴響列的「檢舉」才展開 %>
    <div class="comments-body" id="reportbox" style="display:none">
      <div class="comments-head">檢舉</div>
      <form method="post" action="/report">
        <input type="hidden" name="kind" id="rkind">
        <input type="hidden" name="target" id="rtarget">
        <input type="hidden" name="url" value="<%= here %>">
        <label for="rreason">請說明檢舉原因：</label><br />
        <textarea style="width: 90%" id="rreason" name="reason" rows="3" cols="64" maxlength="500" required></textarea><br />
        <input type="submit" value="送出檢舉">
        <input type="button" id="rcancel" value="取消">
      </form>
    </div>

            </div> <!--  end of total-comments-div -->

        </div> <!-- end of blogbody2 -->
      </div> <!-- end of blogbody -->
</div> <!-- end of class=blog -->
</div> <!-- end of content -->

