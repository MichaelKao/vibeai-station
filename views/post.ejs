<script>
/* 原站這些行為在 l.yimg.com/e/serv/blog/js/func_blog.js 與 trackback.js 裡
   （assets_src2/css/blog_func_blog.js 有原始碼）。這裡只重做用得到的四件事，
   class / id 與原站一致，所以 blog_trackback.css 的規則直接生效。 */
function check_new_comment_input(msgEmpty, msgLong){
  var t = document.getElementById('text');
  if (!t.value.replace(/\s/g,'')) { alert(msgEmpty); return false; }
  if (t.value.length > 1000)      { alert(msgLong);  return false; }
  return true;
}
(function(){
  /* 引用網址：樣板端拿不到 host，在瀏覽器補成絕對網址 */
  var tu = document.getElementById('trackback_url');
  if (tu) tu.value = location.protocol + '//' + location.host + tu.getAttribute('data-path');
  var tc = document.getElementById('trackback_copy');
  if (tc) tc.addEventListener('click', function(){
    tu.select();
    if (navigator.clipboard) navigator.clipboard.writeText(tu.value);
    else document.execCommand('copy');
    alert('已複製到剪貼簿');
  });

  /* 引用區展開／收合：#HiddenTrackback.hide-list{display:none}、#trackback-switch.hide 換圖 */
  var sw = document.getElementById('trackback-switch');
  if (sw) sw.addEventListener('click', function(){
    var box = document.getElementById('HiddenTrackback');
    var hidden = box.classList.toggle('hide-list');
    sw.classList.toggle('hide', !hidden);
  });

  /* 檢舉表單 */
  document.addEventListener('click', function(e){
    var a = e.target.closest('.reportlink');
    if (a) { e.preventDefault();
      document.getElementById('rkind').value   = a.getAttribute('data-kind');
      document.getElementById('rtarget').value = a.getAttribute('data-id');
      var b = document.getElementById('reportbox');
      b.style.display = 'block'; b.scrollIntoView({behavior:'smooth'}); }
    if (e.target.id === 'rcancel') document.getElementById('reportbox').style.display = 'none';
  });
})();
</script>
