<%
  /* 嘀咕總站 /digu
     ─────────────────────────────────────────────────────────────
     原站導覽列的「嘀咕」指向 http://www.wretch.cc/digu/，但**沒有任何存檔**
     （assets_src2/html/ 44 份裡一份都沒有），所以這一頁是自製的，
     照 WRETCH_2012.md §3-A 標明是刻意偏離，用站台既有的元件語言組。

     嘀咕是「一句話動態」，所以這一頁就是全站的時間軸：誰在什麼時候說了什麼。

     資料來自 src/server.js 的 app.get('/digu')：page / pages / total / digus。 */
  const qs = p => '/digu?p=' + p;
%>
<%- include('partials/head2012', { title: '嘀咕 - 無名小站' }) %>

  <div class="bd big-bd clearfix">
    <div class="main">

      <div class="mod w2-auth">
        <div class="hd"><h2>大家在說什麼</h2></div>
        <div class="bd">

          <p class="w2-blog-count">共 <b><%= total %></b> 則嘀咕</p>

          <% if (!digus.length) { %>
          <p>還沒有人嘀咕。<a href="/register">開一個帳號</a>，說第一句吧。</p>
          <% } %>

          <ol class="w2-bloglist w2-digulist">
            <% digus.forEach(d => { %>
            <li>
              <a class="thumbnail" href="/<%= d.uname %>"><img src="<%= d.avatar %>" width="85" height="85" alt="<%= d.nick %>"></a>
              <div class="content">
                <p class="meta">
                  <a class="uname" href="/<%= d.uname %>"><%= d.nick %></a>
                  <span class="topic"><%= d.created.slice(5, 16) %></span>
                </p>
                <h3><a class="skin-main-link" href="/<%= d.uname %>/digu"><%= d.body %></a></h3>
              </div>
            </li>
            <% }) %>
          </ol>

          <% if (pages > 1) { %>
          <div class="w2-pager">
            <% if (page > 1) { %><a href="<%= qs(page-1) %>">上一頁</a><% } %>
            <% for (let i=1; i<=pages; i++) { %><% if (i === page) { %><b><%= i %></b><% } else { %><a href="<%= qs(i) %>"><%= i %></a><% } %><% } %>
            <% if (page < pages) { %><a href="<%= qs(page+1) %>">下一頁</a><% } %>
          </div>
          <% } %>

        </div>
      </div>

    </div>
    <div class="side">

      <div class="mod w2-auth-side">
        <div class="hd"><h2>逛逛別的</h2></div>
        <div class="bd">
          <ul>
            <li><a href="/rank">人氣排行榜</a></li>
            <li><a href="/albums">相簿總站</a></li>
            <li><a href="/blogs">網誌總站</a></li>
            <li><a href="/video">影音</a></li>
            <li><a href="/join">揪團</a></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div><!-- /#wrapper -->

<div id="lower-wrapper" class="clearfix">
  <div class="bd clearfix"></div>
<%- include('partials/foot2012') %>
